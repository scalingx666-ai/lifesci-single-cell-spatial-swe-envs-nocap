+    else:
+        # using color
+        gdf = gpd.GeoDataFrame(geometry=points)
+        ax = gdf.plot(ax=ax, **kwargs)
+
+    # clean args for boundary plotting
+    if "color" in kwargs:
+        kwargs.pop("color")
+    if "cmap" in kwargs:
+        kwargs.pop("cmap")
