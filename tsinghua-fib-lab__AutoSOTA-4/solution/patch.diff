+.modal-close {
+  position: absolute; top: 16px; right: 20px;
+  width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;
+  border: 1px solid var(--border); border-radius: 50%;
+  background: rgba(255,255,255,.03); color: var(--muted); font-size: 1.2rem;
+  cursor: pointer; transition: color var(--transition), border-color var(--transition);
+}
+.modal-close:hover { color: var(--text); border-color: var(--border-strong); }
+.modal-content h2 { margin: 0 0 8px; font-size: 1.5rem; letter-spacing: -.03em; line-height: 1.3; }
+.modal-content .modal-title { color: var(--muted); font-size: .92rem; line-height: 1.6; margin: 0 0 20px; }
+.modal-meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-bottom: 24px; }
+.modal-meta-item {
+  padding: 14px; border: 1px solid var(--border); border-radius: 14px;
+  background: rgba(255,255,255,.015);
+}
+.modal-meta-item .mm-label { display: block; color: var(--muted); font-family: "IBM Plex Mono", monospace; font-size: .68rem; letter-spacing: .08em; text-transform: uppercase; }
+.modal-meta-item .mm-value { display: block; margin-top: 6px; font-size: 1.1rem; font-weight: 600; letter-spacing: -.02em; }
+.modal-meta-item .mm-value.green { color: var(--green); }
+.modal-meta-item .mm-value.amber { color: var(--amber); }
+.modal-summary { color: var(--muted); line-height: 1.8; font-size: .94rem; }
+.modal-summary p { margin: 0 0 10px; }
+.modal-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border); }
+
+/* Feedback */
+.feedback-panel {
+  display: grid; grid-template-columns: 1.2fr .8fr; gap: 32px;
+  padding: 34px; border: 1px solid var(--border); border-radius: var(--radius-xl);
+  background: linear-gradient(180deg, rgba(7,8,10,.92), rgba(4,5,7,.92));
+  box-shadow: var(--shadow);
 }
+.feedback-copy h2 { margin: 0 0 16px; font-size: clamp(1.8rem, 4vw, 2.5rem); letter-spacing: -.05em; }
+.feedback-copy p { color: var(--muted); line-height: 1.75; max-width: 50ch; }
+.feedback-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 24px; }
+.feedback-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-self: center; }
+.feedback-stats .stat-card { min-height: 100px; }
 
