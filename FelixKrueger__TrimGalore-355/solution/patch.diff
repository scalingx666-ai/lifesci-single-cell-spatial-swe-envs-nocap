+```rust
+if cli.clump_only {
+    // No adapter auto-detection; no trim pipeline setup.
+    let memory_bytes = clump::parse_memory_size(&cli.memory)?;
+    if cli.paired {
+        run_specialty_paired(...);  // wraps clump_only_paired
+    } else {
