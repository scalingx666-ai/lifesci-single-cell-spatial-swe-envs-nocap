+@pytest.mark.parametrize("case", CASES, ids=case_id)
+def test_transform_is_idempotent_and_leaves_input_alone(case):
+    deform = build(*case)
+    marker = np.arange(N * M).reshape(N, M)
+    untouched = marker.copy()
