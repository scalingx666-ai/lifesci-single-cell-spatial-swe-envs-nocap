+    deform = build("cut", True, True, True, True)
+    calls = {"row": 0, "col": 0}
+    real_row, real_col = deform.cluster_row, deform.cluster_col
+
+    def counting_row():
+        calls["row"] += 1
+        return real_row()
+
+    def counting_col():
+        calls["col"] += 1
+        return real_col()
