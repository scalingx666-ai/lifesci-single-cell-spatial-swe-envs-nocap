+                        seen += 1
+                        # Sleeping — not just `pass` — is what actually releases
+                        # the GIL to a waiting thread.
+                        if seen % ChatRoom._WALK_YIELD_EVERY == 0:
+                            _t.sleep(ChatRoom._WALK_YIELD_SECONDS)
