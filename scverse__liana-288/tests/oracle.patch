-    --pst-color-target: rgb(186 27 87 / 28%);
-
-    --sd-color-primary: var(--liana-crimson-light);
-    --sd-color-primary-highlight: var(--liana-turquoise-light);
-    --sd-color-shadow: rgb(0 0 0 / 50%);
