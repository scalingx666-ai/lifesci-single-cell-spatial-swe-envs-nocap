+            .attr('x', rMin * width)
+            .attr('y', titleHeight)
+            .attr('width', (rMax - rMin) * width)
+            .attr('height', rectHeight)
+            .attr('preserveAspectRatio', 'none')
+            .attr('href', xlinkHref);
+        } else {
+          g.append('image')
+            .attr('x', 0)
+            .attr('y', titleHeight)
+            .attr('width', width)
+            .attr('height', rectHeight)
+            .attr('preserveAspectRatio', 'none')
+            .attr('href', xlinkHref);
+        }
+
+        // Use colormap range sliders to determine the range
+        // to use in the legend ticks.
