+            .style('stroke', foregroundColor);
+          axisTicks.selectAll('text')
+            .style('fill', foregroundColor);
+          axisTicks.selectAll('text')
+            .attr('text-anchor', (_d: unknown, i: number) => (i === 0 ? 'start' : 'end'));
+        } else {
+          // X-axis ticks for non-interactive mode
