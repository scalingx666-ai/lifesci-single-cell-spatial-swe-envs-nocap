+    }
+    if (isStaticColor) {
+      g.append('rect')
+        .attr('x', 0)
+        .attr('y', titleHeight)
+        .attr('width', width)
+        .attr('height', rectHeight)
+        .attr('fill', `rgb(${staticColor[0]},${staticColor[1]},${staticColor[2]})`);
+    }
+    if (isSetColor && obsSetSelection && obsSetColor) {
