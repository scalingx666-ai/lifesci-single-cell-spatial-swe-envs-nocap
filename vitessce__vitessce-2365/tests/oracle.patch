+          .attr('text-anchor', 'start')
+          .attr('dominant-baseline', 'hanging')
+          .attr('x', 0)
+          .attr('y', y)
+          .text(levelZeroName)
+          .style('font-size', '9px')
+          .style('fill', foregroundColor);
+        y += titleHeight;
+
+        setPaths.forEach((setPath) => {
+          const setColor = obsSetColor
+            ?.find(d => isEqual(d.path, setPath))
