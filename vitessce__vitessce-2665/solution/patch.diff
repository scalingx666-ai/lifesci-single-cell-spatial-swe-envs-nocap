diff --git a/.changeset/unique-chunk-names.md b/.changeset/unique-chunk-names.md
new file mode 100644
index 0000000000..03d1ac5489
--- /dev/null
+++ b/.changeset/unique-chunk-names.md
@@ -0,0 +1,5 @@
+---
+"vitessce": patch
+---
+
+Name lazy-loaded chunks of workspace packages after their package (e.g., `spatial-three-[hash].js`) instead of `index-[hash].js`, and strip hashes containing dashes in the bundle size workflow.
diff --git a/.github/workflows/bundle-size.yml b/.github/workflows/bundle-size.yml
index e3d13e1bf9..172cbe0085 100644
--- a/.github/workflows/bundle-size.yml
+++ b/.github/workflows/bundle-size.yml
@@ -41,7 +41,7 @@ jobs:
           build-script: "build:ci"
           clean-script: "clean"
           pattern: "./packages/main/prod/dist/**/*"
-          strip-hash: "\\-(\\w{8})\\.js$"
+          strip-hash: "-([\\w-]{8})\\.js$"
           repo-token: "${{ secrets.GITHUB_TOKEN }}"
         env:
           NODE_OPTIONS: ${{ steps.get-options.outputs.node-options }}
diff --git a/packages/main/prod/vite.config.mjs b/packages/main/prod/vite.config.mjs
index 88787b8699..2cac228990 100644
--- a/packages/main/prod/vite.config.mjs
+++ b/packages/main/prod/vite.config.mjs
@@ -32,6 +32,15 @@ export default defineConfig({
         || id === 'three'
         || id.startsWith('three/')
       ),
+      output: {
+        // Lazy-loaded workspace packages all have index.js entries; name their chunks
+        // after the package dir so names stay unique once CI strips hashes.
+        // Rollup derives the default [name] from the chunk's last module.
+        chunkFileNames: ({ name, moduleIds }) => {
+          const pkgDir = moduleIds.at(-1)?.match(/([^/]+)\/dist-tsc\/index\.js$/)?.[1];
+          return `${name === 'index' && pkgDir ? pkgDir : name}-[hash].js`;
+        },
+      },
