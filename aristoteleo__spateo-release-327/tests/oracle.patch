+            self.nonspatial_decoder = DecoderSCVI(
+                n_input=n_latent,
+                n_output=n_input_nonspatial,
+                n_cat_list=[n_batch_nonspatial] if n_batch_nonspatial > 0 else None,
+                n_layers=n_layers,
+                n_hidden=n_hidden,
