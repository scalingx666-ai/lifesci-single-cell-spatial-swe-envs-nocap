+cellstate_labels <- function(ids, labels, default) {
+  if (is.null(labels)) {
+    return(unname(default))
+  }
+  if (is.null(names(labels)) || anyDuplicated(names(labels)) ||
+    anyNA(labels[ids])) {
+    stop("Label maps must name all displayed IDs uniquely.")
+  }
+  unname(as.character(labels[ids]))
+}
