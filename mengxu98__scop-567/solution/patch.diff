+cellstate_composition <- function(group, category) {
+  tab <- table(as.character(group), as.character(category))
+  result <- as.data.frame(tab / rowSums(tab), stringsAsFactors = FALSE)
+  names(result) <- c("cluster", "category", "fraction")
+  result
+}
