+    }
+    keep <- is.finite(radius) & radius > 0
+    if (!any(keep)) {
+      return(invisible(NULL))
+    }
+    add(grid::circleGrob(native(xx[keep]), native(yy[keep]), native(radius[keep]),
+      gp = grid::gpar(fill = fill[keep], col = "black", lwd = lw * scale / .75)
