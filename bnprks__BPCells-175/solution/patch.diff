+
+  # Make a dummy macs script that will register as valid but won't actually run
+  bad_macs_path <- file.path(dir, "bad_macs.sh")
+  writeLines(c(
+    "#!/bin/bash",
+    "if [[ $1 == '--version' ]]; then",
