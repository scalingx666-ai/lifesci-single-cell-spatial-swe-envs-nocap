+            r.overrides,
+            vec![ClipOverride {
+                flag: "--clip_R1",
+                preset_value: 10,
+                user_value: 12,
+            }]
+        );
+    }
+
+    #[test]
+    fn without_a_preset_user_values_pass_through_untouched() {
+        let r = resolve(
+            None,
+            UserClips {
+                clip_r2: Some(4),
+                ..UserClips::default()
+            },
+        );
+        assert_eq!(r.preset, None);
+        assert_eq!(r.clip_r1, None);
+        assert_eq!(r.clip_r2, Some(4));
+        assert!(r.overrides.is_empty());
+    }
+}
