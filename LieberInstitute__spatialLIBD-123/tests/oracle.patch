-            sce,
+        
+        ## scrapper::aggregateAcrossCells() operates on the count matrix
+        ## and returns a list rather than a SingleCellExperiment.
+        ## scrapper aggregates the count matrix and returns a list
+        agg <- scrapper::aggregateAcrossCells(counts(sce),
             DataFrame(
                 registration_variable = sce[["var_registration"]],
                 registration_sample_id = sce[[var_sample_id]]
-            )
+            ))
+        
+        ## Start with the original colData structure.
+        ## Each pseudo-bulk column corresponds to one combination
+        ## of registration variable and sample ID.
+        group_index <- agg$index
+        
+        pseudo_coldata <- DataFrame(row.names = seq_len(nrow(agg$combinations)))
+        
+        ## Reproduce scuttle's behavior of retaining colData values
+        ## that are constant within each pseudo-bulk group.
+        for (col_i in colnames(colData(sce))) {
+            ## var_registration is a temporary column and is replaced
+            ## by registration_variable below.
+            if (col_i == "var_registration") {
+                next
+            }
+            
+            values <- sce[[col_i]]
+            
+            ## Determine the value for each pseudo-bulk group.
+            grouped_values <- lapply(seq_len(nrow(agg$combinations)), function(i) {
+                vals <- values[group_index == i]
+                
+                ## Remove NAs when determining whether there is
+                ## a unique value.
+                non_na <- vals[!is.na(vals)]
+                unique_vals <- unique(non_na)
+                
+                if (length(unique_vals) == 1L) {
+                    unique_vals
+                } else {
+                    NA
+                }
+            })
+            
+            ## Preserve the type/class of the original colData column.
+            if (is.factor(values)) {
+                pseudo_coldata[[col_i]] <- factor(vapply(grouped_values, function(x) {
+                    if (length(x) == 1L && !is.na(x)) {
+                        as.character(x)
+                    } else {
+                        NA_character_
+                    }
+                }, character(1)),
+                    levels = levels(values))
+                
+            } else if (is.character(values)) {
+                pseudo_coldata[[col_i]] <- vapply(grouped_values, function(x) {
+                    if (length(x) == 1L) {
+                        as.character(x)
+                    } else {
+                        NA_character_
+                    }
+                }, character(1))
+                
+            } else if (is.integer(values)) {
+                pseudo_coldata[[col_i]] <- vapply(grouped_values, function(x) {
+                    if (length(x) == 1L) {
+                        as.integer(x)
+                    } else {
+                        NA_integer_
+                    }
+                }, integer(1))
+                
+            } else if (is.numeric(values)) {
+                pseudo_coldata[[col_i]] <- vapply(grouped_values, function(x) {
+                    if (length(x) == 1L) {
+                        as.numeric(x)
+                    } else {
+                        NA_real_
+                    }
+                }, numeric(1))
+                
+            } else if (is.logical(values)) {
+                pseudo_coldata[[col_i]] <- vapply(grouped_values, function(x) {
+                    if (length(x) == 1L) {
+                        as.logical(x)
+                    } else {
+                        NA
+                    }
+                }, logical(1))
+                
+            } else {
+                ## Fallback for other vector-like colData types
+                pseudo_coldata[[col_i]] <- values[match(seq_len(nrow(agg$combinations)), group_index)]
+            }
+        }
+        
+        ## Add the grouping variables generated by scrapper.
+        pseudo_coldata$registration_variable <-
+            agg$combinations$registration_variable
+        
+        pseudo_coldata$registration_sample_id <-
+            agg$combinations$registration_sample_id
+        
+        ## Number of cells contributing to each pseudo-bulk sample.
+        pseudo_coldata$ncells <- agg$counts
+        
+        ## Construct the pseudobulk SingleCellExperiment.
+        sce_pseudo <- SingleCellExperiment(
+            assays = list(counts = agg$sums),
+            rowData = rowData(sce),
+            colData = pseudo_coldata
         )
+        
+        ## Use the same pseudobulk column names as the original implementation.
         colnames(sce_pseudo) <-
