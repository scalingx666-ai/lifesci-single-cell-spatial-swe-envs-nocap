+        out,
+        cat_offsets=cat_offsets,
+        cell_indices=cell_indices,
+        bias=bias,
+        n_batches=n_batches,
+    )
+    cp.cuda.Device().synchronize()
+
+    expected_np = np.zeros((n_batches + 1, n_pcs), dtype=np.dtype(dtype))
+    expected_np[0] = X_np.T @ bias_np
