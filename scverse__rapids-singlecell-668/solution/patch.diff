+    cats = cp.asarray(cats_np)
+    cat_offsets, cell_indices = _create_category_index_mapping(cats, n_batches)
+
+    out = cp.zeros((n_batches + 1, n_pcs), dtype=dtype)
+    _scatter_add_cp_bias_csr(
