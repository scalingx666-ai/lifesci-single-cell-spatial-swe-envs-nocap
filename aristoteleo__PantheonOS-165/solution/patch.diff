diff --git a/docker/analysis-envs/pantheon-base.yml b/docker/analysis-envs/pantheon-base.yml
new file mode 100644
index 000000000..959c67fed
--- /dev/null
+++ b/docker/analysis-envs/pantheon-base.yml
@@ -0,0 +1,149 @@
+# The analysis stack, preinstalled in the image.
+#
+# This is the BASELINE: it lives in the image, is the same for everyone, and
+# costs nothing at runtime. A user's own environment sits on the Volume and
+# inherits from this one, so `conda install`, `pip install` and
+# `install.packages()` all persist while the heavy shared stack does not have
+# to be downloaded per workspace.
+#
+# The list came from what the built-in skills and agents actually import,
+# counted across pantheon/factory/templates — scanpy appears 81 times, numpy
+# 67, matplotlib 56 — rather than from a guess at what people might want.
+#
+# Deliberately NOT here, because each is large and narrow, and any of them
+# installs into a user's own environment in one command and stays there:
+#   pytorch with CUDA (~5 GB, and these sandboxes have no GPU — pytorch-cpu
+#     is here instead), rapids-singlecell (GPU), BSgenome.Hsapiens.UCSC.hg38
+#     (~1 GB), openslide, cooler, cooltools, pyvista, stardist, SpaGCN,
+#     STAGATE_pyG, scglue, spateo.
+#
+#   squidpy, for a duller reason: it drags in dask-image, which has no source
+#   build that works in this image, and six attempts to get pip to take the
+#   wheel instead did not. It installs fine into a user's own environment
+#   (`pip install squidpy`, where it persists), and holding 800 other packages
+#   back for it was the wrong trade. Worth revisiting.
+#
+# Adding a package here costs image size and therefore cold-start pull time;
+# a sandbox that has never pulled this image takes about ten times longer to
+# start than a prewarmed one. Weigh both.
+
+name: pantheon-base
+# Named for what it is, and NOT `analysis`: the personal environment on the
+# Volume is called that, and two environments with one name left conda unable
+# to show either by name — `conda env list` printed bare paths, and
+# `conda activate analysis` was ambiguous. This one is the read-only stack in
+# the image; yours is the one you install into.
+# Every module here is imported at build time; the build fails if one does not.
+# The solver checking that a set of packages CAN be installed together is not
+# the same as them working together — squidpy and decoupler both solved
+# cleanly into this environment and then failed on import. Both turned out to
+# be conda-forge carrying an old build rather than a real conflict, and both
+# are installed from pip below; the check is what stopped either from shipping
+# a second time.
+# verify: decoupler numpy scipy pandas anndata scanpy muon scvi scvelo harmonypy scrublet spatialdata snapatac2 scirpy rpy2 scib sklearn skimage cv2 tifffile matplotlib seaborn dask polars
+channels:
+  - conda-forge
+  - bioconda
+dependencies:
+  # --- python and the numeric core -------------------------------------
+  - python=3.12
+  - pip
+  - numpy
+  - scipy
+  - pandas
+  - polars
+  - dask
+  - scikit-learn
+  - scikit-image
+  - statsmodels
+  - numba
+  - h5py
+  - zarr
+  - requests
+  - tqdm
+
+  # --- plotting --------------------------------------------------------
+  - matplotlib-base
+  - seaborn
+  - plotly
+
+  # --- single cell, the core of what the skills do ---------------------
+  - anndata
+  - scanpy
+  - muon
+  - mudata
+  - scvelo
+  - scrublet
+  - harmonypy
+  - scanorama
+  - leidenalg
+  - louvain
+  - igraph
+  - pynndescent
+
+  # --- heavier, but each is used by several skills ---------------------
+  - pytorch-cpu          # scvi-tools needs it; the CUDA build is ~5 GB
+  - scvi-tools
+  - snapatac2
+  - scirpy
+  - spatialdata
+  - tiledbsoma-py
+  - cellxgene-census
+
+  # --- imaging ---------------------------------------------------------
+  - tifffile
+  - imagecodecs
+  - opencv
+
+  # --- notebook plumbing ------------------------------------------------
+  - ipykernel
+  - jupyter_client
+  - nest-asyncio
+
+  # --- R, and the bridge between the two --------------------------------
+  - r-base=4.4
+  - r-irkernel
+  - rpy2
+  - anndata2ri
+  - r-seurat
+  - r-seuratobject
+  - r-matrix
+  - r-dplyr
+  - r-ggplot2
+  - r-soupx
+  - bioconductor-singlecellexperiment
+  - bioconductor-scater
+  - bioconductor-scran
+  - bioconductor-scuttle
+  - bioconductor-scdblfinder
+  - bioconductor-zellkonverter
+  - bioconductor-limma
+  - bioconductor-edger
+  - bioconductor-deseq2
+  - bioconductor-mast
+  - bioconductor-complexheatmap
+
+  # --- installed with pip because conda-forge has no build --------------
+  - pip:
+      # No source distribution for the two that need a compiler, and only
+      # those two. Blanket --only-binary=:all: was too blunt: it also refused
+      # docrep, a pure-Python dependency of decoupler whose sdist costs
+      # nothing to build, so decoupler did not install at all and the import
+      # check caught the old conda copy left behind.
+      #
+      # dask-image and cython are the ones that actually tried to compile in
+      # an image with no toolchain, taking three builds to identify because
+      # the failure came from inside a build backend that never named them.
+      - "--only-binary=dask-image,cython"
+      # scib has no conda package anywhere. decoupler comes from pip because
+      # conda-forge still carries the 1.x line, whose numba code will not
+      # compile against a modern numba; 2.2.0 is a rewrite and imports against
+      # this environment's numpy and numba. Both were lost in an earlier edit
+      # of this block, and the import check is what noticed.
+      - scib
+      - decoupler>=2.2
+      - gget
+      - omicverse
+      - liana
+      - palantir
+      - tangram-sc
diff --git a/docker/analysis-envs/pyscenic.yml b/docker/analysis-envs/pyscenic.yml
new file mode 100644
index 000000000..d8daea2c0
--- /dev/null
+++ b/docker/analysis-envs/pyscenic.yml
@@ -0,0 +1,28 @@
+# pySCENIC, which cannot live with the others.
+#
+# It requires numpy==1.23.5. In the main environment that pin wins the solve
+# and drags scanpy, scvi-tools and everything else built against a modern
+# numpy back with it — so the solve either fails outright or succeeds into
+# something quietly broken.
+#
+# An environment of its own is the honest answer: pySCENIC gets the numpy it
+# was built against, nothing else is dragged anywhere, and it is reachable the
+# same way every other environment here is — by kernelspec name, or by
+# `conda run -n pyscenic`.
+#
+# Regulon inference is a step, not a session: work moves between here and the
+# main environment as files (loom, csv), which is how pySCENIC is used anyway.
+
+name: pyscenic
+# verify: pyscenic numpy pandas loompy anndata
+channels:
+  - conda-forge
+  - bioconda
+dependencies:
+  - python=3.10
+  - pip
+  - pyscenic
+  - ipykernel        # so it shows up as a kernel like the rest
+  - pandas
+  - loompy
+  - anndata
