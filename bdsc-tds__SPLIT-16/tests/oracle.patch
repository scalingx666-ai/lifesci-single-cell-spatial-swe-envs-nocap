+<span id="cb6-9"><a href="#cb6-9" tabindex="-1"></a>local_path <span class="ot">&lt;-</span> <span class="fu">tempfile</span>(<span class="at">fileext =</span> <span class="st">&quot;.rds&quot;</span>)</span>
