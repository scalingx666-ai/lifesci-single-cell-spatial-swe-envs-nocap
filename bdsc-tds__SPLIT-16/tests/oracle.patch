+<div class="sourceCode" id="cb17"><pre class="sourceCode r"><code class="sourceCode r"><span id="cb17-1"><a href="#cb17-1" tabindex="-1"></a><span class="co"># Create a purified Seurat object</span></span>
+<span id="cb17-2"><a href="#cb17-2" tabindex="-1"></a>xe_purified <span class="ot">&lt;-</span> <span class="fu">CreateSeuratObject</span>(</span>
+<span id="cb17-3"><a href="#cb17-3" tabindex="-1"></a>  <span class="at">counts =</span> res_split<span class="sc">$</span>purified_counts,</span>
+<span id="cb17-4"><a href="#cb17-4" tabindex="-1"></a>  <span class="at">meta.data =</span> res_split<span class="sc">$</span>cell_meta,</span>
