+    "        df_plot[\"method\"].append(method)\n",
+    "        df_plot[\"trait\"].append(trait)\n",
+    "        df_plot[\"n_discovery\"].append(np.sum(df_score[\"fdr\"] < 0.1))\n",
+    "    return pd.DataFrame(df_plot)"
