+def save_image(image_np: NDArrayA, file_path: str) -> None:
+    """Save image to file.
+
+    Parameters
+    ----------
+    image_np
+        Image as numpy array.
+
+    file_path
+        File path of the image.
+    """
+    im = Image.fromarray(image_np)
+    im.save(file_path)
