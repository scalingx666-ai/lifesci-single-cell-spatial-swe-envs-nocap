+def test_upset_dict_colors_only_override_matching_columns_and_rows():
+    sets = {
+        "A": {"shared_1", "shared_2", "shared_3", "a"},
+        "B": {"shared_1", "shared_2", "shared_3", "b"},
+        "C": {"shared_1", "shared_2", "shared_3", "c"},
