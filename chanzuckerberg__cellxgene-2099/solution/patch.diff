+
+        X = self.get_X_array(obs_selector, var_selector)
+        if sparse.issparse(X):
+            mean = X.mean(axis=1)
+        else:
+            mean = X.mean(axis=1, keepdims=True)
+        col_idx = pd.Index([geneset_name])
+        return encode_matrix_fbs(mean, col_idx=col_idx, row_idx=None)
