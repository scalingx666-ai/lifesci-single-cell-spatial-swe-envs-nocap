+
+        data_size_ = std::min(num_bytes, data_size_);
+        num_cells_ = std::min(num_cells, num_cells_);
+    }
+
+    max_data_size_ = num_bytes;
+    max_num_cells_ = num_cells;
+
+    data_ = data_buffer;
+    offsets_ = offsets_buffer;
+    validity_ = validity_buffer;
