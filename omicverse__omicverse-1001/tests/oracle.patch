+r"""Image segmentation backends for ``ov.space.seg.segment``.
+
+A backend is built once per call, sees a downsampled copy of the whole image in
+:meth:`Backend.prepare` (so intensity scaling is global, not per tile), and is
+then called on each window by the tiling engine. Heavy libraries are imported
+in ``_build`` only, the first time a window is segmented.
+"""
+from __future__ import annotations
+
+import os
+import warnings
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+from ..._optional import build_optional_dependency_error
+
+
+def _cache_dir() -> Path:
+    root = os.environ.get("OV_SEG_CACHE") or os.path.join(
+        os.path.expanduser("~"), ".cache", "omicverse", "seg"
+    )
+    path = Path(root)
+    path.mkdir(parents=True, exist_ok=True)
+    return path
+
+
+def _torch_device(gpu, *, mps: bool = True) -> str:
+    """``'cuda'`` / ``'mps'`` / ``'cpu'`` from a bool or an explicit device string.
+
+    ``mps=False`` skips Apple MPS when picking automatically, for models whose
+    post-processing needs float64 tensors (unsupported on MPS).
+    """
+    if isinstance(gpu, str):
+        return gpu
+    if not gpu:
+        return "cpu"
+    try:
+        import torch
+    except ImportError:
+        return "cpu"
+    if torch.cuda.is_available():
+        return "cuda"
+    if mps and getattr(torch.backends, "mps", None) is not None and torch.backends.mps.is_available():
+        return "mps"
+    return "cpu"
+
+
+def _sample(image, max_pixels: int = 4_000_000) -> np.ndarray:
+    """A strided view of ``image`` with at most ``max_pixels`` pixels."""
+    H, W = int(image.shape[0]), int(image.shape[1])
+    step = max(1, int(np.ceil(np.sqrt(H * W / max_pixels))))
+    return np.asarray(image[::step, ::step])
+
+
+def _odd(n: float) -> int:
+    n = max(3, int(round(n)))
+    return n if n % 2 else n + 1
+
+
+class Backend:
+    """Base class: intensity handling shared by every image backend.
+
+    ``image_type`` decides what "signal" means. ``'fluorescence'`` -- bright
+    objects on a dark background (DAPI, a stain channel, an expression image);
+    ``'he'`` -- an RGB brightfield H&E image, whose nuclear signal is the
+    haematoxylin channel; ``'auto'`` -- ``'he'`` for 3-/4-channel images,
+    otherwise ``'fluorescence'``.
+    """
+
+    name = "base"
+    #: modules imported by ``_build``; reported in the missing-dependency error
+    requires: tuple = ()
+    install = ""
+    default_tile_size = 2048
+
+    def __init__(self, *, gpu=False, image_type="auto", channel=None,
+                 diameter=None, percentiles=(1.0, 99.8)):
+        if image_type not in ("auto", "fluorescence", "he"):
+            raise ValueError("image_type must be 'auto', 'fluorescence' or 'he'")
+        self.gpu = gpu
+        self.image_type = image_type
+        self.channel = channel
+        self.diameter = diameter
+        self.percentiles = tuple(percentiles)
+        self._model = None
+        self._lo, self._hi = 0.0, 1.0            # nuclear signal
+        self._gray_lo, self._gray_hi = 0.0, 1.0  # luminance of an RGB image
+        self._ch_lo = self._ch_hi = None         # per RGB channel
+        self._rgb_lo, self._rgb_hi = 0.0, 255.0  # whole RGB range
+
+    # -- intensity ---------------------------------------------------------
+    def _resolve_type(self, image) -> None:
+        if self.image_type == "auto":
+            is_rgb = image.ndim == 3 and image.shape[-1] in (3, 4) and self.channel is None
+            self.image_type = "he" if is_rgb else "fluorescence"
+        if self.image_type == "he" and not (image.ndim == 3 and image.shape[-1] >= 3):
+            raise ValueError("image_type='he' expects an (H, W, 3) RGB image")
+
+    def _raw_signal(self, tile: np.ndarray) -> np.ndarray:
+        """Nuclear/foreground signal, unscaled, one channel."""
+        if self.image_type == "he":
+            from skimage.color import rgb2hed
+            rgb = tile[..., :3]
+            if rgb.dtype.kind == "f" and rgb.max() > 1.0:
+                rgb = rgb / 255.0
+            return rgb2hed(rgb)[..., 0]
+        if tile.ndim == 3:
+            if self.channel is not None:
+                return tile[..., self.channel].astype(np.float32)
+            return tile.mean(axis=-1, dtype=np.float32)
+        return tile.astype(np.float32, copy=False)
+
+    def prepare(self, sample: np.ndarray) -> None:
+        """Fix the global intensity scale from a downsampled whole image."""
+        self._resolve_type(sample)
+        sig = self._raw_signal(sample)
+        lo, hi = np.percentile(sig, self.percentiles)
+        self._lo, self._hi = float(lo), float(max(hi, lo + 1e-12))
+        if sample.ndim == 3 and sample.shape[-1] >= 3:
+            rgb = sample[..., :3].astype(np.float32)
+            lo, hi = np.percentile(rgb, (0.0, 100.0))
+            self._rgb_lo, self._rgb_hi = float(lo), float(max(hi, lo + 1e-12))
+            lo, hi = np.percentile(rgb.reshape(-1, 3), self.percentiles, axis=0)
+            self._ch_lo, self._ch_hi = lo, np.maximum(hi, lo + 1e-12)
+            lo, hi = np.percentile(self._luminance(rgb), self.percentiles)
+            self._gray_lo, self._gray_hi = float(lo), float(max(hi, lo + 1e-12))
+
+    @staticmethod
+    def _luminance(rgb: np.ndarray) -> np.ndarray:
+        return rgb[..., :3].astype(np.float32) @ np.array([0.2125, 0.7154, 0.0721], np.float32)
+
+    # Percentile stretches map the global low/high percentiles to 0/1 and do not
+    # clip, like csbdeep.normalize (StarDist) and normalize99 (Cellpose).
+    def signal(self, tile: np.ndarray) -> np.ndarray:
+        """Foreground signal stretched with the global percentiles (~``[0, 1]``)."""
+        sig = (self._raw_signal(tile) - self._lo) / (self._hi - self._lo)
+        return sig.astype(np.float32)
+
+    def gray(self, tile: np.ndarray) -> np.ndarray:
+        """Luminance of an RGB tile, stretched with the global percentiles."""
+        g = (self._luminance(tile) - self._gray_lo) / (self._gray_hi - self._gray_lo)
+        return g.astype(np.float32)
+
+    def rgb_norm(self, tile: np.ndarray, *, joint: bool = False) -> np.ndarray:
+        """RGB tile stretched per channel (or jointly) with the global percentiles."""
+        rgb = tile[..., :3].astype(np.float32)
+        if joint:
+            lo, hi = np.min(self._ch_lo), np.max(self._ch_hi)
+        else:
+            lo, hi = self._ch_lo, self._ch_hi
+        return ((rgb - lo) / (hi - lo)).astype(np.float32)
+
+    def signal8(self, tile: np.ndarray) -> np.ndarray:
+        """:meth:`signal` as ``uint8``."""
+        return (np.clip(self.signal(tile), 0.0, 1.0) * 255).astype(np.uint8)
+
+    def rgb8(self, tile: np.ndarray) -> np.ndarray:
+        """``uint8`` RGB for the natural-image models (SAM family, CellSAM)."""
+        if self.image_type == "he":
+            rgb = tile[..., :3].astype(np.float32)
+            if tile.dtype == np.uint8:
+                return np.ascontiguousarray(tile[..., :3])
+            rgb = (rgb - self._rgb_lo) / (self._rgb_hi - self._rgb_lo)
+            return (np.clip(rgb, 0, 1) * 255).astype(np.uint8)
+        return np.repeat(self.signal8(tile)[..., None], 3, axis=-1)
+
+    # -- model -------------------------------------------------------------
+    def _build(self) -> Any:  # pragma: no cover - overridden
+        raise NotImplementedError
+
+    def model(self):
+        if self._model is None:
+            try:
+                self._model = self._build()
+            except ImportError as exc:
+                missing = getattr(exc, "name", None)
+                if missing and missing.split(".")[0] not in {r.split(".")[0] for r in self.requires}:
+                    raise
+                raise build_optional_dependency_error(
+                    f"ov.space.seg.segment(method={self.name!r})",
+                    self.requires,
+                    install_hint=self.install,
+                ) from exc
+        return self._model
+
+    def __call__(self, tile: np.ndarray) -> np.ndarray:  # pragma: no cover - overridden
+        raise NotImplementedError
+
+
+# ---------------------------------------------------------------------------
+# classical
+# ---------------------------------------------------------------------------
+class WatershedBackend(Backend):
+    """Marker-controlled watershed -- the classical baseline.
+
+    Follows the Spateo pipeline benchmarked by Martinez-de-Morentin et al.
+    (Nat. Methods 2026): a global multi-Otsu threshold plus a local adaptive
+    threshold give the foreground, Gaussian-smoothed intensity maxima are the
+    markers, and the watershed of the inverted smoothed image splits touching
+    objects. Needs only scikit-image.
+    """
+
+    name = "watershed"
+    requires = ("skimage",)
+
+    def __init__(self, *, otsu_classes=4, otsu_index=1, sigma=None, min_distance=None,
+                 local_block=None, local_offset=0.02, min_size=None, compactness=0.0,
+                 **kw):
+        super().__init__(**kw)
+        self.otsu_classes = otsu_classes
+        self.otsu_index = otsu_index
+        d = self.diameter
+        self.sigma = sigma if sigma is not None else (max(1.0, d / 6.0) if d else 2.0)
+        self.min_distance = (min_distance if min_distance is not None
+                             else (max(2, int(d / 3)) if d else 4))
+        self.local_block = local_block if local_block is not None else (_odd(4 * d) if d else 55)
+        self.local_offset = local_offset
+        self.min_size = (min_size if min_size is not None
+                         else (int(0.15 * np.pi * (d / 2) ** 2) if d else 16))
+        self.compactness = compactness
+        self._threshold = None
+
+    def prepare(self, sample):
+        super().prepare(sample)
+        from skimage.filters import gaussian, threshold_multiotsu
+        smooth = gaussian(np.clip(self.signal(sample), 0.0, 1.0), sigma=1.0)
+        try:
+            thresholds = threshold_multiotsu(smooth, classes=self.otsu_classes)
+            self._threshold = float(thresholds[min(self.otsu_index, len(thresholds) - 1)])
+        except ValueError:  # flat image: fewer grey levels than classes
+            self._threshold = float(smooth.mean())
+
+    def _build(self):
+        import skimage  # noqa: F401
+        return True
+
+    def __call__(self, tile):
+        from scipy import ndimage as ndi
+        from skimage.feature import peak_local_max
+        from skimage.filters import gaussian, threshold_local
+        from skimage.segmentation import watershed
+
+        self.model()
+        img = np.clip(self.signal(tile), 0.0, 1.0)
+        smooth = gaussian(img, sigma=self.sigma)
+        fg = smooth > self._threshold
+        if self.local_block and min(img.shape) > self.local_block:
+            fg &= img > threshold_local(img, self.local_block, method="gaussian",
+                                        offset=self.local_offset)
+        cross = ndi.generate_binary_structure(2, 1)
+        fg = ndi.binary_opening(ndi.binary_closing(fg, cross), cross)
+        fg = ndi.binary_fill_holes(fg)
+        components, _ = ndi.label(fg)
+        small = np.bincount(components.ravel()) < self.min_size
+        small[0] = False
+        fg[small[components]] = False
+        components[~fg] = 0
+        if not fg.any():
+            return np.zeros(img.shape, dtype=np.int32)
+        peaks = peak_local_max(smooth, min_distance=self.min_distance, labels=components,
+                               exclude_border=False)
+        markers = np.zeros(img.shape, dtype=np.int32)
+        markers[tuple(peaks.T)] = np.arange(1, len(peaks) + 1)
+        # components without a peak (flat tops) still become one object
+        seeded = np.unique(components[markers > 0])
+        orphan = np.setdiff1d(np.unique(components[components > 0]), seeded)
+        if orphan.size:
+            extra = np.isin(components, orphan)
+            markers[extra] = components[extra] + len(peaks)
+        labels = watershed(-smooth, markers, mask=fg, compactness=self.compactness)
+        return labels.astype(np.int32)
+
+
+# ---------------------------------------------------------------------------
+# deep learning, image only
+# ---------------------------------------------------------------------------
+def _call_with_supported(fn, args: tuple, kwargs: dict):
+    """Call ``fn`` with only the keyword arguments its signature accepts."""
+    import inspect
+    params = inspect.signature(fn).parameters
+    if any(p.kind is p.VAR_KEYWORD for p in params.values()):
+        return fn(*args, **kwargs)
+    return fn(*args, **{k: v for k, v in kwargs.items() if k in params})
+
+
+class CellposeBackend(Backend):
+    """Cellpose (v2, v3 with image restoration, v4 Cellpose-SAM).
+
+    ``model`` defaults to ``'cpsam'`` on Cellpose 4 and ``'cyto3'`` on 3
+    (``'cyto'`` before). ``restore_type='denoise_cyto3'`` runs Cellpose 3's
+    denoising model first, as in the Nature Methods 2026 benchmark. Images are
+    normalised once globally and passed with ``normalize=False``.
+    """
+
+    name = "cellpose"
+    requires = ("cellpose",)
+    install = "Install with `pip install cellpose` (or `pip install 'omicverse[seg]'`)."
+
+    _V3_ONLY = {"cyto", "cyto2", "cyto3", "nuclei", "tissuenet_cp3", "livecell_cp3",
+                "yeast_PhC_cp3", "yeast_BF_cp3", "bact_phase_cp3", "bact_fluor_cp3",
+                "deepbacs_cp3", "cyto2_cp3"}
+
+    def __init__(self, *, model=None, restore_type=None, flow_threshold=0.4,
+                 cellprob_threshold=0.0, batch_size=None, **kw):
+        eval_keys = ("niter", "min_size", "stitch_threshold", "augment", "tile_overlap",
+                     "bsize", "max_size_fraction", "resample", "normalize", "invert")
+        self.eval_kwargs = {k: kw.pop(k) for k in list(kw) if k in eval_keys}
+        super().__init__(**kw)
+        self.model_name = model
+        self.restore_type = restore_type
+        self.flow_threshold = flow_threshold
+        self.cellprob_threshold = cellprob_threshold
+        self.batch_size = batch_size
+        self._major = None
+
+    def _build(self):
+        from importlib.metadata import version
+
+        from cellpose import models
+        try:
+            self._major = int(version("cellpose").split(".")[0])
+        except Exception:  # pragma: no cover - editable installs without metadata
+            self._major = 4 if not hasattr(models, "Cellpose") else 3
+        device_gpu = _torch_device(self.gpu) != "cpu"
+        if self._major >= 4:
+            if self.restore_type:
+                raise ValueError("restore_type needs Cellpose 3; Cellpose 4 (Cellpose-SAM) "
+                                 "is trained to be robust to noise and has no restore models")
+            name = self.model_name or "cpsam"
+            if name in self._V3_ONLY:
+                warnings.warn(f"Cellpose 4 has no {name!r} model; using Cellpose-SAM ('cpsam').",
+                              stacklevel=3)
+                name = "cpsam"
+            return models.CellposeModel(gpu=device_gpu, pretrained_model=name)
+        name = self.model_name or ("cyto3" if self._major == 3 else "cyto")
+        if self.restore_type:
+            from cellpose import denoise
+            return denoise.CellposeDenoiseModel(gpu=device_gpu, model_type=name,
+                                                restore_type=self.restore_type)
+        if name in self._V3_ONLY:
+            return models.CellposeModel(gpu=device_gpu, model_type=name)
+        return models.CellposeModel(gpu=device_gpu, pretrained_model=name)
+
+    def __call__(self, tile):
+        model = self.model()
+        if self._major >= 4 and self.image_type == "he":
+            x = self.rgb_norm(tile)
+            channel_kw = {"channel_axis": -1}
+        else:
+            # Cellpose <= 3 on H&E: grayscale, as the original bin2cell path did
+            x = self.gray(tile) if self.image_type == "he" else self.signal(tile)
+            channel_kw = {"channel_axis": None, "channels": [0, 0]}
+        if min(x.shape[:2]) < 16:
+            return np.zeros(x.shape[:2], dtype=np.int32)
+        kwargs = {"diameter": self.diameter, "flow_threshold": self.flow_threshold,
+                  "cellprob_threshold": self.cellprob_threshold, "normalize": False,
+                  **channel_kw, **self.eval_kwargs}
+        if self.batch_size is not None:
+            kwargs["batch_size"] = self.batch_size
+        out = _call_with_supported(model.eval, (x,), kwargs)
+        masks = out[0] if isinstance(out, tuple) else out
+        return np.asarray(masks, dtype=np.int32)
+
+
+class StarDistBackend(Backend):
+    """StarDist star-convex polygons (``2D_versatile_fluo`` / ``2D_versatile_he``).
+
+    The model follows ``image_type`` unless given. StarDist runs on
+    TensorFlow, which picks the GPU itself; ``gpu`` is ignored.
+    """
+
+    name = "stardist"
+    requires = ("stardist", "tensorflow")
+    install = "Install with `pip install stardist tensorflow`."
+    default_tile_size = 2048
+
+    def __init__(self, *, model=None, prob_thresh=None, nms_thresh=None, n_tiles=None, **kw):
+        super().__init__(**kw)
+        self.model_name = model
+        self.prob_thresh = prob_thresh
+        self.nms_thresh = nms_thresh
+        self.n_tiles = n_tiles
+
+    def _build(self):
+        from stardist.models import StarDist2D
+        name = self.model_name or ("2D_versatile_he" if self.image_type == "he"
+                                   else "2D_versatile_fluo")
+        if os.path.isdir(str(name)):
+            p = Path(name)
+            return StarDist2D(None, name=p.name, basedir=str(p.parent))
+        return StarDist2D.from_pretrained(name)
+
+    def __call__(self, tile):
+        model = self.model()
+        if model.config.n_channel_in == 3:
+            x = self.rgb_norm(tile, joint=True)  # StarDist's normalize(img, 1, 99.8, axis=(0,1,2))
+        else:
+            x = self.signal(tile)
+        if min(x.shape[:2]) < 16:
+            return np.zeros(x.shape[:2], dtype=np.int32)
+        kwargs = {"prob_thresh": self.prob_thresh, "nms_thresh": self.nms_thresh,
+                  "show_tile_progress": False, "verbose": False}
+        if self.n_tiles is not None:
+            kwargs["n_tiles"] = self.n_tiles
+        labels, _ = _call_with_supported(model.predict_instances, (x,), kwargs)
+        return np.asarray(labels, dtype=np.int32)
+
+
+def _masks_to_labels(masks, *, min_area=0, max_area=None) -> np.ndarray | None:
+    """Paint SAM-style mask records into one label image, small over large.
+
+    Masks larger than ``max_area`` (tissue, background) are dropped; where
+    masks overlap the smaller one wins, which keeps a nucleus that SAM also
+    returned as part of a bigger blob.
+    """
+    if not masks:
+        return None
+    shape = np.asarray(masks[0]["segmentation"]).shape
+    out = np.zeros(shape, dtype=np.int32)
+    kept = [m for m in masks
+            if m.get("area", int(np.count_nonzero(m["segmentation"]))) >= min_area
+            and (max_area is None or m.get("area", 0) <= max_area)]
+    kept.sort(key=lambda m: m.get("area", 0), reverse=True)
+    for i, m in enumerate(kept, start=1):
+        out[np.asarray(m["segmentation"], dtype=bool)] = i
+    if not kept:
+        return out
+    # painting can leave a large mask as scattered fragments: renumber what survives
+    ids, out_flat = np.unique(out, return_inverse=True)
+    out = out_flat.reshape(shape).astype(np.int32)
+    if ids[0] != 0:
+        out += 1
+    if min_area:
+        area = np.bincount(out.ravel())
+        out[area[out] < min_area] = 0
+        _, out_flat = np.unique(out, return_inverse=True)
+        out = out_flat.reshape(shape).astype(np.int32)
+    return out
+
+
+class _AMGBackend(Backend):
+    """Shared logic for automatic-mask-generator models (SAM, SAM 2)."""
+
+    default_tile_size = 1024
+
+    def __init__(self, *, points_per_side=32, pred_iou_thresh=0.88,
+                 stability_score_thresh=0.95, points_per_batch=64, crop_n_layers=0,
+                 min_area=None, max_area=None, amg_kwargs=None, **kw):
+        super().__init__(**kw)
+        self.amg_kwargs = dict(points_per_side=points_per_side, pred_iou_thresh=pred_iou_thresh,
+                               stability_score_thresh=stability_score_thresh,
+                               points_per_batch=points_per_batch, crop_n_layers=crop_n_layers,
+                               **(amg_kwargs or {}))
+        d = self.diameter
+        self.min_area = min_area if min_area is not None else (
+            int(0.1 * np.pi * (d / 2) ** 2) if d else 10)
+        self.max_area = max_area if max_area is not None else (
+            int(4 * np.pi * (d / 2) ** 2) if d else None)
+
+    def __call__(self, tile):
+        amg = self.model()
+        rgb = self.rgb8(tile)
+        if min(rgb.shape[:2]) < 16:
+            return np.zeros(rgb.shape[:2], dtype=np.int32)
+        masks = amg.generate(rgb)
+        max_area = self.max_area or int(0.02 * rgb.shape[0] * rgb.shape[1])
+        out = _masks_to_labels(masks, min_area=self.min_area, max_area=max_area)
+        return np.zeros(rgb.shape[:2], dtype=np.int32) if out is None else out
+
+
+_SAM_URLS = {
+    "vit_h": "https://dl.fbaipublicfiles.com/segment_anything/sam_vit_h_4b8939.pth",
+    "vit_l": "https://dl.fbaipublicfiles.com/segment_anything/sam_vit_l_0b3195.pth",
+    "vit_b": "https://dl.fbaipublicfiles.com/segment_anything/sam_vit_b_01ec64.pth",
+}
+
+
+class SAMBackend(_AMGBackend):
+    """Segment Anything (Kirillov et al., ICCV 2023), automatic mask generation.
+
+    Defaults are the benchmark's: ViT-H, 32 points per side, predicted-IoU
+    threshold 0.88, stability threshold 0.95. The checkpoint is downloaded to
+    ``$OV_SEG_CACHE`` (``~/.cache/omicverse/seg``) unless ``checkpoint`` is given.
+    """
+
+    name = "sam"
+    requires = ("segment_anything", "torch")
+    install = "Install with `pip install segment-anything` (or `pip install 'omicverse[seg]'`)."
+
+    def __init__(self, *, model="vit_h", checkpoint=None, **kw):
+        super().__init__(**kw)
+        self.model_name = model
+        self.checkpoint = checkpoint
+
+    def _build(self):
+        import torch
+        from segment_anything import SamAutomaticMaskGenerator, sam_model_registry
+
+        ckpt = self.checkpoint
+        if ckpt is None:
+            if self.model_name not in _SAM_URLS:
+                raise ValueError(f"model must be one of {sorted(_SAM_URLS)} or pass checkpoint=")
+            url = _SAM_URLS[self.model_name]
+            ckpt = _cache_dir() / Path(url).name
+            if not ckpt.exists():
+                torch.hub.download_url_to_file(url, str(ckpt))
+        sam = sam_model_registry[self.model_name](checkpoint=str(ckpt))
+        # the mask generator casts to float64, which MPS cannot hold
+        sam.to(_torch_device(self.gpu, mps=False))
+        return SamAutomaticMaskGenerator(sam, **self.amg_kwargs)
+
+
+class SAM2Backend(_AMGBackend):
+    """Segment Anything 2 (Ravi et al., ICLR 2025), automatic mask generation.
+
+    ``model`` is a Hugging Face id (default ``facebook/sam2-hiera-large``, the
+    benchmark's checkpoint) or a local config with ``checkpoint=``.
+    """
+
+    name = "sam2"
+    requires = ("sam2", "torch", "huggingface_hub")
+    install = ("Install with `pip install sam2 huggingface_hub` (Python >= 3.10, "
+               "or `pip install 'omicverse[seg]'`).")
+
+    def __init__(self, *, model="facebook/sam2-hiera-large", checkpoint=None,
+                 pred_iou_thresh=0.8, **kw):
+        super().__init__(pred_iou_thresh=pred_iou_thresh, **kw)
+        self.model_name = model
+        self.checkpoint = checkpoint
+
+    def _build(self):
+        from sam2.automatic_mask_generator import SAM2AutomaticMaskGenerator
+        from sam2.build_sam import build_sam2, build_sam2_hf
+
+        device = _torch_device(self.gpu, mps=False)
+        if self.checkpoint is not None:
+            net = build_sam2(self.model_name, self.checkpoint, device=device)
+        else:
+            net = build_sam2_hf(self.model_name, device=device)
+        return SAM2AutomaticMaskGenerator(net, **self.amg_kwargs)
+
+
+class MicroSAMBackend(Backend):
+    """micro-SAM (Archit et al., Nat. Methods 2025), SAM fine-tuned for microscopy.
+
+    ``model='vit_b_lm'`` (light microscopy, the benchmark's) by default.
+    micro-SAM's own automatic instance segmentation decoder is used when the
+    model has one; ``amg=True`` forces the plain mask generator instead, as in
+    the benchmark.
+    """
+
+    name = "micro_sam"
+    requires = ("micro_sam", "torch")
+    install = ("micro-SAM is distributed on conda-forge: "
+               "`conda install -c conda-forge micro_sam`.")
+    default_tile_size = 1024
+
+    def __init__(self, *, model="vit_b_lm", amg=None, generate_kwargs=None, **kw):
+        super().__init__(**kw)
+        self.model_name = model
+        self.amg = amg
+        self.generate_kwargs = generate_kwargs or {}
+
+    def _build(self):
+        from micro_sam.automatic_segmentation import get_predictor_and_segmenter
+        return get_predictor_and_segmenter(model_type=self.model_name,
+                                           device=_torch_device(self.gpu), amg=self.amg,
+                                           is_tiled=False)
+
+    def __call__(self, tile):
+        from micro_sam.automatic_segmentation import automatic_instance_segmentation
+        predictor, segmenter = self.model()
+        x = self.rgb8(tile) if self.image_type == "he" else self.signal8(tile)
+        if min(x.shape[:2]) < 16:
+            return np.zeros(x.shape[:2], dtype=np.int32)
+        labels = automatic_instance_segmentation(predictor=predictor, segmenter=segmenter,
+                                                 input_path=x, ndim=2, verbose=False,
+                                                 **self.generate_kwargs)
+        return np.asarray(labels, dtype=np.int32)
+
+
+class CellSAMBackend(Backend):
+    """CellSAM (Israel et al., 2023), a SAM-based cell foundation model.
+
+    Needs ``DEEPCELL_ACCESS_TOKEN`` for the first weight download.
+    """
+
+    name = "cellsam"
+    requires = ("cellSAM", "torch")
+    install = ("Install with `pip install git+https://github.com/vanvalenlab/cellSAM.git` "
+               "and set DEEPCELL_ACCESS_TOKEN.")
+    default_tile_size = 1024
+
+    def __init__(self, *, model="cellsam_general", bbox_threshold=0.4, **kw):
+        super().__init__(**kw)
+        self.model_name = model
+        self.bbox_threshold = bbox_threshold
+
+    def _build(self):
+        from cellSAM import get_model
+        return get_model(model=self.model_name)
+
+    def __call__(self, tile):
+        from cellSAM import segment_cellular_image
+        model = self.model()
+        try:
+            out = segment_cellular_image(self.rgb8(tile), model, device=_torch_device(self.gpu),
+                                         bbox_threshold=self.bbox_threshold)
+        except Exception as exc:  # CellSAM raises on tiles with nothing to box
+            warnings.warn(f"CellSAM failed on a tile ({exc}); leaving it empty.", stacklevel=2)
+            return None
+        masks = out[0] if isinstance(out, tuple) else out
+        if masks is None:
+            return None
+        return np.asarray(masks, dtype=np.int32)
+
+
+BACKENDS: dict[str, type[Backend]] = {
+    cls.name: cls
+    for cls in (WatershedBackend, CellposeBackend, StarDistBackend, SAMBackend,
+                SAM2Backend, MicroSAMBackend, CellSAMBackend)
+}
diff --git a/omicverse/space/seg/_metrics.py b/omicverse/space/seg/_metrics.py
new file mode 100644
index 000000000..eb8a8e829
--- /dev/null
+++ b/omicverse/space/seg/_metrics.py
@@ -0,0 +1,191 @@
+r"""Reference-free segmentation quality metrics.
+
+The subset of the CellSPA metrics used by Martinez-de-Morentin et al.
+(Nat. Methods 2026) that needs no single-cell reference: segmentation yield
+and transcript recovery (overall characteristics), transcripts and genes per
+cell (cell-level QC), and cell morphology (area, elongation, circularity,
+sphericity, compactness, convexity, eccentricity, solidity).
+"""
+from __future__ import annotations
+
+from typing import Mapping
+
+import numpy as np
+import pandas as pd
+
+from ..._registry import register_function
+from ._transcripts import _unassigned
+
+_MORPHOLOGY = ["area", "elongation", "circularity", "sphericity", "compactness",
+               "convexity", "eccentricity", "solidity"]
+
+
+def _morphology(labels) -> pd.DataFrame:
+    """Per-cell shape descriptors; formulas follow the benchmark's Methods (M5-M12)."""
+    from scipy import ndimage as ndi
+    from skimage.measure import perimeter, regionprops
+
+    dense = labels.toarray() if hasattr(labels, "toarray") else np.asarray(labels)
+    rows = []
+    for r in regionprops(dense):
+        area = float(r.area)
+        p = float(r.perimeter) or np.sqrt(area) * 4
+        p_convex = float(perimeter(r.image_convex)) or p
+        h = r.bbox[2] - r.bbox[0]
+        w = r.bbox[3] - r.bbox[1]
+        major = float(r.axis_major_length)
+        minor = float(r.axis_minor_length)
+        # inscribed radius: deepest pixel to the nearest background pixel;
+        # circumscribed radius: half the maximum Feret diameter
+        r_in = float(ndi.distance_transform_edt(np.pad(r.image, 1)).max())
+        r_circ = max(float(r.feret_diameter_max) / 2.0, 0.5)
+        rows.append({
+            "label": r.label,
+            "area": area,
+            # bounding-box aspect ratio, >= 1 so it is rotation-symmetric in x/y
+            "elongation": max(h, w) / max(min(h, w), 1),
+            "circularity": min(4 * np.pi * area / p_convex ** 2, 1.0),
+            "sphericity": min(r_in / r_circ, 1.0),
+            "compactness": min(4 * np.pi * area / p ** 2, 1.0),
+            "convexity": min(p_convex / p, 1.0),
+            "eccentricity": major / minor if minor > 0 else np.nan,
+            "solidity": float(r.solidity),
+        })
+    return pd.DataFrame(rows, columns=["label"] + _MORPHOLOGY).set_index("label")
+
+
+@register_function(
+    aliases=["分割评估", "segmentation metrics", "evaluate segmentation", "CellSPA", "细胞形态指标"],
+    category="space",
+    description="Per-cell segmentation quality metrics (CellSPA subset from the Nature Methods 2026 benchmark): transcripts and genes per cell, area, elongation, circularity, sphericity, compactness, convexity, eccentricity, solidity.",
+    examples=[
+        "cells = ov.space.seg.evaluate(labels, transcripts=tx, cell='cell', gene='gene')",
+        "cells = ov.space.seg.evaluate(labels)  # morphology only",
+    ],
+    related=["space.seg.compare", "space.seg.segment"],
+)
+def evaluate(
+    labels=None,
+    transcripts: pd.DataFrame | None = None,
+    *,
+    cell: str = "cell",
+    gene: str = "gene",
+    count: str | None = None,
+    pixel_size: float = 1.0,
+) -> pd.DataFrame:
+    """Per-cell quality metrics of one segmentation.
+
+    Parameters
+    ----------
+    labels
+        Label image; enables the morphology columns. ``None`` for a
+        transcript-only segmentation (Baysor).
+    transcripts
+        Molecules with a ``cell`` column (0 / NaN = unassigned); enables
+        ``n_transcripts`` and ``n_genes``. The overall assignment rate is
+        stored in ``.attrs['pct_assigned']``.
+    count
+        Optional per-row count column.
+    pixel_size
+        Converts ``area`` from pixels to transcript units squared.
+
+    Returns
+    -------
+    pandas.DataFrame
+        One row per cell, indexed by cell id.
+    """
+    if labels is None and transcripts is None:
+        raise ValueError("give `labels`, `transcripts`, or both")
+    parts = []
+    if labels is not None:
+        morph = _morphology(labels)
+        morph["area"] *= pixel_size ** 2
+        morph.index = morph.index.astype(str)
+        parts.append(morph)
+    pct = None
+    if transcripts is not None:
+        miss = _unassigned(transcripts[cell])
+        w = transcripts[count].to_numpy(dtype=float) if count else np.ones(len(transcripts))
+        pct = 100.0 * w[~miss].sum() / max(w.sum(), 1e-12)
+        tx = transcripts.loc[~miss]
+        ids = tx[cell].astype(str) if labels is None else tx[cell].astype(np.int64).astype(str)
+        grouped = pd.DataFrame({"cell": ids.to_numpy(), "gene": tx[gene].to_numpy(),
+                                "w": w[~miss]}).groupby("cell", sort=False)
+        qc = pd.DataFrame({"n_transcripts": grouped["w"].sum(),
+                           "n_genes": grouped["gene"].nunique()})
+        parts.append(qc)
+    out = pd.concat(parts, axis=1) if len(parts) > 1 else parts[0]
+    if transcripts is not None:
+        out[["n_transcripts", "n_genes"]] = out[["n_transcripts", "n_genes"]].fillna(0)
+    out.index.name = "cell"
+    out.attrs["pct_assigned"] = pct
+    return out
+
+
+def _summary(cells: pd.DataFrame, *, min_transcripts, max_transcripts, min_genes) -> dict:
+    row = {"n_cells": len(cells)}
+    if "n_transcripts" in cells:
+        hq = ((cells["n_transcripts"] >= min_transcripts)
+              & (cells["n_transcripts"] <= max_transcripts)
+              & (cells["n_genes"] > min_genes))
+        row["n_hq_cells"] = int(hq.sum())
+        row["pct_assigned"] = cells.attrs.get("pct_assigned")
+        row["transcripts_per_cell"] = float(cells.loc[hq, "n_transcripts"].mean()) if hq.any() else np.nan
+        row["genes_per_cell"] = float(cells.loc[hq, "n_genes"].mean()) if hq.any() else np.nan
+    for m in _MORPHOLOGY:
+        if m in cells:
+            row[m] = float(cells[m].median())
+    return row
+
+
+@register_function(
+    aliases=["分割方法比较", "compare segmentation", "segmentation benchmark", "分割基准"],
+    category="space",
+    description="Compare several segmentations of the same sample on reference-free CellSPA metrics (high-quality cell count, % transcripts assigned, transcripts/genes per cell, morphology medians) with a min-max-scaled overall rank, as in the Nature Methods 2026 benchmark.",
+    examples=[
+        "res = {m: ov.space.seg.evaluate(lab, transcripts=tx.assign(cell=ov.space.seg.assign_transcripts(tx, lab))) for m, lab in labels.items()}",
+        "table = ov.space.seg.compare(res)",
+    ],
+    related=["space.seg.evaluate"],
+)
+def compare(
+    results: Mapping[str, pd.DataFrame],
+    *,
+    min_transcripts: int = 20,
+    max_transcripts: int = 2000,
+    min_genes: int = 20,
+    score: tuple[str, ...] = ("n_hq_cells", "pct_assigned", "transcripts_per_cell",
+                              "genes_per_cell"),
+) -> pd.DataFrame:
+    """Side-by-side summary of segmentations, ranked.
+
+    Parameters
+    ----------
+    results
+        ``{method_name: ov.space.seg.evaluate(...)}``.
+    min_transcripts, max_transcripts, min_genes
+        High-quality cell filter (the benchmark's: 20-2,000 transcripts and
+        more than 20 genes).
+    score
+        Columns that enter the overall score; each is min-max scaled across
+        methods (higher is better) and averaged, as in the benchmark.
+
+    Returns
+    -------
+    pandas.DataFrame
+        One row per method with the summary metrics, ``overall`` and ``rank``.
+    """
+    table = pd.DataFrame({name: _summary(cells, min_transcripts=min_transcripts,
+                                         max_transcripts=max_transcripts, min_genes=min_genes)
+                          for name, cells in results.items()}).T
+    table = table.apply(pd.to_numeric, errors="coerce")
+    used = [c for c in score if c in table and table[c].notna().any()]
+    if used:
+        sub = table[used]
+        span = (sub.max() - sub.min()).replace(0, np.nan)
+        scaled = ((sub - sub.min()) / span).fillna(1.0)
+        table["overall"] = scaled.mean(axis=1)
+        table["rank"] = table["overall"].rank(ascending=False, method="min").astype(int)
+        table = table.sort_values("rank")
+    table.index.name = "method"
+    return table
diff --git a/omicverse/space/seg/_tiling.py b/omicverse/space/seg/_tiling.py
new file mode 100644
index 000000000..81322d75a
--- /dev/null
+++ b/omicverse/space/seg/_tiling.py
@@ -0,0 +1,146 @@
+r"""Tiled inference — segment an image of any size one window at a time.
+
+The image is partitioned into disjoint ``tile_size`` blocks. Each block is
+segmented together with a ``context`` margin on every side, and keeps only the
+objects whose centroid falls inside the block -- in full, including the pixels
+that spill into the margin. Every object therefore has exactly one owner, so
+nothing is cut at a seam or labelled twice, as long as ``context`` exceeds the
+object radius. When two owners claim the same margin pixel the earlier tile
+keeps it.
+"""
+from __future__ import annotations
+
+from typing import Callable, Iterator
+
+import numpy as np
+
+
+def tile_windows(shape, tile_size: int, context: int) -> Iterator[tuple[tuple, tuple]]:
+    """Yield ``(core, window)`` pairs as ``(y0, y1, x0, x1)`` in image pixels.
+
+    The cores partition the image; each window is its core grown by
+    ``context`` and clipped to the image.
+    """
+    H, W = int(shape[0]), int(shape[1])
+    tile_size = max(int(tile_size), 1)
+    context = max(int(context), 0)
+    for y0 in range(0, H, tile_size):
+        y1 = min(y0 + tile_size, H)
+        for x0 in range(0, W, tile_size):
+            x1 = min(x0 + tile_size, W)
+            yield (y0, y1, x0, x1), (
+                max(0, y0 - context), min(H, y1 + context),
+                max(0, x0 - context), min(W, x1 + context),
+            )
+
+
+def _owned_pixels(mask: np.ndarray, core: tuple, min_size: int):
+    """Pixels ``(rows, cols, ids)`` of the objects whose centroid lies in ``core``.
+
+    ``core`` is in the coordinates of ``mask``.
+    """
+    ys, xs = np.nonzero(mask)
+    if ys.size == 0:
+        return None
+    ids = mask[ys, xs].astype(np.int64, copy=False)
+    n = int(ids.max()) + 1
+    area = np.bincount(ids, minlength=n)
+    safe = np.maximum(area, 1)
+    cy = np.bincount(ids, weights=ys, minlength=n) / safe
+    cx = np.bincount(ids, weights=xs, minlength=n) / safe
+    y0, y1, x0, x1 = core
+    own = (area > max(int(min_size), 0)) & (cy >= y0) & (cy < y1) & (cx >= x0) & (cx < x1)
+    own[0] = False
+    keep = own[ids]
+    if not keep.any():
+        return None
+    return ys[keep], xs[keep], ids[keep]
+
+
+def segment_tiled(
+    image,
+    segmenter: Callable[[np.ndarray], np.ndarray],
+    *,
+    tile_size: int = 2048,
+    context: int = 128,
+    min_size: int = 0,
+    sparse: bool = False,
+    show_progress: bool = True,
+    desc: str = "ov.space.seg",
+):
+    """Run ``segmenter`` window by window and stitch one global label image.
+
+    Parameters
+    ----------
+    image
+        ``(H, W)`` or ``(H, W, C)`` array, or anything sliceable with a
+        ``shape`` (a memmap, a zarr array).
+    segmenter
+        Maps a window to an integer label image of the window's height and
+        width (0 = background).
+    tile_size, context
+        Block size and the margin segmented around it, in pixels.
+    min_size
+        Objects of at most this many pixels are dropped.
+    sparse
+        Return a ``scipy.sparse.csr_matrix`` instead of a dense array; the
+        label image is never materialised densely.
+
+    Returns
+    -------
+    numpy.ndarray or scipy.sparse.csr_matrix
+        ``int32`` labels ``1..n`` (0 = background), numbered in tile order.
+    """
+    H, W = int(image.shape[0]), int(image.shape[1])
+    windows = list(tile_windows((H, W), tile_size, context))
+    it = windows
+    if show_progress and len(windows) > 1:
+        try:
+            from tqdm.auto import tqdm
+            it = tqdm(windows, desc=desc, unit="tile")
+        except ImportError:  # pragma: no cover - tqdm ships with omicverse
+            pass
+
+    rows, cols, vals = [], [], []
+    next_id = 1
+    for core, (wy0, wy1, wx0, wx1) in it:
+        tile = np.asarray(image[wy0:wy1, wx0:wx1])
+        mask = segmenter(tile)
+        if mask is None:
+            continue
+        mask = np.asarray(mask)
+        if mask.shape[:2] != tile.shape[:2]:
+            raise ValueError(
+                f"segmenter returned shape {mask.shape} for a window of shape {tile.shape[:2]}"
+            )
+        local_core = (core[0] - wy0, core[1] - wy0, core[2] - wx0, core[3] - wx0)
+        owned = _owned_pixels(mask, local_core, min_size)
+        if owned is None:
+            continue
+        ys, xs, ids = owned
+        uniq, inv = np.unique(ids, return_inverse=True)
+        rows.append((ys + wy0).astype(np.int64))
+        cols.append((xs + wx0).astype(np.int64))
+        vals.append(inv.astype(np.int64) + next_id)
+        next_id += len(uniq)
+
+    if rows:
+        r = np.concatenate(rows)
+        c = np.concatenate(cols)
+        v = np.concatenate(vals)
+        # first writer keeps a contested pixel; np.unique keeps the first index
+        _, first = np.unique(r * W + c, return_index=True)
+        r, c, v = r[first], c[first], v[first]
+        # an object can lose every pixel to an earlier one: renumber densely
+        _, v = np.unique(v, return_inverse=True)
+        v = v.astype(np.int32) + 1
+    else:
+        r = c = np.zeros(0, dtype=np.int64)
+        v = np.zeros(0, dtype=np.int32)
+
+    if sparse:
+        from scipy import sparse as sp
+        return sp.csr_matrix((v, (r, c)), shape=(H, W), dtype=np.int32)
+    out = np.zeros((H, W), dtype=np.int32)
+    out[r, c] = v
+    return out
diff --git a/omicverse/space/seg/_transcripts.py b/omicverse/space/seg/_transcripts.py
new file mode 100644
index 000000000..97348f5c7
--- /dev/null
+++ b/omicverse/space/seg/_transcripts.py
@@ -0,0 +1,410 @@
+r"""Transcripts meet segmentation: assignment, counting, transcript-based methods.
+
+Imaging platforms (Xenium, CosMx, MERFISH/MERSCOPE, STARmap) and Stereo-seq
+GEM files give one row per detected molecule. A label image turns them into
+cells with :func:`assign_transcripts`; :func:`segment_transcripts` instead
+segments from the molecules themselves (Baysor). :func:`aggregate` builds the
+cell x gene AnnData either way.
+"""
+from __future__ import annotations
+
+import importlib.util
+import os
+import shutil
+import subprocess
+import tempfile
+from pathlib import Path
+from typing import Literal, Sequence
+
+import numpy as np
+import pandas as pd
+
+from ..._optional import build_optional_dependency_error
+from ..._registry import register_function
+
+
+def _to_pixels(x, y, *, pixel_size=1.0, offset=(0.0, 0.0), transform=None):
+    """Transcript coordinates -> fractional ``(col, row)`` pixel coordinates."""
+    x = np.asarray(x, dtype=np.float64)
+    y = np.asarray(y, dtype=np.float64)
+    if transform is not None:
+        A = np.asarray(transform, dtype=np.float64)
+        if A.shape != (3, 3):
+            raise ValueError("transform must be a 3x3 affine matrix (x, y, 1) -> (col, row, 1)")
+        col = A[0, 0] * x + A[0, 1] * y + A[0, 2]
+        row = A[1, 0] * x + A[1, 1] * y + A[1, 2]
+        return col, row
+    return (x - offset[0]) / pixel_size, (y - offset[1]) / pixel_size
+
+
+def _from_pixels(col, row, *, pixel_size=1.0, offset=(0.0, 0.0), transform=None):
+    """Inverse of :func:`_to_pixels`."""
+    col = np.asarray(col, dtype=np.float64)
+    row = np.asarray(row, dtype=np.float64)
+    if transform is not None:
+        inv = np.linalg.inv(np.asarray(transform, dtype=np.float64))
+        return (inv[0, 0] * col + inv[0, 1] * row + inv[0, 2],
+                inv[1, 0] * col + inv[1, 1] * row + inv[1, 2])
+    return col * pixel_size + offset[0], row * pixel_size + offset[1]
+
+
+@register_function(
+    aliases=["转录本分配", "assign_transcripts", "transcript assignment", "分子分配到细胞"],
+    category="space",
+    description="Assign each detected transcript (Xenium/CosMx/MERFISH/Stereo-seq molecule table) to the segmented cell whose label covers it.",
+    examples=[
+        "tx['cell'] = ov.space.seg.assign_transcripts(tx, labels, pixel_size=0.2125)",
+        "tx['cell'] = ov.space.seg.assign_transcripts(tx, labels, x='x_location', y='y_location', pixel_size=0.2125)",
+    ],
+    related=["space.seg.segment", "space.seg.aggregate"],
+)
+def assign_transcripts(
+    transcripts: pd.DataFrame,
+    labels,
+    *,
+    x: str = "x",
+    y: str = "y",
+    pixel_size: float = 1.0,
+    offset: Sequence[float] = (0.0, 0.0),
+    transform=None,
+) -> np.ndarray:
+    """Look up the label under every transcript.
+
+    Parameters
+    ----------
+    transcripts
+        One row per molecule with coordinate columns ``x`` and ``y``.
+    labels
+        Integer label image (dense or ``scipy.sparse``), e.g. from
+        :func:`ov.space.seg.segment`.
+    pixel_size, offset
+        Transcript units per image pixel and the transcript coordinate of
+        pixel ``(0, 0)``: ``col = (x - offset[0]) / pixel_size``. Xenium
+        transcripts are in microns on a 0.2125 micron morphology grid.
+    transform
+        3x3 affine ``(x, y, 1) -> (col, row, 1)``; overrides ``pixel_size``
+        and ``offset`` (e.g. a CosMx field-of-view or a registered H&E).
+
+    Returns
+    -------
+    numpy.ndarray
+        ``int64`` label per transcript; 0 = background or outside the image.
+    """
+    col, row = _to_pixels(transcripts[x].to_numpy(), transcripts[y].to_numpy(),
+                          pixel_size=pixel_size, offset=offset, transform=transform)
+    H, W = labels.shape[:2]
+    c = np.floor(col).astype(np.int64)
+    r = np.floor(row).astype(np.int64)
+    inside = (r >= 0) & (r < H) & (c >= 0) & (c < W)
+    out = np.zeros(len(transcripts), dtype=np.int64)
+    if hasattr(labels, "tocsr"):
+        out[inside] = np.asarray(labels.tocsr()[r[inside], c[inside]]).ravel()
+    else:
+        out[inside] = np.asarray(labels)[r[inside], c[inside]]
+    return out
+
+
+def _unassigned(values: pd.Series) -> np.ndarray:
+    """Background markers across tools: 0, -1, NaN, '', 'UNASSIGNED', 'noise'."""
+    if pd.api.types.is_numeric_dtype(values):
+        v = values.to_numpy()
+        return ~np.isfinite(v.astype(float)) | (v <= 0)
+    s = values.astype("string").fillna("")
+    return s.str.strip().str.upper().isin(["", "0", "-1", "UNASSIGNED", "NOISE", "NAN"]).to_numpy()
+
+
+def _polygons_wkt(labels, ids, *, pixel_size, offset, transform, tolerance=0.5) -> list[str]:
+    """WKT outline of each label in ``ids`` in transcript coordinates."""
+    from shapely.geometry import Polygon
+    from skimage.measure import find_contours, regionprops
+
+    dense = labels.toarray() if hasattr(labels, "toarray") else np.asarray(labels)
+    wkt = {}
+    for region in regionprops(dense):
+        mask = np.pad(region.image, 1).astype(np.uint8)
+        contours = find_contours(mask, 0.5)
+        if not contours:
+            continue
+        ring = max(contours, key=len)
+        if len(ring) < 4:
+            continue
+        r0, c0 = region.bbox[0] - 1, region.bbox[1] - 1
+        # pixel (r, c) covers [c, c+1) x [r, r+1): centres sit at +0.5
+        xs, ys = _from_pixels(ring[:, 1] + c0 + 0.5, ring[:, 0] + r0 + 0.5,
+                              pixel_size=pixel_size, offset=offset, transform=transform)
+        poly = Polygon(np.c_[xs, ys]).simplify(tolerance * pixel_size)
+        if not poly.is_valid:
+            poly = poly.buffer(0)
+        wkt[region.label] = poly.wkt
+    return [wkt.get(int(i), "") for i in ids]
+
+
+@register_function(
+    aliases=["转录本聚合", "aggregate", "cell by gene", "细胞表达矩阵", "transcripts_to_adata"],
+    category="space",
+    description="Count transcripts per segmented cell into a cell x gene AnnData with spatial centroids, cell area and WKT polygons ready for ov.pl.spatialseg.",
+    examples=[
+        "tx['cell'] = ov.space.seg.assign_transcripts(tx, labels, pixel_size=0.2125)",
+        "adata = ov.space.seg.aggregate(tx, cell='cell', gene='feature_name', labels=labels, pixel_size=0.2125)",
+        "adata = ov.space.seg.aggregate(baysor_tx, cell='cell', gene='gene')",
+    ],
+    related=["space.seg.assign_transcripts", "space.seg.segment_transcripts", "pl.spatialseg"],
+)
+def aggregate(
+    transcripts: pd.DataFrame,
+    *,
+    cell: str = "cell",
+    gene: str = "gene",
+    x: str = "x",
+    y: str = "y",
+    count: str | None = None,
+    labels=None,
+    pixel_size: float = 1.0,
+    offset: Sequence[float] = (0.0, 0.0),
+    transform=None,
+    geometry: bool | None = None,
+    library_id: str = "seg",
+):
+    """Build a cell x gene count matrix from assigned transcripts.
+
+    Parameters
+    ----------
+    transcripts
+        Molecule table with a cell column (0 / -1 / NaN / '' = unassigned).
+    cell, gene, x, y
+        Column names.
+    count
+        Optional per-row count column (Stereo-seq ``MIDCount``); each row
+        counts once otherwise.
+    labels
+        The label image the ``cell`` ids came from. Adds ``obs['area']``
+        (transcript units squared) and, with ``geometry``,
+        ``obs['geometry']`` WKT polygons for :func:`ov.pl.spatialseg`.
+    pixel_size, offset, transform
+        Same mapping as :func:`assign_transcripts`.
+    geometry
+        Write cell outlines (needs ``shapely``). ``None`` writes them when
+        ``shapely`` is installed; ``True`` requires it.
+    library_id
+        Key under ``uns['spatial']``.
+
+    Returns
+    -------
+    anndata.AnnData
+        Raw counts in ``X`` (CSR), ``obs['n_transcripts']``,
+        ``obs['n_genes']``, transcript centroids in ``obsm['spatial']``.
+    """
+    import anndata as ad
+    from scipy import sparse
+
+    tx = transcripts.loc[~_unassigned(transcripts[cell])]
+    cell_codes, cell_ids = pd.factorize(tx[cell], sort=True)
+    gene_codes, gene_ids = pd.factorize(tx[gene].astype(str), sort=True)
+    w = tx[count].to_numpy(dtype=np.float32) if count else np.ones(len(tx), dtype=np.float32)
+    X = sparse.csr_matrix((w, (cell_codes, gene_codes)),
+                          shape=(len(cell_ids), len(gene_ids)), dtype=np.float32)
+    X.sum_duplicates()
+
+    n = np.bincount(cell_codes, minlength=len(cell_ids)).astype(np.float64)
+    cx = np.bincount(cell_codes, weights=tx[x].to_numpy(dtype=np.float64), minlength=len(cell_ids)) / n
+    cy = np.bincount(cell_codes, weights=tx[y].to_numpy(dtype=np.float64), minlength=len(cell_ids)) / n
+
+    obs = pd.DataFrame(index=pd.Index(cell_ids.astype(str), name="cell_id"))
+    obs["n_transcripts"] = np.asarray(X.sum(axis=1)).ravel()
+    obs["n_genes"] = np.diff(X.indptr)
+    adata = ad.AnnData(X=X, obs=obs, var=pd.DataFrame(index=pd.Index(gene_ids, name="gene")))
+    adata.obsm["spatial"] = np.c_[cx, cy]
+
+    if labels is not None:
+        ids = np.asarray(cell_ids)
+        if not np.issubdtype(ids.dtype, np.integer):
+            raise ValueError("`labels` was given but the cell ids are not integer label ids")
+        flat = labels.data if hasattr(labels, "tocsr") else np.asarray(labels).ravel()
+        area_px = np.bincount(np.asarray(flat, dtype=np.int64), minlength=int(ids.max()) + 1)
+        scale = abs(np.linalg.det(np.linalg.inv(np.asarray(transform, dtype=float))[:2, :2])) \
+            if transform is not None else pixel_size ** 2
+        adata.obs["area"] = area_px[ids] * scale
+        if geometry is None:
+            geometry = importlib.util.find_spec("shapely") is not None
+        if geometry:
+            try:
+                import shapely  # noqa: F401
+            except ImportError as exc:
+                raise build_optional_dependency_error(
+                    "ov.space.seg.aggregate(geometry=True)", ("shapely",),
+                    install_hint="Install with `pip install shapely` or pass geometry=False.",
+                ) from exc
+            adata.obs["geometry"] = _polygons_wkt(labels, ids, pixel_size=pixel_size,
+                                                  offset=offset, transform=transform)
+    diam = 2 * np.sqrt(np.nanmedian(adata.obs["area"]) / np.pi) if "area" in adata.obs and adata.n_obs else 10.0
+    adata.uns["spatial"] = {library_id: {
+        "images": {},
+        "scalefactors": {"tissue_hires_scalef": 1.0, "spot_diameter_fullres": float(diam)},
+    }}
+    return adata
+
+
+# ---------------------------------------------------------------------------
+# transcript-based segmentation
+# ---------------------------------------------------------------------------
+def _baysor_command(executable: str | Sequence[str]) -> list[str]:
+    if isinstance(executable, (list, tuple)):
+        return list(executable)
+    found = shutil.which(executable)
+    if found is None:
+        raise FileNotFoundError(
+            f"Baysor executable {executable!r} was not found on PATH. Install Baysor "
+            "(https://kharchenkolab.github.io/Baysor/ — a prebuilt Linux binary or "
+            "`julia -e 'using Pkg; Pkg.add(\"Baysor\")'`) or pass executable='/path/to/baysor'."
+        )
+    return [found]
+
+
+def _run_baysor(tx, *, x, y, z, gene, prior, prior_confidence, scale, scale_std,
+                min_molecules_per_cell, n_clusters, config, executable, extra_args,
+                workdir, verbose):
+    cols = [c for c in (x, y, z, gene, prior) if c is not None]
+    tmp = None
+    if workdir is None:
+        tmp = tempfile.mkdtemp(prefix="ov_baysor_")
+        workdir = tmp
+    workdir = Path(workdir)
+    workdir.mkdir(parents=True, exist_ok=True)
+    try:
+        inp = workdir / "molecules.csv"
+        out = workdir / "segmentation.csv"
+        frame = tx[cols].copy()
+        if prior is not None:
+            frame[prior] = np.where(_unassigned(frame[prior]), 0, pd.factorize(frame[prior])[0] + 1)
+        frame.to_csv(inp, index=False)
+
+        cmd = _baysor_command(executable) + ["run", "-x", x, "-y", y, "-g", gene,
+                                             "-m", str(int(min_molecules_per_cell)),
+                                             "-o", str(out)]
+        if z is not None:
+            cmd += ["-z", z]
+        if scale is not None:
+            cmd += ["-s", str(scale)]
+        if scale_std is not None:
+            cmd += ["--scale-std", str(scale_std)]
+        if n_clusters is not None:
+            cmd += ["--n-clusters", str(int(n_clusters))]
+        if config is not None:
+            cmd += ["-c", str(config)]
+        if prior is not None:
+            cmd += ["--prior-segmentation-confidence", str(prior_confidence)]
+        cmd += list(extra_args or ())
+        cmd += [str(inp)]
+        if prior is not None:
+            cmd += [f":{prior}"]
+
+        proc = subprocess.run(cmd, cwd=str(workdir), capture_output=not verbose, text=True)
+        if proc.returncode != 0:
+            tail = (proc.stderr or proc.stdout or "")[-2000:] if not verbose else ""
+            raise RuntimeError(f"Baysor failed (exit {proc.returncode}): {' '.join(cmd)}\n{tail}")
+        if not out.exists():
+            raise RuntimeError(f"Baysor finished but wrote no {out}")
+        return pd.read_csv(out)
+    finally:
+        if tmp is not None:
+            shutil.rmtree(tmp, ignore_errors=True)
+
+
+@register_function(
+    aliases=["转录本分割", "segment_transcripts", "baysor", "基于转录本的细胞分割", "无图像分割"],
+    category="space",
+    description="Segment cells from the transcript table itself with Baysor (optionally using an image segmentation as a prior); returns the molecules with a cell column.",
+    examples=[
+        "tx = ov.space.seg.segment_transcripts(tx, method='baysor', gene='feature_name', scale=8)",
+        "tx['nucleus'] = ov.space.seg.assign_transcripts(tx, nuclei, pixel_size=0.2125)",
+        "tx = ov.space.seg.segment_transcripts(tx, method='baysor', prior='nucleus', prior_confidence=0.5)",
+    ],
+    related=["space.seg.aggregate", "space.seg.assign_transcripts", "space.seg.segment"],
+)
+def segment_transcripts(
+    transcripts: pd.DataFrame,
+    method: Literal["baysor"] = "baysor",
+    *,
+    x: str = "x",
+    y: str = "y",
+    z: str | None = None,
+    gene: str = "gene",
+    prior: str | None = None,
+    prior_confidence: float = 0.2,
+    scale: float | None = None,
+    scale_std: str | float | None = "25%",
+    min_molecules_per_cell: int = 30,
+    n_clusters: int | None = None,
+    config: str | None = None,
+    executable: str | Sequence[str] = "baysor",
+    extra_args: Sequence[str] = (),
+    workdir: str | os.PathLike | None = None,
+    key_added: str = "cell",
+    verbose: bool = False,
+) -> pd.DataFrame:
+    """Segment cells from molecule positions and gene identities.
+
+    Baysor (Petukhov et al., Nat. Biotechnol. 2022) fits a Markov random field
+    mixture of cells over the molecules; it needs no image, and can refine an
+    image segmentation given as a ``prior`` column. In the Nature Methods 2026
+    benchmark it ranked among the best for coverage-adjusted performance.
+
+    Parameters
+    ----------
+    transcripts
+        One row per molecule.
+    method
+        ``'baysor'``.
+    x, y, z, gene
+        Column names (``z`` optional).
+    prior
+        Column with prior cell ids per molecule (0 / NaN = none), e.g. from
+        :func:`assign_transcripts` on a nucleus segmentation.
+    prior_confidence
+        Baysor ``--prior-segmentation-confidence`` (0-1).
+    scale, scale_std
+        Expected cell radius in transcript units and its allowed spread.
+        Baysor estimates ``scale`` when it is ``None`` and a prior is given.
+    min_molecules_per_cell, n_clusters, config
+        Baysor ``-m``, ``--n-clusters``, ``-c config.toml``.
+    executable
+        Baysor binary name/path, or a command list such as
+        ``['julia', '--project=env', '-e', 'using Baysor; Baysor.command_main()', '--']``.
+    extra_args
+        Additional CLI arguments.
+    workdir
+        Keep Baysor's inputs and outputs here (a temporary directory otherwise).
+    key_added
+        Name of the output cell column.
+
+    Returns
+    -------
+    pandas.DataFrame
+        Copy of ``transcripts`` with ``key_added`` (int, 0 = unassigned or
+        noise), ``f'{key_added}_confidence'`` and ``'is_noise'``.
+    """
+    if method != "baysor":
+        raise ValueError(f"Unknown transcript method {method!r}; available: 'baysor'")
+    if scale is None and prior is None:
+        raise ValueError("Baysor needs `scale` (expected cell radius) unless a `prior` is given")
+    seg = _run_baysor(transcripts, x=x, y=y, z=z, gene=gene, prior=prior,
+                      prior_confidence=prior_confidence, scale=scale, scale_std=scale_std,
+                      min_molecules_per_cell=min_molecules_per_cell, n_clusters=n_clusters,
+                      config=config, executable=executable, extra_args=extra_args,
+                      workdir=workdir, verbose=verbose)
+    if len(seg) != len(transcripts):
+        if "molecule_id" not in seg.columns:
+            raise RuntimeError(f"Baysor returned {len(seg)} rows for {len(transcripts)} molecules")
+        seg = seg.set_index("molecule_id").reindex(np.arange(1, len(transcripts) + 1)).reset_index()
+    noise = (seg["is_noise"].astype(str).str.lower() == "true").to_numpy() \
+        if "is_noise" in seg.columns else np.zeros(len(seg), dtype=bool)
+    unassigned = _unassigned(seg["cell"]) | noise
+    codes = pd.factorize(seg["cell"].where(~unassigned))[0].astype(np.int64) + 1
+    codes[unassigned] = 0
+
+    out = transcripts.copy()
+    out[key_added] = codes
+    if "assignment_confidence" in seg.columns:
+        out[f"{key_added}_confidence"] = seg["assignment_confidence"].to_numpy()
+    out["is_noise"] = noise
+    return out
