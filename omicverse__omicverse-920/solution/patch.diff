+    def test_retrofitted_matches_the_anndata_path(self, cells):
+        anndata = pytest.importorskip("anndata")
+        from omicverse.pl import cellstackarea
+
+        adata = anndata.AnnData(np.zeros((len(cells), 1), dtype=np.float32),
