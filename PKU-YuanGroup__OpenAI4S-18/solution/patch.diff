+        funcs["default_config"](),
+        truth=truth,
+        evaluation=evaluation,
+        include_figures=False,
+    )
+    assert "与真值对比（循环结束后一次性评估）" in report
+    assert "循环过程中未使用" in report
+    assert "Precision/Recall/F1" in report
