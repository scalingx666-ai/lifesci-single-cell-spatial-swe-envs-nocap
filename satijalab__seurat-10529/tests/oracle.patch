diff --git a/R/dimensional_reduction.R b/R/dimensional_reduction.R
index e25a08c30..97ffbcba8 100644
--- a/R/dimensional_reduction.R
+++ b/R/dimensional_reduction.R
@@ -121,13 +121,9 @@ JackStraw <- function(
   jackStraw.empP <- as.matrix(
     my.sapply(
       X = 1:dims,
-      FUN = function(x) {
-        return(unlist(x = lapply(
-          X = abs(loadings[, x]),
-          FUN = EmpiricalP,
-          nullval = abs(fake.vals[,x])
-        )))
-      }
+      FUN = JackStrawP,
+      loadings = loadings,
+      fake.vals = fake.vals
     )
   )
   colnames(x = jackStraw.empP) <- paste0("PC", 1:ncol(x = jackStraw.empP))
@@ -2244,6 +2240,16 @@ EmpiricalP <- function(x, nullval) {
   return(sum(nullval > x) / length(x = nullval))
 }
 
+#internal
+#
+JackStrawP <- function(x, loadings, fake.vals) {
+  return(unlist(x = lapply(
+    X = abs(loadings[, x]),
+    FUN = EmpiricalP,
+    nullval = abs(fake.vals[, x])
+  )))
+}
