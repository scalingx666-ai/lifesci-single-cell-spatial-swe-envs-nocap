 # FIt-SNE helper function for calling fast_tsne from R
 #
 # Based on Kluger Lab FIt-SNE v1.2.1 code on https://github.com/KlugerLab/FIt-SNE/blob/master/fast_tsne.R
diff --git a/tests/testthat/test_dimensional_reduction.R b/tests/testthat/test_dimensional_reduction.R
index 08a479fbe..009bc3f91 100644
--- a/tests/testthat/test_dimensional_reduction.R
+++ b/tests/testthat/test_dimensional_reduction.R
@@ -302,3 +302,15 @@ test_that("`RunPCA` works as expected", {
     npcs = 10
   )
 })
+
+context("JackStraw")
+
+test_that("`JackStraw` runs and computes empirical p-values", {
+  data("pbmc_small")
+  res <- suppressWarnings(JackStraw(pbmc_small, dims = 2, num.replicate = 5, verbose = FALSE))
+  pvals <- JS(object = res[["pca"]], slot = "empirical")
+  expect_true(is.matrix(pvals))
+  expect_equal(ncol(pvals), 2)
+  expect_true(all(pvals >= 0 & pvals <= 1))
+})
