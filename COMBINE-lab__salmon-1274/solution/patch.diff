+        std::fs::write(out.join(REFSEQ_FILE), b"").unwrap();
+        let err = SalmonIndex::load(&out)
+            .err()
+            .expect("must refuse")
+            .to_string();
+        assert!(err.contains("damaged"), "{err}");
+    }
