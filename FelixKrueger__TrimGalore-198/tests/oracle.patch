+sub demultiplex{
+
+    my ($output_dir,$trimmed_filename,$barcode_file) = @_;
+
+    my %barcodes = read_barcode_file($barcode_file);
+    my %barcode_fhs = open_barcode_filehandles($output_dir,$trimmed_filename,%barcodes); 
+
+    # Keep track of barcode counts    
+    my %barcode_counts;
+    # Setting barcode length
+    my $barcode_length = length((keys %barcodes)[0]);
+
+    foreach my $barcode (keys %barcodes){
+        $barcode_counts{$barcode} = 0;
+    }
+
+    my $best_match = 0;
+    my $count = 0;
+
+    # Reading trimmed file
+    open (my $in,"$decompression_path -d -c $output_dir$trimmed_filename |") or die "Couldn't read from file $!";
+    while (<$in>){
+        my $identifier = $_;
+        my $sequence = <$in>;
+        my $identifier2 = <$in>;
+        my $quality_score = <$in>;
+
+        last unless ($identifier and $sequence and $identifier2 and $quality_score);
+        $count++;
+
+        if ($count%10000000 == 0){
+            warn "$count sequences processed\n";
+        }
+        # warn "$identifier$sequence$identifier2$quality_score========\n";
+        chomp $sequence;
+        chomp $quality_score;
+        chomp $identifier;
+    
+        # warn "BEFORE: $identifier\n$sequence\n$quality_score\n";
+                   
+        # extracting the potential barcode sequence and shorten the read sequence and quality score
+        my $barcode_seq = substr($sequence,-$barcode_length,$barcode_length,"");
+        substr($quality_score,-$barcode_length,$barcode_length,"");
+
+        # Modifying readID to include barcode sequence
+        $identifier =~ s/\s+/_/g; # removing white spaces from readID
+        $identifier .= "_BC:$barcode_seq";
+
+        # warn "Barcode sequence: $barcode_seq\n";
+        # warn "AFTER : $identifier\n$sequence\n$quality_score\n     ====\n";
+        # sleep(1);
+
+        foreach my $bc (keys %barcodes){
+            if ($barcode_seq eq $bc){
+                $best_match = $bc;
+                # warn "$identifier\n$sequence\n$identifier2$quality_score\n";
+                print {$barcode_fhs{$bc}} "$identifier\n$sequence\n$identifier2$quality_score\n";
+                ++$barcode_counts{$bc};
+                last;
+            }  
+        }
+        if ($best_match eq 0){
+            print {$barcode_fhs{'NoCode'}} "$identifier\n$sequence\n$identifier2$quality_score\n";
+            ++$barcode_counts{'NoCode'};
+        }
+    }
+    
+    warn "Processed sequences from file >$trimmed_filename< in total: $count\n";
+    # Print summary of barcode counts
+    warn "\nDemultiplexing summary\n======================\n";
+    foreach my $barcode (sort {$barcode_counts{$b} <=> $barcode_counts{$a} } keys %barcode_counts){
+        warn "$barcode\t$barcode_counts{$barcode}\n";
+    }
+    warn "======================\n      ¯\\_(ツ)_/¯\n\nDemultiplexing complete. Enjoy!\n\n";
+}
+
+sub open_barcode_filehandles {
+    
+    my ($output_dir,$trimmed_filename,%barcodes) = @_;
+    
+    my %barcode_fhs;
+    my $new_basename = $trimmed_filename;
+    $new_basename =~ s/\.gz$//;
+    $new_basename =~ s/\.fq$//;
+
+    foreach my $barcode (keys %barcodes){
+        # warn "Barcode is '$barcode' and sample is '$barcodes{$barcode}'\n";
+        my $output_filename = "${new_basename}_$barcodes{$barcode}.fq";
+        # warn "Output file name: $output_filename\n";
+        if ($gzip){
+            $output_filename .= '.gz';
+            open ($barcode_fhs{$barcode},"| $compression_path -c - > ${output_dir}${output_filename}") or die "Can't open >$output_filename<: $!\n";
+        }   
+        else{
+            open ($barcode_fhs{$barcode},'>',"$output_dir$output_filename") or die "Can't open >$output_filename<: $!\n";
+        }
+    }   
+    return  %barcode_fhs;
+}
+
+sub read_barcode_file {
+    my $barcode_file = shift;
+    my %barcodes;
+    open (my $barcodes,'<',$barcode_file) or die "Couldn't open barcode file $barcode_file: $!\n";
+    while (<$barcodes>){
+        chomp;
+        my ($sample,$barcode) = split (/\t/);
+        $barcodes{$barcode} = $sample;
+    }
+    # Add entry for 'NoCode' barcode
+    $barcodes{'NoCode'} = 'NoCode';
+
+    # foreach my $barcode (keys %barcodes){
+    #     warn "Barcode: $barcode\tSample: $barcodes{$barcode}\n";
+    # }
+
+    close $barcodes or die "Couldn't close barcode file $barcode_file: $!\n";
+    return %barcodes;
+}
