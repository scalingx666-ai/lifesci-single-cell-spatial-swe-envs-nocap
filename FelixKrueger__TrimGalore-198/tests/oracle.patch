+sub test_demux_file{
+    my $demux = shift;
+    open (DEMUX,$demux) or die "Failed to open demultiplexing file $demux: $!\n";
+   
+    while (my $line = <DEMUX>){
+        chomp $line;
+        
+        unless ($line =~ /\t/){
+            die "Demultiplexing file $demux does not seem to be in the correct format. Please make sure it is in the format: >barcode_name<\t>barcode_sequence<\n";
+        }
+
+        my ($description,$barcode) = split(/\t/,$line);
+        warn "Testing:\t$description\t$barcode\n";
+        # Making sure the barcode is DNA letters only
+        unless ($barcode =~ /^[ACTGN]+$/){
+            warn "Barcode sequence in $demux must contain DNA characters only (A,C,T,G or N)!\n";
+            die "This was the current line:\t$description\t$barcode\n";
+        }
+    }
+    warn "Demultiplexing file $demux seems to be in the correct format. Proceeding...\n";
+    close DEMUX;
+} 
