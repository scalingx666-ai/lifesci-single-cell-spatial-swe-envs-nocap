+    "    fig, ax = plt.subplots(figsize=figsize or (8.5, 5))\n",
+    "    ax.scatter(x, y, s=8, c=\"0.55\", linewidths=0, zorder=2)\n",
+    "    ax.axhline(0, color=\"k\", lw=.7, ls=\"--\", zorder=1)\n",
+    "    for i, color, is_top in ((x[:k], C_TOP, True), (x[len(x) - k:], C_BOT, False)):\n",
