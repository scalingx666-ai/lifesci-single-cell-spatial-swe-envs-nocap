+
+    if (Param %in% HiddenGeneParams()) {
+      Column <- Gene
+    } else if (Param %in% HiddenCellParams()) {
+      Column <- Cell
+    } else if (Param == "theta") {
+      Column <- Batch
+    } else if (Param == "beta") {
+      Column <- RegressionTerm
+    }
+    if (xlab == "") {
+      xlab <- "Iteration"
+    }
+    if (ylab == "") {
