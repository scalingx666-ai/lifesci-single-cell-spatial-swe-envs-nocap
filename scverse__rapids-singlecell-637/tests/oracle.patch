+def test_mixture_model_skip_low_count() -> None:
+    """Guides with < 2 expressing cells should be skipped with a warning."""
+    X = np.zeros((50, 3), dtype=np.float32)
+    # guide 0: only 1 cell expressing
+    X[0, 0] = 10.0
+    # guide 1: no cells expressing
