+   "cell_type": "code",
+   "execution_count": 3,
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "sc.settings.set_figure_params(dpi=200, frameon=False)\n",
+    "sc.set_figure_params(dpi=200)\n",
+    "sc.set_figure_params(figsize=(4, 4))"
