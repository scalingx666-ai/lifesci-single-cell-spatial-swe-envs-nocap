+     "text": [
+      "... storing 'batch' as categorical\n",
+      "... storing 'study' as categorical\n",
+      "... storing 'cell_type' as categorical\n"
+     ]
+    },
+    {
+     "data": {
+      "image/png": "\n",
+      "text/plain": [
+       "<Figure size 1024x320 with 2 Axes>"
+      ]
+     },
+     "metadata": {},
+     "output_type": "display_data"
+    }
+   ],
+   "source": [
+    "sc.pp.neighbors(integrated_query, use_rep=\"latent_corrected\")\n",
+    "sc.tl.umap(integrated_query)\n",
+    "sc.pl.umap(\n",
+    "    integrated_query,\n",
+    "    color=[\"study\", \"cell_type\"],\n",
+    "    frameon=False,\n",
+    "    wspace=0.6)"
