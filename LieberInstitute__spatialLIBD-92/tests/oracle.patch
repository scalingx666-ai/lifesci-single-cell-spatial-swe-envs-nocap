+        }
+        
+        ## check for Non-Syntactic variables - convert with make.names & warn
         uniq_var_regis <- unique(sce[[var_registration]])
-        if (any(grepl("\\+|\\-", uniq_var_regis))) {
-            stop(
-                "Remove the + and - signs in colData(sce)[, '",
