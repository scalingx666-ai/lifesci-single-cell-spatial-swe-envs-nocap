diff --git a/man/RunCellOracle.Rd b/man/RunCellOracle.Rd
new file mode 100644
index 000000000..2b759755c
--- /dev/null
+++ b/man/RunCellOracle.Rd
@@ -0,0 +1,162 @@
+% Generated by roxygen2: do not edit by hand
+% Please edit documentation in R/RunCellOracle.R
+\name{RunCellOracle}
+\alias{RunCellOracle}
+\title{Run official CellOracle perturbation analysis}
+\usage{
+RunCellOracle(
+  object,
+  perturbation,
+  group.by,
+  base_grn = NULL,
+  assay = "RNA",
+  layer = "counts",
+  features = NULL,
+  reduction = NULL,
+  stage_args = list(),
+  model_dir = NULL,
+  output_dir = NULL,
+  store_expression = FALSE,
+  tool_name = "CellOracle",
+  envname = "celloracle_env",
+  conda = "auto",
+  docker_container = NULL,
+  cores = 1L,
+  seed = 1234L,
+  verbose = TRUE
+)
+}
+\arguments{
+\item{object}{A Seurat object with non-log RNA counts, clusters and a two-dimensional
+embedding. Perform cell/gene selection before calling this function.}
+
+\item{perturbation}{Named numeric vector of non-negative expression values.
+Zero simulates knockout. Multiple genes specify one joint perturbation.}
+
+\item{group.by}{Metadata column defining the clusters used for GRN fitting.}
+
+\item{base_grn}{Official TF-info data.frame with \code{peak_id}, \code{gene_short_name}
+and TF columns, a path to its parquet file, or a named list mapping target
+genes to character vectors of candidate TFs (the official \code{TFdict} format).
+Required for a new fit; do not pass SCOP \code{TF/target/importance} edge tables.
+No expression-derived GRN is generated automatically.}
+
+\item{assay}{Assay containing raw counts. Default is \code{"RNA"}.}
+
+\item{layer}{Non-log count layer. Default is \code{"counts"}. Fractional counts are
+accepted, matching the official raw-count import (including the official demo
+input). Log-transformed, scaled, integrated and SCT residual data should not
+be supplied; their provenance cannot be inferred from numeric values alone.}
+
+\item{features}{Genes to retain, in the requested order. \code{NULL} uses all genes
+in the assay. CellOracle recommends selecting approximately 1,000--3,000 genes
+before import; this wrapper does not silently select or normalize genes.}
+
+\item{reduction}{Reduction containing the two-dimensional embedding. \code{NULL}
+uses \code{\link[=DefaultReduction]{DefaultReduction()}}. The first two columns are used without recomputing.}
+
+\item{stage_args}{Named list of named argument lists for official methods:
+\code{pca} (\code{perform_PCA}), \code{imputation} (\code{knn_imputation}), \code{links} (\code{get_links}),
+\code{filter} (\code{filter_links}), \code{fit} (\code{fit_GRN_for_simulation}), \code{simulation}
+(\code{simulate_shift}), \code{transition} (\code{estimate_transition_prob}), \code{embedding}
+(\code{calculate_embedding_shift}), \code{grid} (\code{calculate_p_mass}), and \code{mass_filter}
+(\code{calculate_mass_filter}). Unspecified arguments retain upstream defaults.
+SCOP controls the perturbation, cluster-specific fitting, randomization
+reference, worker arguments and seed. In CellOracle 0.20.0,
+\code{calculate_p_mass} internally fixes \code{smooth=0.8} and \code{n_jobs=-1}; the wrapper
+preserves that upstream behavior. Do not supply these two ineffective grid
+arguments. For small inputs explicitly choose suitable \code{k}, \code{n_pca_dims},
+transition \code{n_neighbors} and grid \code{n_neighbors}; no silent clipping occurs.}
+
+\item{model_dir}{Directory containing \code{model.celloracle.oracle} and
+\code{network.celloracle.links} saved by a previous run. Reuse requires identical
+cells, genes, raw counts, cluster labels and embedding. Supply \code{base_grn=NULL}
+and no fitting-stage arguments when reusing a model.}
+
+\item{output_dir}{Optional new directory for official Oracle and Links HDF5
+files. Existing directories are never overwritten. These files retain the
+full model and allow subsequent perturbations without refitting.}
+
+\item{store_expression}{Store cell-by-gene \code{imputed_count}, \code{simulated_count}
+and \code{delta_X} matrices in the returned object. Default \code{FALSE} limits size.}
+
+\item{tool_name}{Unused name for the result in \code{object@tools}. Existing entries
+are rejected; use a different name for another perturbation.}
+
+\item{envname}{Isolated environment prepared with
+\code{PrepareEnv(modules = "celloracle")}. Default \code{"celloracle_env"}.}
+
+\item{conda}{Conda-compatible executable, passed to \code{\link[=PrepareEnv]{PrepareEnv()}}.}
+
+\item{docker_container}{Optional name or ID of an already running Linux Docker
+container whose \code{python} has CellOracle 0.20.0 installed. This allows Windows R
+to use the same official runner without a local Python installation. SCOP
+transfers inputs/results through a temporary directory; \code{envname} and \code{conda}
+are unused. Model directories always refer to the R host. The function does
+not pull images, install packages or start containers.}
+
+\item{cores}{Positive worker count for official methods that honor it. The
+official grid routine may use all cores; see \code{stage_args}.}
+
+\item{seed}{Non-negative integer seed. NumPy and standard Python RNG states
+are restored on exit; the upstream transition routine also seeds Numba.
+Docker launches its child with \code{PYTHONHASHSEED=seed} to make upstream
+set-derived predictor ordering reproducible across processes. Local Python
+inherits its interpreter's hash seed; separate reference runs must use the
+same hash seed to compare bagging coefficients exactly.}
+
+\item{verbose}{Whether to display SCOP progress messages. Upstream diagnostic
+output and warnings remain visible. Docker output is also retained in the
+result's \code{diagnostics} character vector.}
+}
+\value{
+A Seurat object with \code{object@tools[[tool_name]]} containing \code{cell_shift}
+(one row per input cell, with original coordinates, displacement and randomized
+displacement), \code{grid_flow} (official grid vectors, mass and exclusion mask),
+\code{gene_effect} (mean signed and mean absolute \code{delta_X} across cells), \code{links}
+and \code{filtered_links} (upstream edge tables per cluster), \code{parameters}, \code{cells},
+\code{genes}, and optionally \code{expression} and \code{model_dir}. Expression matrices have
+input cell and selected gene dimnames. No live Python object is stored.
+}
+\description{
+Fit cluster-specific regulatory models and simulate gene perturbations using
+the unmodified CellOracle 0.20.0 Python implementation.
+}
+\details{
+Requires official \verb{celloracle==0.20.0}, either in a Linux/macOS Python
+environment or in \code{docker_container}. Native Windows Python is not supported.
+Prepare the environment or container explicitly before analysis.
+The raw import performs CellOracle's own log transformation; no additional
+library-size normalization is introduced. PCA, imputation, network inference,
+edge filtering, coefficient fitting, simulation and projection all run in
+CellOracle. Network edge p-values are not perturbation-effect p-values.
+Results are predictions, not experimental knockout measurements.
+}
+\examples{
+\dontrun{
+# On Linux/macOS; prepare dependencies explicitly before analysis.
+PrepareEnv(modules = "celloracle")
+# On Windows use docker_container = "celloracle" with an already prepared,
+# running Linux container instead of preparing local Python.
+data(pancreas_sub)
+pancreas_sub <- RunStandardWorkflow(pancreas_sub)
+# Supply an official TF-info parquet prepared for the matching species.
+pancreas_sub <- RunCellOracle(
+  pancreas_sub, perturbation = c(Pdx1 = 0), group.by = "CellType",
+  base_grn = "mouse_promoter_base_GRN.parquet",
+  stage_args = list(
+    imputation = list(k = 20L, n_pca_dims = 20L),
+    transition = list(n_neighbors = 50L),
+    grid = list(n_neighbors = 50L)
+  )
+)
+CellOraclePlot(pancreas_sub, plot_type = "quiver")
+}
+}
+\references{
+Kamimoto et al. (2023). Dissecting cell identity via network
+inference and in silico gene perturbation. Nature. \doi{10.1038/s41586-022-05688-9}.
+}
+\seealso{
+\code{\link[=CellOraclePlot]{CellOraclePlot()}}, \code{\link[=PrepareEnv]{PrepareEnv()}}
+}
