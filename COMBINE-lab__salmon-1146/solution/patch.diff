+        std::fs::write(&bystander, b"x").unwrap();
+
+        cleanup_intermediate_rad(&rad);
+        assert!(!rad.exists());
+        assert!(!partial.exists());
+        assert!(bystander.exists());
+
+        // Idempotent on an already-clean directory.
+        cleanup_intermediate_rad(&rad);
+    }
 }
