+int hexamerToInt(const char *s, bool revcomp) {
+  int hex = 0;
+  if (!revcomp) {
+    for (int i = 0; i < 6; i++) {
+      hex <<= 2;
+      switch (*(s+i) & 0xDF) {
+      case 'A': break;
+      case 'C': hex += 1; break;
+      case 'G': hex += 2; break;
+      case 'T': hex += 3; break;
+      default: return -1;
+      }    
+    }
+  } else {
+    for (int i = 0; i < 6; i++) {
+      switch (*(s+i) & 0xDF) {
+      case 'A': hex += 3 << (2*i);break;
+      case 'C': hex += 2 << (2*i); break;
+      case 'G': hex += 1 << (2*i); break;
+      case 'T': break;
+      default: return -1;
+      }    
+    }
+  }
+  return hex;
+}
