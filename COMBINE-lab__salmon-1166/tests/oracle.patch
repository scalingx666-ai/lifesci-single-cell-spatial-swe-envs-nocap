+    );
+
+    let from_rad = dir.path().join("rad");
+    assert!(Command::new(SALMON)
+        .args(["quant", "--rad"])
+        .arg(&rad)
+        .args(["-l", "IU", "-o"])
+        .arg(&from_rad)
+        .status()
+        .unwrap()
+        .success());
+    assert_eq!(
+        meta(&from_rad)["frag_length_source"],
+        "rad_baked",
