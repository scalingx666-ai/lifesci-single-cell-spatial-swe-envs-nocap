+    let out = dir.path().join("q");
+    assert!(Command::new(SALMON)
+        .args(["quant", "-i"])
+        .arg(&index)
+        .args(["-l", "IU", "-1"])
+        .arg(&r1)
+        .arg("-2")
+        .arg(&r2)
+        .args(["-p", "2", "-o"])
+        .arg(&out)
+        .status()
+        .unwrap()
+        .success());
+    let m = meta(&out);
+    assert_eq!(m["num_valid_targets"], 2, "txA + txB");
+    assert_eq!(
+        m["num_decoy_targets"], 1,
+        "decoy1 must be counted, not zeroed"
