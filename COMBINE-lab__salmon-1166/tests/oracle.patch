+/// `num_decoy_targets` was hardcoded 0 while `num_decoy_fragments` beside it was
+/// real — self-contradictory, with `meta_info_complete: true`.
+#[test]
+fn decoy_targets_are_counted() {
+    let dir = tempfile::tempdir().unwrap();
