diff --git a/docs/release-notes/4401.fix.md b/docs/release-notes/4401.fix.md
new file mode 100644
index 0000000000..9a6e595499
--- /dev/null
+++ b/docs/release-notes/4401.fix.md
@@ -0,0 +1 @@
+Fix {func}`~scanpy.tl.ingest` truncating to the hardcoded default `settings.N_PCS` instead of the number of PCs that `pp.neighbors` actually used, whenever a reference dataset's `neighbors` params recorded neither `use_rep` nor `n_pcs` {smaller}`Siddhardha Nanda`
diff --git a/src/scanpy/tools/_ingest.py b/src/scanpy/tools/_ingest.py
index c80f9cc2f1..f8bb24d5e3 100644
--- a/src/scanpy/tools/_ingest.py
+++ b/src/scanpy/tools/_ingest.py
@@ -298,8 +298,15 @@ def _init_neighbors(self, adata: AnnData, neighbors_key: str | None) -> None:
             self._n_pcs = neighbors["params"]["n_pcs"]
             self._rep = adata.obsm["X_pca"][:, : self._n_pcs]
         elif adata.n_vars > settings.N_PCS and "X_pca" in adata.obsm:
+            # Neither `use_rep` nor `n_pcs` was recorded, meaning `pp.neighbors`
+            # ran with its own `n_pcs=None` default, which uses the full stored
+            # PCA representation unsliced (see `_get_pca_or_small_x`). Slicing
+            # to `settings.N_PCS` here would silently use a different, smaller
+            # representation than the one that actually produced this
+            # neighbor graph whenever more than `settings.N_PCS` components
+            # were computed.
             self._use_rep = "X_pca"
-            self._rep = adata.obsm["X_pca"][:, : settings.N_PCS]
+            self._rep = adata.obsm["X_pca"]
             self._n_pcs = self._rep.shape[1]
 
         self._metric_kwds = neighbors["params"].get("metric_kwds", {})
