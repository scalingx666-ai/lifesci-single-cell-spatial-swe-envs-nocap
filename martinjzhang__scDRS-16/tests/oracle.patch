+                    opt,
+                    axis_,
+                    np.absolute(v_mean - v_mean_true).mean(),
+                    np.absolute(v_var - v_var_true).mean(),
+                )
+            )
+            assert np.allclose(
+                v_mean, v_mean_true, rtol=1e-4, equal_nan=True
+            ) & np.allclose(v_var, v_var_true, rtol=1e-4, equal_nan=True), err_msg
