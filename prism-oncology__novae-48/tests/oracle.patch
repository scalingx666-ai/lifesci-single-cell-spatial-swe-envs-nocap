+       "L2                            Ductal Tumor Region              0.89\n",
+       "L0                        Acinar Cell Compartment              0.98\n",
+       "L4                       Transitional Ductal Zone              0.88\n",
+       "L7                          Endocrine Islet Niche              0.98"
+      ]
