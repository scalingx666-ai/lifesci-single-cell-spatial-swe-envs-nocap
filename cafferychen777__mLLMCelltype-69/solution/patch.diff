+def _posted_body(mock_post: MagicMock) -> dict:
+    """Decode the JSON body actually sent to requests.post (data= or json=)."""
+    kwargs = mock_post.call_args.kwargs
+    if "json" in kwargs:
+        return kwargs["json"]
+    return json.loads(kwargs["data"])
