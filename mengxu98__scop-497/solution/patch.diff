+% Generated by roxygen2: do not edit by hand
+% Please edit documentation in R/ReadATACData.R
+\name{ReadATACData}
+\alias{ReadATACData}
+\title{Read raw ATAC counts into a ChromatinAssay}
+\usage{
+ReadATACData(
+  object,
+  ranges = NULL,
+  metadata = NULL,
+  peaks.file = NULL,
+  barcodes.file = NULL,
+  cell.names = NULL,
+  sample = NULL,
+  genome = NULL,
+  annotation = NULL,
+  fragments = NULL,
+  fragment.cells = NULL,
+  assay = "peaks",
+  project = "ATAC",
+  verbose = TRUE
+)
+}
+\arguments{
+\item{object}{A numeric sparse peak-by-cell matrix, a local 10x ATAC/ARC
+H5 path, or a local Matrix Market path. Separate matrices with different peak
+universes must be recounted before combining; this function never fills
+unmeasured peaks with zeros.
+The supported Signac constructor requires at least two cells and two peaks.}
+
+\item{ranges}{A \code{GRanges} in 1-based closed coordinates, required with
+a sparse matrix. Named ranges are aligned to the matrix row names; unnamed ranges
+explicitly use matrix row order. Duplicate genomic intervals are rejected.}
+
+\item{metadata}{Optional data frame with unique row names matching the input
+matrix cell IDs exactly. Rows are reordered by ID, never by position.
+Supplied \verb{nCount_<assay>}/\verb{nFeature_<assay>} columns must agree with the
+raw matrix; conflicting QC metadata is rejected.}
+
+\item{peaks.file, barcodes.file}{Three-column peaks BED and one-column
+barcode paths, both required when \code{object} is a Matrix Market path.
+Gzip compression is supported. Without companion files a path is read as
+H5, importing only the explicitly declared \code{Peaks} modality from its
+standard feature table; H5 requires optional \code{hdf5r}.
+BED and 10x H5 peak IDs use 0-based half-open coordinates, converted to
+1-based closed \code{GRanges} (start + 1, end unchanged).}
+
+\item{cell.names}{Optional unique final cell IDs, in input column order.
+For example, explicitly prefix barcodes from separate captures. Suffixes
+are never removed or guessed.}
+
+\item{sample}{Optional single sample ID, or a named character vector keyed
+by input cell IDs, stored as \code{sample} metadata. A sample label does not
+establish biological replication; retain donor/condition/capture metadata.}
+
+\item{genome}{Optional genome label such as \code{"hg38"}, checked against known
+labels on \code{ranges} and \code{annotation}. This sets a label, not a reference
+download. Supply seqlengths in \code{ranges} for chromosome-bound checks.}
+
+\item{annotation}{Optional Signac-compatible gene annotation \code{GRanges}.}
+
+\item{fragments}{Optional local fragment path(s). Files must be bgzip
+compressed and indexed. Signac validates the paths and barcode membership.}
+
+\item{fragment.cells}{Explicit fragment barcode mapping: a named character
+vector for one file, or a list of vectors in \code{fragments} order. Vector
+names are final object cell IDs; values are exact barcodes in that file.
+Multiple files require disjoint mappings covering every imported cell.
+With one file and no mapping, input matrix barcodes are used unchanged.}
+
+\item{assay}{Name of the new chromatin assay.}
+
+\item{project}{Project name passed to \code{CreateSeuratObject()}.}
+
+\item{verbose}{Whether Signac prints progress messages.}
+}
+\value{
+A Seurat object containing a Signac \code{ChromatinAssay} with raw counts.
+}
+\description{
+Import one explicitly shared peak universe from a sparse matrix and genomic
+ranges, a 10x ATAC/ARC H5 file, or Matrix Market/peaks BED/barcodes files.
+SCOP checks and aligns identifiers; Signac creates the native assay. No cells
+or peaks are filtered, and no resources are downloaded or installed.
+}
+\details{
+Signac uses genomic coordinates as feature names. Original matrix feature
+IDs are retained in assay feature metadata \code{input_peak_id}; input barcodes
+are retained as cell metadata \code{input_barcode}. Import provenance is stored
+next to the data in \code{Misc(object[[assay]], "scop_atac_input")}.
+
+Fragment files remain external references. \code{saveRDS()} does not copy them.
+After \code{readRDS()}, use \code{\link[=CheckATACData]{CheckATACData()}} to inspect their availability and
+export its \code{fragments} table as a resource manifest. Missing external files
+do not invalidate otherwise valid matrix-only analysis. Update moved paths
+explicitly using Signac's \code{UpdatePath()}; paths are never repaired silently.
+}
+\examples{
+peaks <- GenomicRanges::makeGRangesFromDataFrame(data.frame(
+  seqnames = c("chr1", "chr1", "chr2"),
+  start = c(1L, 101L, 201L), end = c(50L, 150L, 250L)
+))
+counts <- Matrix::sparseMatrix(
+  i = c(1, 3, 2, 3), j = c(1, 1, 2, 2), x = c(2, 1, 3, 1),
+  dims = c(3, 2), dimnames = list(c("p1", "p2", "p3"), c("AA-1", "BB-1"))
+)
+atac <- ReadATACData(counts, ranges = peaks, genome = "hg38", sample = "S1")
+CheckATACData(atac)$valid
+}
+\seealso{
+\code{\link[=CheckATACData]{CheckATACData()}}, \code{\link[=RunStandardWorkflow]{RunStandardWorkflow()}}
+}
