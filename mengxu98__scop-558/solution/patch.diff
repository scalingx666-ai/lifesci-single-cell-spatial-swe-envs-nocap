diff --git a/tests/testthat/test-group-heatmap-aggregation.R b/tests/testthat/test-group-heatmap-aggregation.R
index 5bd46e692..859fdd6f8 100644
--- a/tests/testthat/test-group-heatmap-aggregation.R
+++ b/tests/testthat/test-group-heatmap-aggregation.R
@@ -38,3 +38,41 @@ test_that("GroupHeatmap custom aggregation retains the aggregate fallback", {
     group_heatmap_legacy_aggregate(mat, groups, stats::median)
   )
 })
+
+test_that("GroupHeatmap single-feature aggregation retains values and gene names", {
+  mat <- matrix(
+    c(1, 0, 4, 2),
+    nrow = 1,
+    dimnames = list("Rpsa", paste0("Cell", 1:4))
+  )
+  groups <- factor(c("B", "A", "B", "A"), levels = c("A", "B", "unused"))
+  names(groups) <- colnames(mat)
+
+  expect_identical(
+    group_heatmap_aggregate_matrix(mat, groups),
+    matrix(c(1, 2.5), nrow = 1, dimnames = list("Rpsa", c("A", "B")))
+  )
+  expect_identical(
+    group_heatmap_expression_fraction(mat, groups, exp_cutoff = 2),
+    matrix(c(0, 0.5), nrow = 1, dimnames = list("Rpsa", c("A", "B")))
+  )
+})
+
+test_that("GroupHeatmap single-feature aggregation supports one observed group", {
+  mat <- matrix(
+    c(1, 0, 4, 2),
+    nrow = 1,
+    dimnames = list("Rpsa", paste0("Cell", 1:4))
+  )
+  groups <- factor(rep("A", 4), levels = c("A", "unused"))
+  names(groups) <- colnames(mat)
+
+  expect_identical(
+    group_heatmap_aggregate_matrix(mat, groups),
+    matrix(1.75, nrow = 1, dimnames = list("Rpsa", "A"))
+  )
+  expect_identical(
+    group_heatmap_expression_fraction(mat, groups, exp_cutoff = 2),
+    matrix(0.25, nrow = 1, dimnames = list("Rpsa", "A"))
+  )
+})
diff --git a/tests/testthat/test-group-heatmap-single-feature.R b/tests/testthat/test-group-heatmap-single-feature.R
new file mode 100644
index 000000000..e31e3c808
--- /dev/null
+++ b/tests/testthat/test-group-heatmap-single-feature.R
@@ -0,0 +1,50 @@
+test_that("GroupHeatmap single-gene split heatmaps agree with multi-gene heatmaps", {
+  counts <- Matrix::Matrix(
+    rbind(Rpsa = c(1, 0, 4, 2), Reference = c(9, 10, 6, 8)),
+    sparse = TRUE
+  )
+  colnames(counts) <- paste0("Cell", 1:4)
+  object <- SeuratObject::CreateSeuratObject(counts = counts)
+  object$celltype.1 <- factor(c("B", "A", "B", "A"), levels = c("A", "B"))
+  object$group <- factor(c("CTRL", "CTRL", "Day1", "Day1"))
+
+  single <- GroupHeatmap(
+    object,
+    features = "Rpsa",
+    group.by = "celltype.1",
+    split.by = "group",
+    cell_split_palette = "Dark2"
+  )
+  expected <- matrix(
+    (c(0, 2, 1, 4) - 1.75) / sqrt(35 / 12),
+    nrow = 1,
+    dimnames = list("Rpsa", c("A : CTRL", "A : Day1", "B : CTRL", "B : Day1"))
+  )
+  expect_identical(dimnames(single$matrix_list$celltype.1), dimnames(expected))
+  expect_equal(c(single$matrix_list$celltype.1), c(expected))
+  expect_identical(rownames(single$feature_metadata), "Rpsa")
+
+  multiple <- GroupHeatmap(
+    object,
+    features = c("Rpsa", "Reference"),
+    group.by = "celltype.1",
+    split.by = "group",
+    cell_split_palette = "Dark2"
+  )
+  expect_equal(
+    c(single$matrix_list$celltype.1),
+    c(multiple$matrix_list$celltype.1["Rpsa", , drop = FALSE])
+  )
+
+  flipped_dots <- GroupHeatmap(
+    object,
+    features = "Rpsa",
+    group.by = "celltype.1",
+    split.by = "group",
+    cell_split_palette = "Dark2",
+    flip = TRUE,
+    add_dot = TRUE
+  )
+  expect_identical(dimnames(flipped_dots$matrix_list$celltype.1), dimnames(expected))
+  expect_equal(c(flipped_dots$matrix_list$celltype.1), c(expected))
+})
