+            self.console.print("[dim]  /bio scfm run ./data.h5ad --question 'annotate T cell subtypes'  # With user prompt[/dim]")
+            self.console.print("[dim]  /bio scfm list_models                             # Show available models[/dim]")
+            self.console.print()
