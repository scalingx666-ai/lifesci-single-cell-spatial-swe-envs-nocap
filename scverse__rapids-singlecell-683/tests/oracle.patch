+    for i in range(3):
+        for j in range(i + 1, 3):
+            Xi, Xj = X[i * cpg : (i + 1) * cpg], X[j * cpg : (j + 1) * cpg]
+            ref = _cpu_sinkhorn(Xi, Xj, eps=_auto_eps(Xi, Xj))
