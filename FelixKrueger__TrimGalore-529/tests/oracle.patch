+            r.read_to_end(&mut v)?;
+            Ok(v)
+        };
+        assert!(
+            inflate(&serial_out)? == inflate(&par_out)?,
+            "decompressed BAM streams differ"
+        );
+        fs::remove_dir_all(&dir).ok();
+        Ok(())
+    }
 }
