+    bare = model.split("/")[-1] if "/" in model else model
+    version = _api_version(model)
+    endpoint = "streamGenerateContent" if stream else "generateContent"
+    url = f"{_GEMINI_API_BASE}/{version}/models/{bare}:{endpoint}?key={api_key}"
+    if stream:
+        url += "&alt=sse"
+    return url
+
