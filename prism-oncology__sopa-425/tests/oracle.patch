+    meta = {
+        "zarr_format": 2,
+        "shape": list(arr.shape),
+        "chunks": list(arr.shape),
+        "dtype": arr.dtype.str,
+        "fill_value": 0,
+        "order": "C",
+        "filters": None,
+        "dimension_separator": ".",
+        "compressor": _COMPRESSOR_META,
+    }
+    zf.writestr(f"{path}/.zarray", json.dumps(meta).encode())
+    chunk_key = ".".join("0" for _ in arr.shape)
