+    """Run all tests"""
+    print("\n" + "#" * 70)
+    print("# PHATE INPUT TYPE TEST SUITE")
+    print("#" * 70)
+
+    # Track results
+    results = {}
+
+    # Test 1: NumPy array
+    try:
+        test_phate_numpy_array()
