+    if (mp_n) free(mp_n);
+    if (pileup) csp_pileup_destroy(pileup);
+    if (bam_fs) {
+        for (i = 0; i < nfs; i++) csp_bam_fs_destroy(bam_fs[i]);
+        free(bam_fs);		
+    }
+    if (mplp) { csp_mplp_destroy(mplp); }
+    return n;
