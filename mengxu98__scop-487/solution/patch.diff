+ccc_axis_param <- function(which, reverse = FALSE) {
+  axis_param <- list(gp = grid::gpar())
+  if (identical(which, "row")) {
+    axis_param$direction <- if (isTRUE(reverse)) "reverse" else "normal"
+  }
+  axis_param
+}
