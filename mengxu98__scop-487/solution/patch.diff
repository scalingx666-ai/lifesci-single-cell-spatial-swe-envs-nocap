+ccc_match_bar_value <- function(bar_value) {
+  allowed <- c("count", "sum", "mean", "max")
+  out <- unique(as.character(bar_value %||% "sum"))
+  bad <- setdiff(out, allowed)
+  if (length(bad) > 0L) {
+    log_message(
+      "{.arg bar_value} must be one or more of {.val {allowed}}. Invalid values: {.val {bad}}",
+      message_type = "error"
+    )
+  }
+  out
+}
