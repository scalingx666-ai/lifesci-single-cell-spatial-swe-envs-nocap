+ccc_count_side_tracks <- function(side_anno, track_counts = list()) {
+  side_anno <- ccc_match_side_anno(side_anno)
+  n <- 0L
+  for (nm in side_anno) {
+    cur <- track_counts[[nm]] %||% 0L
+    n <- n + as.integer(cur)[1]
+  }
+  n
+}
