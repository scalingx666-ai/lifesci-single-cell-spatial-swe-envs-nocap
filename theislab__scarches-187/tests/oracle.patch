+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "adata = sc.read('../datasets/GSE194122_openproblems_neurips2021_multiome_BMMC_processed.h5ad')\n",
+    "# remove those that appear in fewer than 5% of the cells\n",
+    "sc.pp.filter_genes(adata, min_cells=int(adata.shape[0] * 0.05))"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "id": "3ea6a965-e67f-4c36-be9b-688e81b5a1af",
+   "metadata": {},
+   "source": [
+    "We select the ATAC features, specify the covariates we want to use as condition and cell type annotation and transform the data from reads to fragments."
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": 4,
+   "id": "ea17936e-ebcf-4550-8433-466808d1e8b7",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "adata = adata[:, adata.var['feature_types']=='ATAC']\n",
+    "adata.X = adata.X.todense()\n",
+    "adata.X = adata.X.astype('float32')"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": 5,
+   "id": "5ae3b7af-9326-4902-96ec-5800244a1b01",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "condition_key = 'Samplename'\n",
+    "cell_type_key = 'cell_type'"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": 7,
+   "id": "8bbe3ec2-7bf2-41f7-8840-318b64822276",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "from scarches.models.scpoli._utils import reads_to_fragments\n",
+    "adata_fragments = reads_to_fragments(adata, copy=True)"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "id": "96921324-af97-460e-823d-b9af0ea494fe",
+   "metadata": {},
+   "source": [
+    "We instantiate a model with a Poisson likelihood and train it."
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": 10,
+   "id": "ee6842be-ab08-4566-988b-3c9122b5b804",
+   "metadata": {},
+   "outputs": [
+    {
+     "name": "stdout",
+     "output_type": "stream",
+     "text": [
+      "Embedding dictionary:\n",
+      " \tNum conditions: [13]\n",
+      " \tEmbedding dim: [5]\n",
+      "Encoder Architecture:\n",
+      "\tInput Layer in, out and cond: 16134 100 5\n",
+      "\tMean/Var Layer in/out: 100 25\n",
+      "Decoder Architecture:\n",
+      "\tFirst Layer in, out and cond:  25 100 5\n",
+      "\tOutput Layer in/out:  100 16134 \n",
+      "\n",
+      "Initializing dataloaders\n",
