+      " |████████████████████| 100.0%  - val_loss: 21214.68 - val_cvae_loss: 21208.48 - val_prototype_loss:    6.20 - val_labeled_loss:   12.40\n"
+     ]
+    }
+   ],
+   "source": [
+    "scpoli_model = scPoli(\n",
+    "    adata=adata_fragments,\n",
+    "    condition_keys=condition_key,\n",
+    "    cell_type_keys=cell_type_key,\n",
+    "    hidden_layer_sizes=[100],\n",
+    "    latent_dim=25,\n",
+    "    embedding_dims=5,\n",
+    "    recon_loss='poisson',\n",
+    ")\n",
+    "scpoli_model.train(\n",
+    "    n_epochs=100,\n",
+    "    pretraining_epochs=95,\n",
+    "    use_early_stopping=False,\n",
+    "    alpha_epoch_anneal=1000,\n",
+    "    eta=0.5,\n",
+    ")"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "id": "8ab3efd5-a3ac-4448-9770-99f969517d97",
+   "metadata": {},
+   "source": [
+    "## Plotting cell embeddings"
+   ]
+  },
+  {
+   "cell_type": "code",
