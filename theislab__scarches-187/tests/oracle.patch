+   "id": "77cd02a8-0d16-4d1c-aca3-3728aaa5ab86",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "sc.settings.set_figure_params(dpi=100, frameon=False)\n",
+    "sc.set_figure_params(dpi=100)\n",
