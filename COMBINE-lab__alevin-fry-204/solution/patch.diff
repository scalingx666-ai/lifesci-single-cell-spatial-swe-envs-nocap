+        false,
+        &usa_gene,
+        &fx.usa_tg_map,
+        ResolutionStrategy::CellRangerLike,
+        false,
+        0,
+        false,
+        0,
+    )
+    .expect("a 3-column tg-map on the gene axis is USA mode as always");
+    assert!(usa_gene.join("alevin").join("quants_mat.mtx").exists());
+}
