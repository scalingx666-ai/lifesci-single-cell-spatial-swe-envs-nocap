+            if locked_cluster_centers.contains(&cluster) {
+                continue;
+            }
+            let update = sums[cluster][locus]/denoms[cluster][locus];
+            cluster_centers[cluster][locus] = update.min(0.99).max(0.01);
+        }
+    }
+}
