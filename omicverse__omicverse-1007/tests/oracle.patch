+            {"X_spliced", "X_unspliced"}, {"X_new", "X_total"},
+            {"X_uu", "X_ul", "X_su", "X_sl"},
+        )
+        if not any(keys.issubset(adata.layers) for keys in velocity_layers):
+            raise RuntimeError(
