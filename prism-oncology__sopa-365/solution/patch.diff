         sdata.attrs[SopaAttrs.BINS_TABLE] = bins_table_key
 
+    _save_attrs(sdata)
+
+
+def _save_attrs(sdata: SpatialData):
+    if sdata.is_backed() and settings.auto_save_on_disk:
+        try:
+            sdata.write_attrs()
+        except Exception as e:
+            raise ValueError(f"Error while saving attrs on disk: {e}")
+
 
 HOME_CACHE_DIR = Path.home() / SopaFiles.SOPA_CACHE_DIR
 
diff --git a/workflow/config/visium_hd/proseg.yaml b/workflow/config/visium_hd/proseg.yaml
new file mode 100644
index 00000000..e5f79c3b
--- /dev/null
+++ b/workflow/config/visium_hd/proseg.yaml
@@ -0,0 +1,19 @@
+# Run proseg segmentation on Visium HD data using the 10X Genomics as prior segmentation.
+
+# For parameters details, see this commented example: https://github.com/gustaveroussy/sopa/blob/main/workflow/config/example_commented.yaml
+read:
+  technology: visium_hd
+
+patchify:
+  patch_width_microns: -1
+
+segmentation:
+  proseg:
+    prior_shapes_key: auto
+
+aggregate:
+  aggregate_channels: true
+  min_transcripts: 10 # [optional] cells whose transcript count is below that this threshold are filtered
+
+explorer:
+  ram_threshold_gb: 4
diff --git a/workflow/config/visium_hd/proseg_10x_website.yaml b/workflow/config/visium_hd/proseg_10x_website.yaml
new file mode 100644
index 00000000..b2231c84
--- /dev/null
+++ b/workflow/config/visium_hd/proseg_10x_website.yaml
@@ -0,0 +1,25 @@
+# Config file to run proseg segmentation on 10X Visium HD data from their website (with their prior segmentation)
+# NB: this only works when a full-resolution images is present
+
+# For parameters details, see this commented example: https://github.com/gustaveroussy/sopa/blob/main/workflow/config/example_commented.yaml
+read:
+  technology: visium_hd
+  kwargs:
+    dataset_id: "" # Important: you need this line if you load data from the 10X genomics website
+
+patchify:
+  patch_width_microns: -1
+
+segmentation:
+  proseg:
+    prior_shapes_key: auto
+
+aggregate:
+  aggregate_channels: false
+  min_transcripts: 10 # [optional] cells whose transcript count is below that this threshold are filtered
+
+scanpy_preprocess:
+  check_counts: false
+
+explorer:
+  ram_threshold_gb: 4
