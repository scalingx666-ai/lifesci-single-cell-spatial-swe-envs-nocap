+def test_cal_spatial_net_removes_self_by_identity_with_duplicate_coordinates():
+    adata = _batch("x")
+    adata.obsm["spatial"] = np.array([[0, 0], [0, 0], [1, 0]], dtype=float)
+
+    Cal_Spatial_Net(
