+        dtype=np.float32,
+    )
+    transform = cv.getPerspectiveTransform(box_src, box_dst)
+    return cv.warpPerspective(
+        img,
+        transform,
+        (width, height),
+        flags=interpolation_method,
+        borderMode=cv.BORDER_REPLICATE,
+    )
 
 
