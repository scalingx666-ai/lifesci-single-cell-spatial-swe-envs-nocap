new file mode 100644
index 000000000..fbe7f4f12
--- /dev/null
+++ b/man/CellTreePlot.Rd
@@ -0,0 +1,111 @@
+% Generated by roxygen2: do not edit by hand
+% Please edit documentation in R/CellTreePlot.R
+\name{CellTreePlot}
+\alias{CellTreePlot}
+\title{Plot a circular cell annotation tree}
+\usage{
+CellTreePlot(
+  object,
+  levels,
+  count = NULL,
+  tracks = NULL,
+  palette = "Dark2",
+  palcolor = NULL,
+  label.size = 3,
+  show_proportion = TRUE,
+  title = NULL,
+  return_data = FALSE,
+  show_internal_labels = FALSE
+)
+}
+\arguments{
+\item{object}{A Seurat object or a data frame containing cell annotations.}
+
+\item{levels}{One or more unique annotation column names, broadest first.
+Labels must be nonmissing and nonblank. The names \code{.count} and
+\code{.proportion} are reserved.}
+
+\item{count}{Column of nonnegative whole counts with a finite positive
+total. With \code{NULL}, each row counts as one cell.}
+
+\item{tracks}{Data frame keyed by unique full annotation paths in \code{object},
+with one numeric column per ring (inner to outer). Rings share a
+zero-centered scale. Missing values and omitted paths appear gray.}
+
+\item{palette, palcolor}{Palette (default \code{"Dark2"}) and optional custom
+colors. Named colors override matching broad groups; other groups use
+the palette. Unnamed colors follow group order.}
+
+\item{label.size}{Positive, finite leaf label size (default \code{3}).}
+
+\item{show_proportion}{Logical. Label each leaf with its share of the total
+count (default \code{TRUE}).}
+
+\item{title}{Plot title (default \code{NULL}, no title).}
+
+\item{return_data}{Logical. Include the leaf and track data (default \code{FALSE}).}
+
+\item{show_internal_labels}{Logical. Label intermediate levels (default \code{FALSE}).}
+}
+\value{
+A \code{ggplot} object that accepts layers with \code{+}. With
+\code{return_data = TRUE}, a list with \code{plot}, \code{leaves} (one row per annotation
+path with \code{.count} and \code{.proportion}), and \code{tracks} (aligned to the leaves,
+or \code{NULL}).
+}
+\description{
+Show cell proportions and optional numeric rings. Requires \code{ggforce}.
+}
+\examples{
+data(pancreas_sub)
+hierarchy <- c("CellType", "SubCellType")
+CellTreePlot(pancreas_sub, hierarchy)
+
+meta <- pancreas_sub[[]]
+scores <- stats::aggregate(meta[c("S_score", "G2M_score")], meta[hierarchy], mean)
+CellTreePlot(pancreas_sub, hierarchy, tracks = scores)
+
+data(pbmcmultiome_sub)
+pbmc <- pbmcmultiome_sub[[]]
+groups <- c(
+  B = "B cells", "CD4 T" = "T cells", "CD8 T" = "T cells",
+  NK = "NK cells", DC = "Myeloid", Mono = "Myeloid"
+)
+pbmc$Group <- unname(groups[as.character(pbmc$CellType)])
+hierarchy <- c("Group", "CellType", "SubCellType")
+
+metrics <- c("nCount_RNA", "nFeature_RNA", "nCount_ATAC", "nFeature_ATAC")
+tracks <- stats::aggregate(pbmc[metrics], pbmc[hierarchy], stats::median)
+subset_medians <- vapply(pbmc[metrics], stats::median, numeric(1))
+tracks[metrics] <- Map(
+  function(x, center) log2(x / center),
+  tracks[metrics], subset_medians
+)
+names(tracks)[match(metrics, names(tracks))] <- c(
+  "RNA counts", "RNA genes", "ATAC counts", "ATAC peaks"
+)
+
+CellTreePlot(pbmc, hierarchy, tracks = tracks, label.size = 2.25)
+
+genes <- c("MS4A1", "CD3D", "NKG7", "LST1")
+rna <- SeuratObject::LayerData(
+  pbmcmultiome_sub,
+  assay = "RNA", layer = "counts", features = genes
+)
+detected <- as.data.frame(t(as.matrix(rna[genes, rownames(pbmc)] > 0)))
+gene_tracks <- stats::aggregate(detected, pbmc[hierarchy], mean)
+subset_detection <- colMeans(detected)
+gene_tracks[genes] <- Map(
+  function(x, center) 100 * (x - center),
+  gene_tracks[genes], subset_detection
+)
+CellTreePlot(pbmc, hierarchy, tracks = gene_tracks, label.size = 2.25)
+}
+\references{
+\url{https://doi.org/10.1126/science.adt3130}
+
+\url{https://mp.weixin.qq.com/s/F7cgHFmpEAhwhrzAN0NvUA}
+}
+\seealso{
+\code{\link[=ClusterTreePlot]{ClusterTreePlot()}}, \code{\link[=CellStatPlot]{CellStatPlot()}}
+}
diff --git a/tests/testthat/test-cell-tree-plot.R b/tests/testthat/test-cell-tree-plot.R
new file mode 100644
index 000000000..727e012c6
--- /dev/null
+++ b/tests/testthat/test-cell-tree-plot.R
@@ -0,0 +1,157 @@
+test_that("annotation paths determine leaf counts and percentages", {
+  skip_if_not_installed("ggforce")
+  hierarchy <- c("major", "minor")
+  annotations <- data.frame(
+    major = c("B", "A", "A", "B", "A", "A/B"),
+    minor = c("Shared", "Shared", "Shared", "Only", "B/C", "C")
+  )
+  result <- scop::CellTreePlot(annotations, hierarchy, return_data = TRUE)
+
+  expect_s3_class(result$plot, "ggplot")
+  expect_null(result$tracks)
+  expect_equal(result$leaves$major, c("A", "A", "A/B", "B", "B"))
+  expect_equal(result$leaves$minor, c("B/C", "Shared", "C", "Only", "Shared"))
+  expect_equal(result$leaves$.count, c(1, 2, 1, 1, 1))
+  expect_equal(result$leaves$.proportion, c(1, 2, 1, 1, 1) / 6)
+  expect_no_warning(ggplot2::ggplotGrob(result$plot))
+
+  summary <- data.frame(
+    major = c("B", "A"), minor = c("Shared", "Shared"),
+    cells = c(0, 30)
+  )
+  weighted <- CellTreePlot(summary, hierarchy,
+    count = "cells",
+    return_data = TRUE
+  )
+  expect_equal(weighted$leaves$.count, c(30, 0))
+  expect_equal(weighted$leaves$.proportion, c(1, 0))
+})
+
+test_that("rings use complete annotation paths and preserve missing values", {
+  skip_if_not_installed("ggforce")
+  hierarchy <- c("major", "minor")
+  annotations <- data.frame(
+    major = c("B", "A", "A"),
+    minor = c("Shared", "Other", "Shared")
+  )
+  values <- data.frame(
+    major = c("B", "A"), minor = c("Shared", "Shared"),
+    RNA = c(0, 0.3), ATAC = c(-0.5, NA_real_)
+  )
+  result <- CellTreePlot(annotations, hierarchy,
+    tracks = values,
+    return_data = TRUE
+  )
+  expect_equal(result$tracks$major, c("A", "A", "B"))
+  expect_equal(result$tracks$minor, c("Other", "Shared", "Shared"))
+  expect_equal(result$tracks$RNA, c(NA_real_, 0.3, 0))
+  expect_equal(result$tracks$ATAC, c(NA_real_, NA_real_, -0.5))
+  fill_scale <- ggplot2::ggplot_build(result$plot)$plot$scales$get_scales("fill")
+  expect_length(unique(fill_scale$map(c(NA_real_, 0))), 2L)
+  breaks <- fill_scale$get_breaks()
+  expect_length(breaks, 3L)
+  expect_lt(breaks[[1L]], 0)
+  expect_equal(breaks, c(-breaks[[3L]], 0, breaks[[3L]]))
+  expect_no_warning(ggplot2::ggplotGrob(result$plot))
+
+  shuffled <- CellTreePlot(annotations[3:1, ], hierarchy,
+    tracks = values[2:1, ], return_data = TRUE
+  )
+  expect_equal(shuffled$leaves, result$leaves)
+  expect_equal(shuffled$tracks, result$tracks)
+  expect_error(CellTreePlot(annotations, hierarchy,
+    tracks = values[c(1, 1), ]
+  ))
+  expect_error(CellTreePlot(annotations, hierarchy,
+    tracks = transform(values, minor = "Unknown")
+  ))
+  expect_error(CellTreePlot(annotations, hierarchy,
+    tracks = transform(values, RNA = Inf)
+  ))
+})
+
+test_that("named custom colors match annotation groups", {
+  skip_if_not_installed("ggforce")
+  annotations <- data.frame(group = c("B", "A"))
+  colors <- c(B = "#2040AA", A = "#AA4020")
+  plot <- scop::CellTreePlot(annotations, "group", palcolor = colors)
+  scale <- ggplot2::ggplot_build(plot)$plot$scales$get_scales("colour")
+  expect_identical(scale$map(c("A", "B")), unname(colors[c("A", "B")]))
+})
+
+test_that("ring colors remain distinct across extreme finite values", {
+  skip_if_not_installed("ggforce")
+  annotations <- data.frame(group = c("A", "B", "C", "D"))
+  values <- c(-1e308, 0, 1e308, NA_real_)
+  plot <- scop::CellTreePlot(
+    annotations, "group",
+    tracks = transform(annotations, score = values)
+  )
+  built <- ggplot2::ggplot_build(plot)
+  ring <- Filter(function(layer) "fill" %in% names(layer), built$data)[[1L]]
+  tiles <- unique(ring[c("group", "fill")])
+  expect_identical(
+    tiles$fill[order(tiles$group)], c("#2C6B9E", "#F8F7F4", "#BD4E42", "#A9ADB4")
+  )
+  key <- ggplot2::get_guide_data(plot, "fill")
+  expect_true(all(is.finite(key$.value)) && all(diff(key$.value) > 0))
+  expect_equal(sign(as.numeric(key$.label)), c(-1, 0, 1))
+  expect_no_warning(ggplot2::ggplotGrob(plot))
+})
+
+test_that("each leaf has a broad-group tile inside the numeric rings", {
+  skip_if_not_installed("ggforce")
+  annotations <- data.frame(major = c("A", "A", "B"), minor = c("x", "y", "x"))
+  radius <- function(layer) sqrt(layer$x^2 + layer$y^2)
+
+  for (tracks in list(NULL, transform(annotations, score = 1:3))) {
+    plot <- CellTreePlot(annotations, c("major", "minor"), tracks = tracks)
+    built <- ggplot2::ggplot_build(plot)
+    arcs <- which(vapply(plot$layers, function(layer) {
+      inherits(layer$geom, "GeomArcBar")
+    }, logical(1)))
+    band <- built$data[[arcs[[2L]]]]
+    fill <- grep("^fill", names(band), value = TRUE)
+    tiles <- unique(band[c("group", fill)])
+    expect_equal(nrow(tiles), nrow(annotations))
+    expect_identical(duplicated(tiles[[fill]]), c(FALSE, TRUE, FALSE))
+    if (!is.null(tracks)) {
+      expect_lt(max(radius(band)), min(radius(built$data[[arcs[[3L]]]])))
+    }
+  }
+})
+
+test_that("one-leaf and deeper hierarchies render", {
+  skip_if_not_installed("ggforce")
+  one <- data.frame(label = "NA")
+  one_ring <- data.frame(label = "NA", score = 0)
+  p <- CellTreePlot(one, "label", tracks = one_ring, return_data = TRUE)
+  expect_equal(p$leaves$.proportion, 1)
+  expect_no_warning(ggplot2::ggplotGrob(p$plot))
+
+  nested <- data.frame(
+    broad = c("A", "A", "B"),
+    fine = c("Family", "Family", "Family"),
+    leaf = c("x", "y", "x")
+  )
+  result <- CellTreePlot(nested, c("broad", "fine", "leaf"),
+    return_data = TRUE
+  )
+  expect_equal(result$leaves$.proportion, rep(1 / 3, 3))
+  expect_null(result$plot$labels$title)
+  expect_no_warning(ggplot2::ggplotGrob(result$plot))
+  text_labels <- function(plot) {
+    unlist(lapply(ggplot2::ggplot_build(plot)$data, function(layer) layer$label))
+  }
+  expect_false("Family" %in% text_labels(result$plot))
+  labeled <- CellTreePlot(
+    nested, c("broad", "fine", "leaf"),
+    title = "My tree", show_internal_labels = TRUE
+  )
+  expect_identical(labeled$labels$title, "My tree")
+  expect_true("Family" %in% text_labels(labeled))
+  expect_error(CellTreePlot(
+    transform(nested, leaf = NA_character_),
+    c("broad", "fine", "leaf")
+  ))
+})
diff --git a/vignettes/cell-tree-advanced.Rmd b/vignettes/cell-tree-advanced.Rmd
new file mode 100644
index 000000000..55f0230b9
--- /dev/null
+++ b/vignettes/cell-tree-advanced.Rmd
@@ -0,0 +1,115 @@
+---
+title: "Cell annotation trees with CIMA"
+---
+
+```{r setup, include=FALSE}
+knitr::opts_chunk$set(collapse = TRUE, comment = "#>", error = FALSE)
+```
+
+Use [CellTreePlot()](../reference/CellTreePlot.html) to draw the 73 level 4
+(L4) cell subtypes in the Chinese Immune Multi-Omics Atlas (CIMA). The leaf
+labels show the share of scRNA-seq cells in each subtype. Four rings show how
+subtype proportions vary with age and sex in scRNA-seq and scATAC-seq.
+For a smaller example using bundled data, see the PBMC multiome example in the
+function reference.
+
+## Read the atlas summaries
+
+Download five public CSV files from the [CIMA Cell Atlas resources](https://db.cngb.org/trueblood/cima/resource).
+The scRNA-seq proportion table supplies the subtype names, cell counts, and
+proportions. The other four tables supply the age and sex statistics. You need
+internet access to run this example.
+
+```{r read-cima-summaries}
+base_url <- paste0(
+  "https://ftp.cngb.org/pub/SciRAID/trueblood/cima/",
+  "CIMA_Resource/Cell_Atlas/CIMA_Cell_Type_L4_"
+)
+files <- c(
+  proportion = "scRNA_Proportion.csv",
+  "RNA age" = "scRNA_Proportion_Age_Related.csv",
+  "RNA sex" = "scRNA_Proportion_Sex_Related.csv",
+  "ATAC age" = "scATAC_Proportion_Age_Related.csv",
+  "ATAC sex" = "scATAC_Proportion_Sex_Related.csv"
+)
+summaries <- lapply(files, function(file) {
+  utils::read.csv(paste0(base_url, file), fileEncoding = "UTF-8-BOM",
+                  check.names = FALSE, na.strings = c("", "NA"))
+})
+cima <- summaries$proportion
+```
+
+## Group the subtype labels for the tree
+
+Use seven broad groups for the branch colors. For the next level, take the
+part of each L4 name before its last underscore as the family. These are
+display groups derived from the L4 names. The study's four-level annotation
+appears in Fig. 1E and Table S1 of [Yin et al.](https://doi.org/10.1126/science.adt3130).
+
+```{r group-cima-subtypes}
+patterns <- c(
+  "HSPC / Mk" = "(HSPC|MK)_.+",
+  Myeloid = "(.*DC|.*Mono).+|AS_DC",
+  "Other T" = "(gdT|MAIT|Immature_T|Proliferative_T).+",
+  "CD8 T" = "CD8_.+",
+  "CD4 T" = "CD4_.+",
+  "NK, NKT, ILC" = "(.*NK|ILC).+",
+  "B cells" = "(.*_Bm_|Bn_|Transitional_B_|Plasma).+"
+)
+cima$Lineage <- NA_character_
+for (lineage in names(patterns)) {
+  pattern <- paste0("^(?:", patterns[[lineage]], ")$")
+  cima$Lineage[grepl(pattern, cima$cell_type_l4, perl = TRUE)] <- lineage
+}
+cima$Family <- sub("_[^_]+$", "", cima$cell_type_l4)
+cima$Subtype <- gsub("_", " ", cima$cell_type_l4, fixed = TRUE)
+hierarchy <- c("Lineage", "Family", "Subtype")
+```
+
+## Align and standardize the age and sex statistics
+
+Match the published subtype identifiers exactly. The first column of each
+association CSV holds those identifiers. Unmatched subtypes and blank statistics
+stay as `NA`. For a shared color scale, `thisutils::normalization()` subtracts
+each ring's mean and divides by its sample standard deviation across subtypes
+with values. Use `na_rm = FALSE` to keep missing values and clip the z scores at
+±3. The output counts the subtypes with a value in each ring.
+
+```{r align-cima-associations}
+associations <- summaries[-1L]
+fields <- c("correlation", "log2FC", "age_correlation", "log2FC")
+tracks <- cima[hierarchy]
+for (i in seq_along(associations)) {
+  association <- associations[[i]]
+  rows <- match(cima$cell_type_l4, association[[1L]])
+  z <- thisutils::normalization(association[[fields[[i]]]][rows],
+                                method = "z_score", na_rm = FALSE)
+  tracks[[names(associations)[[i]]]] <- pmax(-3, pmin(3, z))
+}
+colSums(!is.na(tracks[names(associations)]))
+```
+
+## Draw and read the four rings
+
+The thin band at the branch tips uses the lineage colors. Read the four
+numeric rings outside that band from the inside out:
+
+1. **RNA age.** Correlation between age and scRNA-seq subtype proportion.
+2. **RNA sex.** Log2 fold change in scRNA-seq subtype proportion between sex groups.
+3. **ATAC age.** Correlation between age and scATAC-seq subtype proportion.
+4. **ATAC sex.** Log2 fold change in scATAC-seq subtype proportion between sex groups.
+
+Red and blue show z scores above and below the ring mean. Gray marks an
+unavailable value. A measured zero or a nonsignificant result can still have a
+color. Use the source tables for the original effect sizes, signs, and p-values.
+
+Pass the published `cell_count` column so the labels show percentages of the
+6,484,974 scRNA-seq cells in the proportion table. Each subtype occupies the
+same angle in the tree. The numeric columns in `tracks` set the ring order.
+
+```{r plot-cima-tree, fig.width=8.5, fig.height=8.5, dpi=160, dev.args=list(bg="white"), out.width="100%", fig.align="center", fig.alt="Circular tree of 73 CIMA cell subtypes with a lineage band and four numeric rings for RNA and ATAC age and sex associations."}
+scop::CellTreePlot(
+  cima, levels = hierarchy, count = "cell_count", tracks = tracks,
+  label.size = 2.1
+)
+```
