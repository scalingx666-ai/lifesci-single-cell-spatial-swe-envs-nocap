+    row.names = 1,
+    check.names = FALSE,
+    stringsAsFactors = FALSE
+  )
+  value <- as.matrix(value)
+  storage.mode(value) <- "double"
+  if (
+    is.null(rownames(value)) ||
+      is.null(colnames(value)) ||
+      anyDuplicated(rownames(value)) ||
+      anyDuplicated(colnames(value)) ||
+      any(!is.finite(value))
