@@ -0,0 +1,16 @@
+#!/usr/bin/expect -f
+
+# Mac only! (depends upon `open` command)
+
+set h5ad [lindex $argv 0]
+puts "$h5ad"
+
+spawn cellxgene launch $h5ad
+
+set timeout 10
+expect -indices -re "Please go to (http:\/\/localhost:\[0-9\]+)" {
+    set url $expect_out(1,string)
+    exec >@stdout 2>@stderr open $url
+}
+
+interact
