+    res_explicit_adata = model.get_importance(adata=vivs_adata, n_mc_samples=3, use_vmap=False)
+    torch.manual_seed(0)
+    res_all_cells = model.get_importance(
+        indices=np.arange(vivs_adata.n_obs), n_mc_samples=3, use_vmap=False
