+                    str_row = "".join(str_digit)
+                    c_rows.append(int(str_row))
+                ix = np.argsort(c_rows)
+                rix = df.index[ix].to_list()
+                if not ascending:
+                    rix = rix[::-1]
+                reorder_ix += rix
+
+            if ascending:
+                reorder_ix = reorder_ix[::-1]
