         fixed = TRUE)
 })
+
+test_that(".which_cells errors when object is missing cell names", {
+    colnames(sce) <- NULL
+    expect_error(
+        .which_cells(NULL, sce),
+        "colnames(<object>)", fixed = TRUE
+    )
+
+    expect_error(
+        dittoPlot(
+            sce, "gene1", group.by = "groups"),
+        "colnames(<object>)", fixed = TRUE
+    )
+    expect_error(
+        dittoBarPlot(
+            sce, "clusters", group.by = "groups"),
+        "colnames(<object>)", fixed = TRUE
+    )
+    expect_error(
+        dittoDimPlot(
+            sce, "gene1"),
+        "colnames(<object>)", fixed = TRUE
+    )
+})
