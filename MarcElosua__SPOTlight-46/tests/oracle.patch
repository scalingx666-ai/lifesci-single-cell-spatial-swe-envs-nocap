+# ------------------------------------------------------------------------------
+# ----  Check SPOTlight x, y inputs  -------------------------------------------
+# ------------------------------------------------------------------------------
+# ------------------------------------------------------------------------------
+# .SPOTlight with SCE ----
+test_that("SPOTlight x SPE", {
+    decon <- runDeconvolution(
+        x = spe,
+        mod = res[["mod"]],
+        ref = res[["topic"]]
+    )
+    
+    .checks(decon, sce)
+})
+
+# .SPOTlight with sparse matrix sp ----
+test_that("SPOTlight x dgCMatrix SP", {
