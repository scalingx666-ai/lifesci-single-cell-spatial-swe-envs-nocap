+    let mut x2 = vec![0.0f64; n];
+    let mut r = vec![0.0f64; n];
+    let mut v = vec![0.0f64; n];
+    let mut xp = vec![0.0f64; n];
+
+    while *it < opts.max_iter {
+        f(x0, &mut x1);
+        *it += 1;
+        f(&x1, &mut x2);
+        *it += 1;
+
+        // r = x1 - x0 ; v = (x2 - x1) - r ; and their squared norms.
+        let mut r_sq = 0.0f64;
+        let mut v_sq = 0.0f64;
+        for i in 0..n {
+            let ri = x1[i] - x0[i];
+            let vi = (x2[i] - x1[i]) - ri;
+            r[i] = ri;
+            v[i] = vi;
+            r_sq += ri * ri;
+            v_sq += vi * vi;
+        }
