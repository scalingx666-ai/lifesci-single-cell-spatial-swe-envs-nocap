+        // plain step x2. `v_sq <= 0.0` is false for NaN, so the finiteness check
+        // also guards NaN/inf.
+        if v_sq <= 0.0 || !v_sq.is_finite() {
+            std::mem::swap(x0, &mut x2);
+            return true;
+        }
+
+        // SqS3 steplength, clamped so |alpha| ≥ 1 (alpha = -1 ⇒ xp = x2).
+        let mut alpha = -(r_sq.sqrt() / v_sq.sqrt());
