+         
+          ## Print the results
+          echo $rversion
+          echo $biocversionnum
+          echo $imagename
+
+          ## Save the info for the next job
+          echo "::set-output name=rversion::${rversion}"
+          echo "::set-output name=biocversionnum::${biocversionnum}"
+          echo "::set-output name=imagename::${imagename}"
+        shell: bash {0}
