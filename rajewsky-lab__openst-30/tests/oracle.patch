+    im, pts = create_unpaired_pseudoimage(adata, 
+                                     args.spatial_coord_key,
+                                     args.input_resolution,
+                                     args.render_scale,
+                                     args.render_sigma,
+                                     args.output_resolution)
+    
+    viewer = napari.Viewer()
+    viewer.add_image(data=im)
