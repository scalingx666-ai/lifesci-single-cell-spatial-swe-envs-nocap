+  rhdf5::h5writeAttribute("var_names", h5g_ra, "Gene")
+
+  # Write primary asssay name as attribute of '/matrix'
+  h5d_mx <- rhdf5::H5Dopen(h5f, "/matrix")
+  rhdf5::h5writeAttribute("assay", h5d_mx, names(SummarizedExperiment::assays(scle))[1])
