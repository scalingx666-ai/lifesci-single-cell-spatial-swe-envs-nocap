@@ -156,6 +156,30 @@ def test_no_filter_genes(flavor):
     assert adata.var["highly_variable"].sum() == 10000
 
 
+@pytest.mark.filterwarnings("ignore:Variable names are not unique:UserWarning")
+@pytest.mark.parametrize("flavor", ["seurat", "cell_ranger"])
+def test_batched_duplicate_var_names(flavor: Literal["seurat", "cell_ranger"]):
+    """Genes sharing a name are still separate genes (#4432)."""
+    rng = np.random.default_rng(0)
+    x = rng.negative_binomial(3, 0.3, (300, 120)).astype(np.float32)
+    x[:150, 0] = 0  # unexpressed in batch "a", so filtered out there
+    obs = pd.DataFrame({"batch": pd.Categorical(np.repeat(["a", "b"], 150))})
+    obs.index = obs.index.astype(str)
+
+    def hvg(var_names: list[str]) -> pd.DataFrame:
+        adata = AnnData(x.copy(), obs=obs, var=pd.DataFrame(index=var_names))
+        if flavor == "seurat":
+            sc.pp.log1p(adata)
+        return sc.pp.highly_variable_genes(
+            adata, flavor=flavor, n_top_genes=30, batch_key="batch", inplace=False
+        )
+
+    unique = hvg([f"g{i}" for i in range(120)])
+    dup = hvg([f"g{i % 100}" for i in range(120)])
+    assert dup["highly_variable"].sum() == 30
+    assert_frame_equal(dup.reset_index(drop=True), unique.reset_index(drop=True))
+
+
 def _check_pearson_hvg_columns(output_df: pd.DataFrame, n_top_genes: int):
