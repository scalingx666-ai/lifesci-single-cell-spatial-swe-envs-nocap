+@pytest.mark.parametrize("write", [True, False])
+def test_run_and_write_dataset(tmpdir, write, slide_dataset):
+    pipe = Pipeline()
+
+    if write:
+        write_dir_arg = tmpdir
+    else:
+        write_dir_arg = None
+
+    slide_dataset.run(pipe, tile_size=500, distributed=False, write_dir=write_dir_arg)
