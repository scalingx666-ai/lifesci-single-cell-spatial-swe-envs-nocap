+
+
+def _channels_average_within_mask(image: np.ndarray, mask: np.ndarray) -> np.ndarray:
+    channels_average = (image * mask).sum(axis=(1, 2)) / mask.sum().clip(1)
+
+    return image * mask + (1 - mask) * channels_average[:, None, None]
