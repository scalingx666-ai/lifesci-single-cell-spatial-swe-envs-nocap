+/// `--consider_already_trimmed` suppression wins over `-a2`: trimming R2 while
+/// R1 is left alone would be asymmetric under a banner promising quality
+/// trimming only.
+#[test]
+fn suppression_wins_over_a2() {
+    let dir = tempdir("suppressed");
+    let (ok, stderr) = run(&[
+        "--paired",
