+            [1 / 3, 2 / 3],  # neighbors 1, 2, 3 -> b, a, b
+            [1.0, 0.0],  # neighbors 0, 2    -> a, a
+            [0.5, 0.5],  # neighbors 0, 1    -> a, b
+            [1.0, 0.0],  # neighbor  0       -> a
+        ]
+    )
+    np.testing.assert_allclose(profile, expected)
