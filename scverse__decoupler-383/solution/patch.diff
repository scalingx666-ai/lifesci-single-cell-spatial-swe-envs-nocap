+        pval = ((null[pos_null_msk] >= es).sum() + 1) / (pos_null_sum + 1)
         pos_null_mean = null[pos_null_msk].mean()
         nes = es / pos_null_mean
     elif (es < 0) and (neg_null_sum > 0):
