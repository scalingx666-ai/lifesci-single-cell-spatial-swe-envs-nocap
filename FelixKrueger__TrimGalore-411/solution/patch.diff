+    /// REGRESSION (#401, from #383's D8→D13 reversal). D8 re-keyed the input-identity
+    /// checks on the case-folded key, which rejected four genuinely distinct files; D13
+    /// reversed it. The `io.rs` tests pin the keys; this pins the wiring, which is what
+    /// broke.
+    ///
+    /// Linux-only by necessity, not preference: `validate()` requires the inputs to
+    /// exist, and on a case-insensitive filesystem `Sample_R1` and `SAMPLE_R1` are one
+    /// file — so the four distinct files this needs cannot exist on APFS/NTFS at all.
+    /// The `#216` CI job covers the same ground end-to-end on the same leg.
+    #[cfg(target_os = "linux")]
+    #[test]
+    fn test_case_only_input_variants_are_distinct() {
+        let dir = std::env::temp_dir().join(format!("tg_caseonly_{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let names = [
+            "Sample_R1.fastq",
+            "Sample_R2.fastq",
+            "SAMPLE_R1.fastq",
+            "SAMPLE_R2.fastq",
+        ];
+        for n in names {
+            std::fs::write(dir.join(n), "@r\nACGT\n+\nIIII\n").unwrap();
+        }
+        // Prove the premise before trusting the assertion: a case-insensitive volume
+        // would have collapsed these into two files, making the test vacuous.
+        let found = std::fs::read_dir(&dir).unwrap().count();
+        assert_eq!(
+            found, 4,
+            "expected 4 distinct files, filesystem gave {found}"
+        );
+
+        let paths: Vec<String> = names
+            .iter()
+            .map(|n| dir.join(n).to_string_lossy().into_owned())
+            .collect();
+        let cli = Cli::parse_from([
+            "trim_galore",
+            "--paired",
+            &paths[0],
+            &paths[1],
+            &paths[2],
+            &paths[3],
+        ]);
+        let result = cli.validate();
+        let _ = std::fs::remove_dir_all(&dir);
+        assert!(
+            result.is_ok(),
+            "case-only variants are distinct inputs and must validate; got: {}",
+            result.unwrap_err()
+        );
+    }
