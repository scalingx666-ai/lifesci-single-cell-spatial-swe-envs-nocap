+        assert_eq!(
+            hardtrim_output_name(Path::new("sample.fastq.bgz"), 50, "5prime", None, false),
+            PathBuf::from("sample.50bp_5prime.fq")
+        );
+        assert_eq!(
+            clock_output_name(Path::new("sample_R1.fq.bgz"), "R1", None, false),
+            PathBuf::from("sample_R1.clock_UMI.R1.fq")
+        );
