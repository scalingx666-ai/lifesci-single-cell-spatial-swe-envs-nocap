+    expected_block(fx$mat, rows, bc, compact_rows = FALSE, compact_cols = TRUE)
+  })
+  expect_blocks(blocks, expected, "axis = 1")
+})
+
+test_that("Blockwise reads accept coords for a subset of dimensions", {
