diff --git a/R/compatibility.R b/R/compatibility.R
new file mode 100644
index 0000000..54ce346
--- /dev/null
+++ b/R/compatibility.R
@@ -0,0 +1,11 @@
+pop_legacy_arg <- function(value, dots, legacy, current_missing) {
+  if (legacy %in% names(dots)) {
+    if (current_missing) {
+      value <- dots[[legacy]]
+    }
+
+    dots[[legacy]] <- NULL
+  }
+
+  list(value = value, dots = dots)
+}
