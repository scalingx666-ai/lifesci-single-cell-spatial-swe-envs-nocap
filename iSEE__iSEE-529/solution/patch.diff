@@ -180,6 +183,10 @@ setMethod("initialize", "Panel", function(.Object, ...) {
 
     args <- .emptyDefault(args, .dataParamBoxOpen, FALSE)
 
+    current <- c(.latest_version, args[[.packageVersion]])
