+    for (al, nx) in alpha.chunks(L1_CHUNK).zip(next.chunks(L1_CHUNK)) {
+        let mut part = 0.0f64;
+        for (&a_in, &a_out) in al.iter().zip(nx) {
+            max_d = fold_d(max_d, a_in, a_out, cutoff);
+            part += (a_out - a_in).abs();
+        }
+        l1 += part;
     }
     (max_d, l1)
 }
