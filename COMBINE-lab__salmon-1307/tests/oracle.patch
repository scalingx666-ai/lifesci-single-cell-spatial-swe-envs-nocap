+/// of its step from `alpha` to `next`, summed as [`L1_CHUNK`] says.
 #[inline]
 fn criterion(alpha: &[f64], next: &[f64], cutoff: f64) -> (f64, f64) {
     let mut max_d = f64::NEG_INFINITY;
