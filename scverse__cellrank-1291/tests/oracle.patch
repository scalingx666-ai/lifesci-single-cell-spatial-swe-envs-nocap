+  release:
+    types: [published]
+
+jobs:
+  release:
+    name: Upload release to PyPI
+    runs-on: ubuntu-latest
+    environment:
+      name: deployment
+      url: https://pypi.org/p/cellrank
+    permissions:
+      id-token: write
+    steps:
+    - uses: actions/checkout@v6
