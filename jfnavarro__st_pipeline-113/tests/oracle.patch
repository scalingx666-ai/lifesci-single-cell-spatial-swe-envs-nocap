diff --git a/.github/workflows/dev.yml b/.github/workflows/dev.yml
index bb3dcda..cd94c46 100644
--- a/.github/workflows/dev.yml
+++ b/.github/workflows/dev.yml
@@ -35,9 +35,26 @@ jobs:
         python -m pip install --upgrade pip
         pip install poetry
 
+    - name: Install samtools
+      run: |
+        sudo apt-get update
+        sudo apt-get install -y samtools
+
+    - name: Install STAR (Precompiled Binary)
+      run: |
+        STAR_VERSION="2.7.11a"
+        wget -q https://github.com/alexdobin/STAR/releases/download/${STAR_VERSION}/STAR_${STAR_VERSION}.zip
+        unzip STAR_${STAR_VERSION}.zip
+        sudo mv STAR_${STAR_VERSION}/Linux_x86_64_static/STAR /usr/local/bin/
+
+    - name: Verify STAR and samtools installation
+      run: |
+        STAR --version
+        samtools --version
+
     - name: test
       run: |
-        poetry install
+        poetry install -E dev
         poetry run pytest
 
   publish_dev_build:
diff --git a/CONTRIBUTING.md b/CONTRIBUTING.md
index f7587d7..ea924ee 100644
--- a/CONTRIBUTING.md
+++ b/CONTRIBUTING.md
@@ -172,6 +172,19 @@ poetry run mkdocs build
 ## Publish package
 
 Ensure that you have configured your PyPi tokens.
+
+```console
+poetry config repositories.testpypi https://test.pypi.org/legacy/
+poetry config repositories.pypi https://upload.pypi.org/legacy/
+```
+
+and
+
+``` console
+poetry config pypi-token.pypi YOUR_PYPI_API_TOKEN
+poetry config pypi-token.testpypi YOUR_TEST_PYPI_API_TOKEN
+```
+
 Then run:
 
 ``` console
