+      stroke = 0.35,
+      show.legend = FALSE
+    )
+  }
+  if (nrow(gene_nodes) > 0L) {
+    p <- p + ggplot2::geom_point(
+      data = gene_nodes,
+      ggplot2::aes(
+        x = .data[["x"]],
+        y = .data[["y"]],
+        fill = .data[["node_color"]],
+        color = .data[["border_color"]],
