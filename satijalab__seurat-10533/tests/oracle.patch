+  fov = 'fov',
+  assay = 'Atera',
+  mols.qv.threshold = 20,
+  cell.centroids = TRUE,
+  molecule.coordinates = FALSE,
+  segmentations = NULL,
+  genes = NULL,
+  feature.types = NULL,
+  bpcells.dir = NULL,
