+    assert st(-0.4, -0.1, 0.0, "A", "B", 0.3, 0.2, None, "R").startswith("resolved: keep A")
+    assert st(-0.4, -0.1, 0.0, "A", "B", 0.3, 0.2, None).startswith("open")
