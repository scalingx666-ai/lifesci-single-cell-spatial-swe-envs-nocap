+dorothea_plot_heatmap <- function(
+  srt,
+  scores,
+  group.by,
+  assay_name,
+  features,
+  top_n,
+  exp_method,
+  heatmap_palette,
+  heatmap_palcolor,
+  group_palette,
+  group_palcolor,
+  heatmap_args,
+  title,
+  verbose
+) {
+  features <- dorothea_resolve_features(
+    scores = scores,
+    features = features,
