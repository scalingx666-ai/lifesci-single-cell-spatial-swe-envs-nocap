+dorothea_match_feature <- function(feature, rownames_vec) {
+  if (feature %in% rownames_vec) {
+    return(feature)
+  }
+  hit <- rownames_vec[tolower(rownames_vec) == tolower(feature)]
+  if (length(hit) == 1L) {
+    return(hit[[1L]])
+  }
+  NA_character_
+}
