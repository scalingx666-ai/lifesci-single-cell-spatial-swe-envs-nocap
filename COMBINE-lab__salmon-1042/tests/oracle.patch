+/// Reverse-complement a DNA base (ACGT, case-insensitive; anything else → N).
+#[inline]
+fn comp(b: u8) -> u8 {
+    match b {
+        b'A' | b'a' => b'T',
+        b'C' | b'c' => b'G',
+        b'G' | b'g' => b'C',
+        b'T' | b't' => b'A',
+        _ => b'N',
+    }
+}
+
 /// Reverse-complement a DNA byte slice (ACGT, case-insensitive output upper).
