-    s.iter()
-        .rev()
-        .map(|&b| match b {
-            b'A' | b'a' => b'T',
-            b'C' | b'c' => b'G',
-            b'G' | b'g' => b'C',
-            b'T' | b't' => b'A',
-            _ => b'N',
-        })
-        .collect()
+    s.iter().rev().map(|&b| comp(b)).collect()
+}
+
+/// Reverse-complement `s` into `out` (cleared first), reusing its allocation.
+#[inline]
+fn revcomp_into(s: &[u8], out: &mut Vec<u8>) {
+    out.clear();
+    out.extend(s.iter().rev().map(|&b| comp(b)));
 }
 
