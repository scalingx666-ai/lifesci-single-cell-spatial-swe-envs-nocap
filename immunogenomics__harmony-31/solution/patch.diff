+<div class=" highlight hl-r"><pre><span></span><span class="n">p3</span> <span class="o">&lt;-</span> <span class="nf">TSNEPlot</span><span class="p">(</span><span class="n">pbmc</span><span class="p">,</span> <span class="n">do.return</span> <span class="o">=</span> <span class="bp">T</span><span class="p">,</span> <span class="n">pt.size</span> <span class="o">=</span> <span class="m">0.5</span><span class="p">,</span> <span class="n">group.by</span> <span class="o">=</span> <span class="s">&quot;stim&quot;</span><span class="p">)</span>
+<span class="n">p4</span> <span class="o">&lt;-</span> <span class="nf">TSNEPlot</span><span class="p">(</span><span class="n">pbmc</span><span class="p">,</span> <span class="n">do.label</span> <span class="o">=</span> <span class="bp">T</span><span class="p">,</span> <span class="n">do.return</span> <span class="o">=</span> <span class="bp">T</span><span class="p">,</span> <span class="n">pt.size</span> <span class="o">=</span> <span class="m">0.5</span><span class="p">)</span>
+<span class="nf">plot_grid</span><span class="p">(</span><span class="n">p3</span><span class="p">,</span> <span class="n">p4</span><span class="p">)</span>
+</pre></div>
