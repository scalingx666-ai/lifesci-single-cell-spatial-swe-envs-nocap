+<h1 class="title toc-ignore">Getting Started with Harmony</h1>
+<p class="author-name">Jean Fan</p>
+<h4 class="date">2019-05-02</h4>
+
+</div>
+
+<h1>Contents</h1>
+<div id="TOC">
+<ul>
+<li><a href="#introduction"><span class="toc-section-number">0.1</span> Introduction</a></li>
+<li><a href="#installation"><span class="toc-section-number">0.2</span> Installation</a></li>
