+        "  - r-tidyverse=2.0.0",
+        "  - r-ggplot2",
+        "  - r-jsonlite",
+        "  - r-data.table",
+        "  - r-rmarkdown",
+        "  - r-knitr",
+        "  - pandoc=3.10",
+    }
+    assert required <= lines
