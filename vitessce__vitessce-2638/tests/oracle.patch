diff --git a/.changeset/fix-tiled-points-bottom-right-tile.md b/.changeset/fix-tiled-points-bottom-right-tile.md
new file mode 100644
index 0000000000..0956da1b4f
--- /dev/null
+++ b/.changeset/fix-tiled-points-bottom-right-tile.md
@@ -0,0 +1,5 @@
+---
+"@vitessce/spatial-zarr": patch
+---
+
+Fix the bottom-right tile of tiled points failing to load by clamping the row group bisection result to the final row group index.
diff --git a/packages/file-types/spatial-zarr/src/parquet-query-utils.js b/packages/file-types/spatial-zarr/src/parquet-query-utils.js
index f4ff22d56a..956d805e99 100644
--- a/packages/file-types/spatial-zarr/src/parquet-query-utils.js
+++ b/packages/file-types/spatial-zarr/src/parquet-query-utils.js
@@ -435,7 +435,11 @@ async function _bisectRowGroupsRight({ queryClient, store }, parquetPath, column
           lo = mid + 1;
         }
       }
-      return lo;
+      // If targetValue is greater than the max value of every row group
+      // (e.g., the final morton code of the bottom-right tile),
+      // lo will equal totalNumRowGroups, which is out of bounds.
+      // Clamp to the index of the final row group.
+      return Math.min(lo, totalNumRowGroups - 1);
     },
     meta: { queryClient, store },
   });
