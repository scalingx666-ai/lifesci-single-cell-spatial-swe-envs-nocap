+    try:
+        from Bio import SeqIO
+    except ImportError as exc:                                    # pragma: no cover
+        raise ImportError(
+            "reading .ab1 without tracy needs Biopython (`pip install biopython`), "
+            f"or install tracy. {_TRACY_HINT}"
+        ) from exc
