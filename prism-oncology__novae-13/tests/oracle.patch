+        if reference in adata.obs[Keys.SLIDE_ID].cat.categories:
+            return adata[adata.obs[Keys.SLIDE_ID] == reference]
+
+    raise ValueError(f"Did not found slide id `{reference}` in the provided AnnData object(s).")
