+
+tiss@meta.data[,'free_annotation'] <- plyr::mapvalues(x = tiss@meta.data$cluster.ids, from = cluster.ids, to = free_annotation)
 
 stash_annotations(tiss, cluster.ids, free_annotation, cell_ontology_class)
