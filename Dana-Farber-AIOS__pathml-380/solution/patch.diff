+
     extractor = DeepPatchFeatureExtractor(
         patch_size=patch_size,
         batch_size=1,
         entity=entity,
-        architecture="resnet34",
+        architecture=model,
         fill_value=255,
         resize_size=224,
         threshold=threshold,
@@ -66,7 +103,6 @@ def test_feature_extractor(entity, patch_size, threshold):
     features = extractor.process(image, instance_map)
 
