+    let constant = quantify_rad(&opts, &rad).unwrap();
+    assert!(
+        constant
+            .eff_lengths
+            .iter()
+            .all(|&e| e == salmon_model::NO_LENGTH_CORRECTION_EFF_LEN),
+        "with --noLengthCorrection every effective length is the same constant: {:?}",
+        constant.eff_lengths
