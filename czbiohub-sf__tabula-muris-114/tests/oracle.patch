-<p>Process the raw data and load it into the Seurat object.</p>
-<!-- rnb-text-end -->
-<!-- rnb-chunk-begin -->
-<!-- rnb-source-begin  -->
-<pre class="r"><code># Find ERCC's, compute the percent ERCC, and drop them from the raw data.
-erccs &lt;- grep(pattern = &quot;^ERCC-&quot;, x = rownames(x = raw.data), value = TRUE)
-percent.ercc &lt;- Matrix::colSums(raw.data[erccs, ])/Matrix::colSums(raw.data)
-ercc.index &lt;- grep(pattern = &quot;^ERCC-&quot;, x = rownames(x = raw.data), value = FALSE)
-raw.data &lt;- raw.data[-ercc.index,]
-# Create the Seurat object with all the data
-tiss &lt;- CreateSeuratObject(raw.data = raw.data, project = tissue_of_interest, 
-                    min.cells = 5, min.genes = 5)
-tiss &lt;- AddMetaData(object = tiss, meta.data)
-tiss &lt;- AddMetaData(object = tiss, percent.ercc, col.name = &quot;percent.ercc&quot;)
-# Change default name for sums of counts from nUMI to nReads
-# colnames(tiss@meta.data)[colnames(tiss@meta.data) == 'nUMI'] &lt;- 'nReads'
-# Create metadata columns for cell_ontology_classs and subcell_ontology_classs
-tiss@meta.data[,'cell_ontology_class'] &lt;- NA
-tiss@meta.data[,'subcell_ontology_class'] &lt;- NA</code></pre>
-<!-- rnb-source-end -->
-<!-- rnb-chunk-end -->
