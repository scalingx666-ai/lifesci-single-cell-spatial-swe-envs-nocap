+
+    async def three_starts() -> list[float]:
+        pacer, started = app._StartPacer(15.0), []
+        for _ in range(3):
+            await pacer.wait()
+            started.append(clock.now)
+            clock.advance(4.0)
+        return started
+
+    assert app.asyncio.run(three_starts()) == [1_000.0, 1_015.0, 1_030.0]
