+    lock, running, peak = threading.Lock(), [0], [0]
+
+    def run_dataset(record, request, storage, progress, check):
+        with lock:
+            running[0] += 1
+            peak[0] = max(peak[0], running[0])
+        try:
+            return _succeed(record, request, storage, progress, check)
+        finally:
+            with lock:
+                running[0] -= 1
