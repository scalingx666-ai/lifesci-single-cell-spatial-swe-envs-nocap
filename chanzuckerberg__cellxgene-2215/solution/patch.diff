--- /dev/null
+++ b/client/src/components/datasetSelector/datasetSelector.css
@@ -0,0 +1,32 @@
+:local(.datasetBreadcrumb),
+:local(.datasetDisabledBreadcrumb) {
+  font-size: 14px;
+}
+
+:local(.datasetBreadcrumb):hover,
+:local(.datasetBreadcrumb):global(.bp3-active) {
+  color: #10161A; /* Colors.BLACK */ /* TODO(cc) revisit variable specification */
+}
+
+:local(.datasetDisabledBreadcrumb) :global(.bp3-icon) {
+  display: none;
+}
+
+:local(.datasetPopoverTarget) {
+  cursor: pointer;
+}
+
+:local(.datasetPopover) {
+  box-shadow: 0 8px 24px 0 rgba(16, 22, 26, 0.2), 0 2px 4px 0 rgba(16, 22, 26, 0.2), 0 0 0 0 rgba(16, 22, 26, 0.1);
+}
+
+:local(.datasetMenuScrollable):global(::-webkit-scrollbar) {
+  width: 14px; /* 5px left and right, 4px track */
+}
+
+:local(.datasetMenuScrollable):global(::-webkit-scrollbar-thumb) {
+  background-clip: content-box;
+  background-color: #CED9E0; /* Colors.LIGHT_GRAY1 */ /* TODO(cc) revisit variable specification */
+  border: 5px solid transparent;
+  border-radius: 14px;
+}
