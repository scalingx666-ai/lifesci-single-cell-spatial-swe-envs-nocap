+                np.array([0, 0, 0, 0]),
+            ),
+            (
+                np.array([[1, 2, 3, np.nan], [1, 2, np.inf, 3], [2, -np.inf, 1, 3]]),
+                np.array([4 / 3, 2, 2, 3]),
+                np.array([1 / 3, 0, 2, 0]),
+            ),
+        ),
+    )
+    @pytest.mark.parametrize("sparse_format", (csr_matrix, csc_matrix))
+    def test_sparse_with_nan_and_inf_entries(
