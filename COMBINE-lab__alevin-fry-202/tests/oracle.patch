+        assert_eq!(u32s("n_umis"), [1, 2, 1]);
+        let cands = batch
+            .column_by_name("candidate_features")
+            .unwrap()
+            .as_list::<i32>();
+        assert!(cands.is_null(0) && cands.is_null(2));
+        let c1 = cands.value(1);
