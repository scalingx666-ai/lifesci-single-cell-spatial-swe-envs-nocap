+        let samples = vec!["s0".to_string(), "s1".to_string()];
+        let out = Arc::new(
+            MoleculeTableWriter::create(
+                &path,
+                Some(&samples),
+                FeatureLabeler::new(names(&["g0", "g1", "g2"]), false),
+                4,
