 // [[Rcpp::export]]
 bool hdf5_group_exists_cpp(std::string path, std::string group) {
+    // Only check for group if the path itself exists
+    if (!std::filesystem::exists(path)) {
+        return false;
+    }
     H5ReaderBuilder rb(path, "/", 1);
     return rb.getGroup().exist(group);
 }
