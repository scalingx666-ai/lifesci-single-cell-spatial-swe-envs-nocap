+def test_finite_difference_matches_legacy_scipy_when_available():
+    from omicverse.external._finite_difference import derivative
+    for n in (1, 2):
+        assert derivative(lambda x: x*x, 3, n=n) == (6 if n == 1 else 2)
+        try:
