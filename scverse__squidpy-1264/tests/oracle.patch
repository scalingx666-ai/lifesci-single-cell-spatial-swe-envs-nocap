-run.branch = true
+run.source = [ "squidpy" ]
 run.omit = [
   "*/__init__.py",
   "*/_version.py",
   "tox/*",
 ]
+run.branch = true
 run.parallel = true
-run.source = [ "squidpy" ]
 paths.source = [
   "squidpy",
   "*/site-packages/squidpy",
 ]
+report.precision = 2
 report.exclude_lines = [
   "\\#.*pragma:\\s*no.?cover",
   "^\\s*raise AssertionError\\b",
@@ -309,9 +310,8 @@ report.exclude_lines = [
