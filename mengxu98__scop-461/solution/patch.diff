+    assay = "RNA", npcs = 5L, verbose = FALSE
+  )
+  actual <- RunPCA(unnamed,
+    assay = "RNA", npcs = 5L, feature.names = rownames(x),
+    cell.names = colnames(x), verbose = FALSE
+  )
