diff --git a/tests/single/test_cytotrace_input.py b/tests/single/test_cytotrace_input.py
new file mode 100644
index 000000000..571e820f4
--- /dev/null
+++ b/tests/single/test_cytotrace_input.py
@@ -0,0 +1,21 @@
+import sys
+import types
+import numpy as np
+import pandas as pd
+from anndata import AnnData
+
+
+def test_cytotrace_receives_counts_and_gene_identifiers(monkeypatch):
+    from omicverse.single._traj import TrajInfer
+    a = AnnData(np.zeros((3,12)), var=pd.DataFrame(index=['ERCC-control']+[f'g{i}' for i in range(11)]))
+    a.layers['counts'] = np.arange(36).reshape(3,12)
+    seen = {}
+    def backend(matrix, **kwargs):
+        seen.update(matrix=matrix, **kwargs)
+        return types.SimpleNamespace(cytotrace=np.array([0.,.5,1.]))
+    monkeypatch.setitem(sys.modules, 'pycytotrace', types.SimpleNamespace(cytotrace_run=backend))
+    TrajInfer(a).inference(method='cytotrace')
+    np.testing.assert_array_equal(seen['matrix'], a.layers['counts'].T)
+    assert seen['gene_names'] == list(a.var_names)
+    assert seen['cell_names'] == list(a.obs_names)
+    np.testing.assert_array_equal(a.obs['cytotrace_pseudotime'],[1.,.5,0.])
diff --git a/tests/space/test_split_receivers.py b/tests/space/test_split_receivers.py
new file mode 100644
index 000000000..b370dd39f
--- /dev/null
+++ b/tests/space/test_split_receivers.py
@@ -0,0 +1,20 @@
+import numpy as np
+import pandas as pd
+from anndata import AnnData
+from scipy import sparse
+from omicverse import space as splitst
+
+
+def test_residuals_only_reach_non_rejected_second_type_neighbors():
+    a = AnnData(np.array([[10.], [3.], [4.], [5.]]))
+    a.layers['counts'] = a.X.copy()
+    a.layers['split_balanced'] = np.array([[6.], [3.], [4.], [5.]])
+    a.obsm['spatial'] = np.array([[0., 0.], [1., 0.], [0., 1.], [1., 1.]])
+    a.obs['first_type'] = ['A', 'B', 'B', 'A']
+    a.obs['second_type'] = ['B', 'A', 'A', 'B']
+    a.obs['spot_class'] = ['singlet', 'singlet', 'reject', 'singlet']
+    splitst.split_reassign_residuals(a, k=3, mode='uniform')
+    np.testing.assert_allclose(a.layers['split_reassigned'].toarray().ravel(), [6, 7, 4, 5])
+    np.testing.assert_allclose(a.uns['split_reassignment_operator'].toarray()[0], [0, 1, 0, 0])
+    splitst.split_reassign_residuals(a, k=3, mode='uniform', receiver_policy='all')
+    np.testing.assert_allclose(a.uns['split_reassignment_operator'].toarray()[0], [0, 1/3, 1/3, 1/3])
