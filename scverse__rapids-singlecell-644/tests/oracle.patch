+    assert cp.max(cp.abs(r_c - r_g)).item() < 1e-4
+    assert cp.abs(ll_c - ll_g).item() < 1e-4
+    assert cp.max(cp.abs(r_c - r_f)).item() < 1e-4
+    assert cp.abs(ll_c - ll_f).item() < 1e-4
