+import pytest
+from cupyx.scipy.special import logsumexp
+from sklearn.metrics import adjusted_rand_score as ARI
+from sklearn.mixture import GaussianMixture
+
+from rapids_singlecell.squidpy_gpu._gmm import (
+    _choose_e_step,
+    _e_step,
+    _e_step_cublas,
+    _e_step_fused,
+    _m_step,
+    _precision_cholesky,
+    gmm_fit_predict,
+)
