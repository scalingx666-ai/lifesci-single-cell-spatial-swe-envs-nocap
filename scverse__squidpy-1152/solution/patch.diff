+def hed_metrics(block: np.ndarray) -> np.ndarray:
+    """Return all HED-derived metrics for one RGB tile."""
+    hed = rgb_to_hed(block)
+    h = hed[..., 0]
+    e = hed[..., 1]
+
+    return np.array(
+        [
+            [
+                [
+                    float(h.mean()),
+                    float(h.std()),
+                    float(e.mean()),
+                    float(e.std()),
+                    float(np.abs(h).mean() / (np.abs(e).mean() + 1e-10)),
+                ]
+            ]
+        ],
+        dtype=np.float32,
+    )
 
 
