+<span id="cb2-19"><a href="#cb2-19" tabindex="-1"></a>  <span class="fu">mutate</span>(</span>
+<span id="cb2-20"><a href="#cb2-20" tabindex="-1"></a>    <span class="at">Metric     =</span> <span class="fu">ordered</span>(metric, <span class="at">levels =</span> <span class="fu">c</span>(<span class="st">&quot;nCount&quot;</span>, <span class="st">&quot;nFeature&quot;</span>, <span class="st">&quot;nCount_to_nFeature&quot;</span>)),</span>
+<span id="cb2-21"><a href="#cb2-21" tabindex="-1"></a>    <span class="at">Experiment =</span> <span class="fu">ordered</span>(Experiment, <span class="at">levels =</span> <span class="fu">c</span>(<span class="st">&quot;Xenium&quot;</span>, <span class="st">&quot;ATERA&quot;</span>, <span class="st">&quot;Chromium&quot;</span>))</span>
