+<span id="cb2-6"><a href="#cb2-6" tabindex="-1"></a>    <span class="fu">select</span>(<span class="at">nCount =</span> nCount_Xenium, <span class="at">nFeature =</span> nFeature_Xenium) <span class="sc">%&gt;%</span></span>
+<span id="cb2-7"><a href="#cb2-7" tabindex="-1"></a>    <span class="fu">mutate</span>(<span class="at">Experiment =</span> <span class="st">&quot;Xenium&quot;</span>),</span>
