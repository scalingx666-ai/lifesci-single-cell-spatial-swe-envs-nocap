+% Generated documentation for ATAC extensions
+\name{RunATACCoaccessibility}
+\alias{RunATACCoaccessibility}
+\title{Infer coaccessibility using native Cicero}
+\usage{
+RunATACCoaccessibility(object, genome.sizes, genome.id, assay = NULL,
+  reduction = "lsi", dims = 2:30, k = 50L, window = 500000L,
+  sample.num = 100L, seed = 1L,
+  result.name = "scop_coaccessibility", verbose = TRUE)
+}
+\arguments{
+\item{object}{Seurat object with ATAC counts.}
+\item{genome.sizes}{Named positive integer chromosome lengths for the explicit reference.}
+\item{genome.id}{Verified reference label matching assay.}
+\item{assay}{Chromatin assay.}
+\item{reduction}{Existing embedding covering all assay cells.}
+\item{dims}{Unique embedding dimensions.}
+\item{k}{Cells per aggregate, at least 2 and less than cell count.}
+\item{window}{Native window size greater than 250000.}
+\item{sample.num}{Number of windows for distance estimation.}
+\item{seed}{Local seed; caller RNG restored.}
+\item{result.name}{Unused assay Misc key.}
+\item{verbose}{Print native progress.}
+}
+\value{Seurat object with native connection table, aggregate membership and provenance in assay Misc. Native Links and source assays are unchanged.}
+\description{Infer coaccessibility using native Cicero.}
+\details{Requires official monocle3-compatible Cicero and monocle3. Native binary-accessibility aggregation, size-factor normalization and distance-penalized graphical modelling are used, without a correlation fallback. Native NA scores and model errors are preserved. Small contigs or inadequate peaks may not support estimation. These associations do not establish physical interactions or causal regulation.}
diff --git a/tests/testthat/test-atac-cicero-native.R b/tests/testthat/test-atac-cicero-native.R
new file mode 100644
index 000000000..a5c3e8e46
--- /dev/null
+++ b/tests/testthat/test-atac-cicero-native.R
@@ -0,0 +1,37 @@
+# Optional synthetic integration acceptance; no mocked estimation backends.
+# Run with SCOP_RUN_NATIVE_CICERO=true and official monocle3-compatible Cicero.
+# This verifies native parity, not biological validity or real-data performance.
+test_that("coaccessibility agrees exactly with native Cicero on synthetic data", {
+  skip_if(Sys.getenv("SCOP_RUN_NATIVE_CICERO") != "true", "opt-in native Cicero integration test")
+  for (pkg in c("Signac", "monocle3", "cicero", "withr")) skip_if_not_installed(pkg)
+  dependencies <- paste(utils::packageDescription("cicero")[c("Imports", "Depends")], collapse = " ")
+  skip_if(!grepl("monocle3", dependencies, fixed = TRUE), "requires official monocle3-compatible Cicero")
+  withr::local_preserve_seed()
+  set.seed(712)
+  n <- 96L; p <- 240L
+  ranges <- GenomicRanges::GRanges('chr1', IRanges::IRanges(seq(10001L, 2390001L, length.out=p),width=200L))
+  GenomeInfoDb::genome(ranges) <- 'synthetic'; GenomeInfoDb::seqlengths(ranges) <- c(chr1=2500000L)
+  counts <- Matrix::Matrix(matrix(rbinom(n*p, 2L, .25),p,n,dimnames=list(paste0('peak',seq_len(p)),paste0('cell',seq_len(n)))),sparse=TRUE)
+  assay <- Signac::CreateChromatinAssay(counts=counts,ranges=ranges,genome=GenomeInfoDb::seqinfo(ranges))
+  x <- SeuratObject::CreateSeuratObject(assay,assay='peaks')
+  coords <- matrix(rnorm(n*2L),n,2L,dimnames=list(colnames(x),c('LSI_1','LSI_2')))
+  x[['lsi']] <- SeuratObject::CreateDimReducObject(coords,key='LSI_',assay='peaks')
+  original <- serialize(x,NULL)
+  set.seed(12); rng <- .Random.seed
+  out <- RunATACCoaccessibility(x,c(chr1=2500000L),'synthetic',dims=1:2,k=8L,sample.num=4L,seed=42L,verbose=FALSE)
+  expect_identical(rng, .Random.seed)
+  expect_identical(original, serialize(x, NULL))
+  receipt <- SeuratObject::Misc(out[['peaks']],'scop_coaccessibility')
+  binary <- Matrix::drop0(SeuratObject::GetAssayData(x[['peaks']],layer='counts')); binary@x[] <- 1
+  metadata <- data.frame(gene_short_name=rownames(binary),chr='chr1',bp1=GenomicRanges::start(ranges),bp2=GenomicRanges::end(ranges),row.names=rownames(binary))
+  set.seed(42L)
+  cds <- monocle3::new_cell_data_set(binary,cell_metadata=data.frame(row.names=colnames(binary)),gene_metadata=metadata)
+  agg <- cicero::make_cicero_cds(cds,reduced_coordinates=coords,k=8L,size_factor_normalize=TRUE,silent=TRUE,return_agg_info=TRUE)
+  direct <- cicero::run_cicero(agg[[1L]],genomic_coords=data.frame(chromosome='chr1',length=2500000),window=500000L,sample_num=4L,silent=TRUE)
+  expect_identical(receipt$connections, direct)
+  expect_identical(receipt$aggregation, agg[[2L]])
+  expect_gt(nrow(direct), 0L)
+  expect_true(any(is.finite(direct$coaccess)))
+  expect_true(all(receipt$connections$Peak1 %in% rownames(binary)))
+  expect_true(all(receipt$connections$Peak2 %in% rownames(binary)))
+})
diff --git a/tests/testthat/test-atac-coaccessibility.R b/tests/testthat/test-atac-coaccessibility.R
new file mode 100644
index 000000000..cd2afddda
--- /dev/null
+++ b/tests/testthat/test-atac-coaccessibility.R
@@ -0,0 +1,69 @@
+make_atac_coaccessibility_fixture <- function() {
+  skip_if_not_installed("Signac")
+  counts <- Matrix::Matrix(matrix(c(1, 2, 3, 4, 2, 3, 4, 5, 3, 2, 5, 4), 3, 4,
+    dimnames = list(paste0("p", 1:3), paste0("c", 1:4))), sparse = TRUE)
+  ranges <- GenomicRanges::GRanges("chr1", IRanges::IRanges(c(1000, 2000, 3000), width = 100))
+  x <- ReadATACData(counts, ranges = ranges, genome = "toy", verbose = FALSE)
+  coords <- matrix(c(1, 2, 3, 4, 2, 5, 3, 6), 4, 2,
+    dimnames = list(colnames(x), c("LSI_1", "LSI_2")))
+  x[["lsi"]] <- SeuratObject::CreateDimReducObject(coords, key = "LSI_", assay = "peaks")
+  x
+}
+
+
+test_that("coaccessibility validates reference, embedding and result ownership before fitting", {
+  x <- make_atac_coaccessibility_fixture()
+  expect_error(RunATACCoaccessibility(x, c(chr2 = 1000000), "toy", dims = 1:2, k = 2), "cover source peaks")
+  expect_error(RunATACCoaccessibility(x, c(chr1 = 1000000), "wrong", dims = 1:2, k = 2), "genome|reference")
+  expect_error(RunATACCoaccessibility(x, c(chr1 = 1000000), "toy", dims = 3, k = 2), "dims")
+  expect_error(RunATACCoaccessibility(x, c(chr1 = 1000000), "toy", dims = 1:2, k = 4), "k < cell")
+  expect_error(RunATACCoaccessibility(x, c(chr1 = 1000000), "toy", dims = 1:2, k = 2, window = 100000), "window >")
+  expect_error(RunATACCoaccessibility(x, c(chr1 = 1000000, `1` = 1000000), "toy", dims = 1:2, k = 2), "collide")
+  SeuratObject::Misc(x[["peaks"]], "scop_coaccessibility") <- list(existing = TRUE)
+  expect_error(RunATACCoaccessibility(x, c(chr1 = 1000000), "toy", dims = 1:2, k = 2), "unused")
+})
+
+test_that("coaccessibility dispatch preserves sparse binary data, order and native NA scores", {
+  x <- make_atac_coaccessibility_fixture()
+  original <- serialize(x, NULL)
+  calls <- new.env()
+  fake_new <- function(expression_data, cell_metadata, gene_metadata) {
+    calls$counts <- expression_data
+    calls$genes <- gene_metadata
+    expression_data
+  }
+  fake_aggregate <- function(cds, reduced_coordinates, k, size_factor_normalize, silent, return_agg_info) {
+    calls$coords <- reduced_coordinates
+    expect_true(return_agg_info)
+    list(cds[, 1:2, drop = FALSE], data.frame(cell = colnames(cds), bin = c(1, 1, 2, 2)))
+  }
+  fake_run <- function(cds, genomic_coords, window, sample_num, silent) {
+    data.frame(Peak1 = rownames(cds)[1], Peak2 = rownames(cds)[2], coaccess = NA_real_)
+  }
+  old <- atac_backend_fun
+  local_mocked_bindings(atac_backend_fun = function(package, fun) {
+    if (package == "monocle3") return(fake_new)
+    if (package == "cicero" && fun == "make_cicero_cds") return(fake_aggregate)
+    if (package == "cicero" && fun == "run_cicero") return(fake_run)
+    old(package, fun)
+  })
+  original_description <- utils::packageDescription
+  original_version <- utils::packageVersion
+  local_mocked_bindings(
+    packageDescription = function(pkg, ...) if (pkg == "cicero") list(Imports = "monocle3") else original_description(pkg, ...),
+    packageVersion = function(pkg, ...) if (pkg %in% c("cicero", "monocle3")) numeric_version("1.0.0") else original_version(pkg, ...),
+    .package = "utils")
+  set.seed(123)
+  rng <- .Random.seed
+  out <- RunATACCoaccessibility(x, c(chr1 = 1000000), "toy", dims = 1:2, k = 2)
+  expect_identical(.Random.seed, rng)
+  expect_identical(serialize(x, NULL), original)
+  expect_true(inherits(calls$counts, "sparseMatrix"))
+  expect_true(all(calls$counts@x == 1))
+  expect_identical(rownames(calls$coords), colnames(x))
+  expect_identical(calls$genes$bp1, c(1000L, 2000L, 3000L))
+  receipt <- SeuratObject::Misc(out[["peaks"]], "scop_coaccessibility")
+  expect_true(is.na(receipt$connections$coaccess))
+  expect_identical(SeuratObject::DefaultAssay(out), SeuratObject::DefaultAssay(x))
+  expect_identical(Signac::Links(out[["peaks"]]), Signac::Links(x[["peaks"]]))
+})
