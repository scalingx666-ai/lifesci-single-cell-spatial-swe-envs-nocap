+        resolved = resolve_labels_array(sdata, "labels", "scale1")
+
+        def _affine(elem):
+            t = next(iter(get_transformation(elem, get_all=True).values()))
+            return t.to_affine_matrix(("y", "x"), ("y", "x"))
