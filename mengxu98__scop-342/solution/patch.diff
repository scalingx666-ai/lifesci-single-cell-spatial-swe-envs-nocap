+        _write_json(manifest, staged["manifest"])
+        staged["complete"].write_text("complete\n", encoding="utf-8")
+        _publish_staged_outputs(
+            staged,
+            final=paths,
+            result_dir=result_dir,
+            lock_token=lock_token,
+        )
 
 
