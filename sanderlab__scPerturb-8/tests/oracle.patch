+#Function for creating a sparse confusion matrix
+createSpMat <- function(i,j){
+  ui <- unique(i)
+  uj <- unique(j)
+  m <- Matrix::sparseMatrix(
+    i = match(i, ui),
+    j = match(j, uj),
+    x = rep(1, length(i)),
+    dims = c(length(ui), length(uj))
+  )
+  rownames(m) <- ui
+  colnames(m) <- uj
+  m
+}
