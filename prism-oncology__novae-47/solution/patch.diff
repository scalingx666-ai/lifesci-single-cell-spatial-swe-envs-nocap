+def store_inference_mode(adatas: AnnData | list[AnnData], zero_shot: bool):
+    if isinstance(adatas, AnnData):
+        adatas = [adatas]
+
+    for adata in adatas:
+        adata.uns[Keys.NOVAE_UNS] = adata.uns.get(Keys.NOVAE_UNS, {})
+        adata.uns[Keys.NOVAE_UNS]["zero_shot"] = zero_shot
