+bool KmerIndex::fwStep(Kmer km, Kmer& end, int ec) const {
+  int j = -1;
+  int fw_count = 0;
+  for (int i = 0; i < 4; i++) {
+    Kmer fw_rep = end.forwardBase(Dna(i)).rep();
+    auto search = kmap.find(fw_rep);
+    if (search != kmap.end()) {
+      if (search->second.id != ec) {
+        return false;
+      }
+      j = i;
+      ++fw_count;
+      if (fw_count > 1) {
+        return false;
+      }
+    }
+  }
+
+  if (fw_count != 1) {
+    return false;
+  }
+
+  Kmer fw = end.forwardBase(Dna(j));
+
+  int bw_count = 0;
+  for (int i = 0; i < 4; i++) {
+    Kmer bw_rep = fw.backwardBase(Dna(i)).rep();
+    if (kmap.find(bw_rep) != kmap.end()) {
+      ++bw_count;
+      if (bw_count > 1) {
+        return false;
+      }
+    }
+  }
+
+  if (bw_count != 1) {
+    return false;
+  } else {
+    if (fw != km) {
+      end = fw;
+      return true;
+    } else {
+      return false;
+    }
+  }
+
+}
 
