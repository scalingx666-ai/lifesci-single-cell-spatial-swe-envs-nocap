+            Bootstrap bs(collection.counts, index.ecmap,
+                         index.target_names_, eff_lens, seeds[b]);
+            std::cerr << "Running EM bootstrap: " << b << std::endl;
+            auto res = bs.run_em();
+            res.write( opt.output + "/bs_expression_" + std::to_string(b) +
+                       ".txt");
+          }
 
         }
