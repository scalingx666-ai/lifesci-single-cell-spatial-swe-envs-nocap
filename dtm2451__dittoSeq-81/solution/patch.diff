+```{r, results = "hold"}
+# dittoFreqPlot
+sce$mock.donor.group <- ifelse(sce$donor %in% unique(sce$donor)[1:2], "A", "B")
+dittoFreqPlot(sce, "label",
+    sample.by = "donor", group.by = "mock.donor.group")
+```
