+<p>Check expression of genes of interset.</p>
+<!-- rnb-text-end -->
+<!-- rnb-chunk-begin -->
+<!-- rnb-source-begin eyJkYXRhIjoiYGBgclxuZ2VuZXNfdG9fY2hlY2sgPSBjKCdNeWgxMScsJ0RjbicpXG5GZWF0dXJlUGxvdChzdWJ0aXNzLCBnZW5lc190b19jaGVjaywgcHQuc2l6ZSA9IDEpXG5gYGAifQ== -->
