+
+        graph = knn_to_csr_matrix(self.z[knn_loc].indices, self.z[knn_loc].distances)
+        hvg_data = self.z[knn_loc.rsplit("/", 3)[0] + "/data"]
+        scores = silhouette_scoring(
+            self, ann_obj, graph, hvg_data, from_assay, res_label
+        )
+        return scores
