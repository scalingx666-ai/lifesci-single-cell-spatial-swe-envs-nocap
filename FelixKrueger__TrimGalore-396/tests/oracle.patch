+            "a/reads.fq",
+            "b/reads.fq",
+        ],
+    );
+    assert_rejected_cleanly(&out, ok, &stderr, DUP_MSG);
+    assert!(
+        stderr.contains("reads.fq_clumping_report.txt"),
+        "with --basename the reports are the only possible collision:\n{stderr}"
+    );
+}
