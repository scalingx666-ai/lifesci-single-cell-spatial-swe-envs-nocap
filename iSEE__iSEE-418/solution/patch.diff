     seUI=function(id) selectInput(id, "Dataset:", choices=all.data),
     seLoad=function(x) get(x, as.environment("package:scRNAseq"))()
 )
 
-app <- iSEE(landingPage=FUN)
+app <- iSEE(landingPage=lpfun)
 if (interactive()) {
   shiny::runApp(app, port=1234)
 }
