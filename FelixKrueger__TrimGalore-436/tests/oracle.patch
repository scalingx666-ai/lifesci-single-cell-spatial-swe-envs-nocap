+        let bytes = std::fs::read(&path).unwrap();
+        assert_eq!(&bytes[..3], &[0x1f, 0x8b, 0x08], "gzip magic + deflate");
+        // 8-byte CRC32 + ISIZE trailer, both zero for an empty member.
+        assert_eq!(&bytes[bytes.len() - 8..], &[0u8; 8]);
+    }
