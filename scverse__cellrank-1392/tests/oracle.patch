+[tool.pixi]
+# PETSc/SLEPc and R's mgcv have no PyPI wheels; this environment takes them from conda-forge: `pixi run -e krylov test`.
+# Not named `petsc` or `r`: pixi turns those extras into features that would install from PyPI.
+workspace.channels = [ "conda-forge" ]
+workspace.platforms = [ "linux-64" ]
+dependencies.python = "3.12.*"
+pypi-dependencies.cellrank = { path = ".", editable = true, extras = [ "plot" ] }
+feature.krylov.dependencies = { petsc4py = "*", slepc4py = "*", rpy2 = ">=3.3", r-mgcv = "*" }
+# one BLAS thread: conda-forge BLAS otherwise oversubscribes cores; PETSc must not catch xdist workers' SIGPIPE
+feature.krylov.tasks.test = { cmd = "pytest", env = { OMP_NUM_THREADS = "1", MPLBACKEND = "agg", PETSC_OPTIONS = "-no_signal_handler" } }
+environments.krylov = [ "krylov", "test" ]
+
 [tool.uv]
 # Include test deps in `uv sync` so local dev has them (e.g. adjusttext, pytest)
 default-groups = [ "dev", "test" ]
-# pygpcca 1.0.4 incorrectly pins jinja2==3.0.3; override until next release
-override-dependencies = [ "jinja2>=3.1" ]
 
