+      grouping.var = "groups",
+      meta.method = stored.method,
+      verbose = FALSE,
+      base = exp(1),
+      pseudocount.use = 1
+    ))
+
+    expect_true("sumlog_p_val" %in% colnames(x = markers.sumlog))
