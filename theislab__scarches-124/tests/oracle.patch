+    ds = trVAEDataset(adata, condition_key='study', condition_encoder=condition_encoder)
+    batch = ds[10:100]
+
+    assert set(['x', 'labeled', 'sizefactor', 'batch']).issubset(batch.keys())
+    assert torch.allclose(batch['x'].sum(1), batch['sizefactor'])
