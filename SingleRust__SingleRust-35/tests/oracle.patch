+//! let hvg_genes: Vec<_> = hvg_mask.into_iter()
+//!     .enumerate()
+//!     .filter_map(|(i, is_hvg)| if is_hvg.unwrap_or(false) { Some(i) } else { None })
+//!     .collect();
