+<!-- rnb-text-begin -->
+<p>Load the read count data.</p>
+<!-- rnb-text-end -->
+<!-- rnb-chunk-begin -->
+<!-- rnb-source-begin  -->
+<pre class="r"><code># Load the gene names and set the metadata columns by opening the first file
+filename = here('00_data_ingest', '00_facs_raw_data', 'FACS', paste0(tissue_of_interest, '-counts.csv'))
+raw.data = read.csv(filename, sep=&quot;,&quot;, row.names=1)
+corner(raw.data)</code></pre>
