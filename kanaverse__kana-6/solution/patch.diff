+vizutils.extractXY = function(buffer) {
+  var nobs = buffer.size / 2;
+  var x = new Float64Array(nobs);
+  var y = new Float64Array(nobs);
+  var buf = buffer.array();
+
+  for (var i = 0; i < nobs; i++) {
+    x[i] = buf[2*i];
+    y[i] = buf[2*i + 1];
+  }
