+function filterCells(wasm, args) {
+  var step = "quality_control_filtered";
+  return utils.runStep(step, args, ["quality_control_thresholds"], () => {
+    var qcf_cache = utils.initCache(step);
+    utils.freeCache(qcf_cache["raw"]);
