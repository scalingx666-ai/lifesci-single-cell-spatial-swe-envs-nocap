+def _score_permutations(
+    data: NDArrayA,
+    clustering: NDArrayA,
+    generators: list[np.random.Generator],
+    inv_counts: NDArrayA,
+    mean_obs: NDArrayA,
+    interactions: NDArrayA,
+    interaction_clusters: NDArrayA,
+    valid: NDArrayA,
+    progress: ProgressBar,
