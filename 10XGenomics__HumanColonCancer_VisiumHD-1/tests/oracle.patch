+  Result<-GetSlice(SelectedBCs$barcode,distance,bcs,PATH,CellT=CellType)
+  
+  if(length(distance)>1)
+  {
+    for(jj in 1:length(Result))
+    {
+      Result[[jj]]<-Result[[jj]][Result[[jj]]%!in%SelectedBCs$barcode]
+    }
