+  
+  PlotX<-DF %>% filter(tissue == "1") %>% na.omit() %>% 
+    ggplot(aes(x = imagecol_scaled, y = -imagerow_scaled)) +
+    geom_scattermore(pointsize = ptsize,pixels = rep(2000,2),col="lightgray")+
