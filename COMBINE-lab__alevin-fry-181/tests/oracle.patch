+    let multiplier = match suffix.trim().to_ascii_lowercase().as_str() {
+        "" | "b" => 1_u64,
+        "k" | "kb" => 1_000,
+        "ki" | "kib" => 1_u64 << 10,
+        "m" | "mb" => 1_000_000,
+        "mi" | "mib" => 1_u64 << 20,
+        "g" | "gb" => 1_000_000_000,
+        "gi" | "gib" => 1_u64 << 30,
