+@functools.lru_cache()
+def get_sha():
+    repo = git.Repo(pathlib.Path(openproblems.__path__[0]).parent)
+    assert not repo.bare
+    return repo.head.commit.hexsha
+
+
 def task_is_incomplete(task):
