diff --git a/modules/local/scanpy/filter/tests/empty_panel.nf.test b/modules/local/scanpy/filter/tests/empty_panel.nf.test
new file mode 100644
index 00000000..71ec65ae
--- /dev/null
+++ b/modules/local/scanpy/filter/tests/empty_panel.nf.test
@@ -0,0 +1,57 @@
+nextflow_process {
+
+    name "Test SCANPY_FILTER empty gene panel"
+    script "modules/local/scanpy/filter/main.nf"
+    process "SCANPY_FILTER"
+
+    tag "modules"
+    tag "modules_local"
+
+    setup {
+        run("SCANPY_HVGS") {
+            script "modules/local/scanpy/hvgs/main.nf"
+            process {
+                """
+                input[0] = channel.of([
+                    [id: 'empty'],
+                    file(params.pipelines_testdata_base_path + '/anndata-variations/counts_in_X.h5ad', checkIfExists: true)
+                ])
+                input[1] = 10
+                input[2] = channel.of((0..<128).collect { String.format('GENE%03d', it) }.join('\\n') + '\\n')
+                    .collectFile(name: 'excluded_genes.txt')
+                input[3] = 'X'
+                input[4] = false
+                input[5] = ''
+                """
+            }
+        }
+    }
+
+    test("Should reject zero genes with a clear error") {
+        when {
+            process {
+                """
+                input[0] = SCANPY_HVGS.out.h5ad.map { meta, h5ad -> [[id: 'qc_empty'], h5ad] }
+                input[1] = 'index'
+                input[2] = 0
+                input[3] = 0
+                input[4] = 0
+                input[5] = 0
+                input[6] = 100
+                input[7] = 0
+                input[8] = 100
+                input[9] = 0
+                input[10] = 0
+                input[11] = 0
+                input[12] = 0
+                input[13] = []
+                input[14] = false
+                """
+            }
+        }
+        then {
+            assert process.failed
+            assert process.errorReport.contains('Cannot calculate QC metrics for an empty gene panel (zero genes)')
+        }
+    }
+}
diff --git a/modules/local/scanpy/filter/tests/small_panels.nf.test b/modules/local/scanpy/filter/tests/small_panels.nf.test
new file mode 100644
index 00000000..bff9e6c5
--- /dev/null
+++ b/modules/local/scanpy/filter/tests/small_panels.nf.test
@@ -0,0 +1,94 @@
+nextflow_process {
+
+    name "Test SCANPY_FILTER small gene panels"
+    script "modules/local/scanpy/filter/main.nf"
+    process "SCANPY_FILTER"
+
+    tag "modules"
+    tag "modules_local"
+
+    setup {
+        run("ADATA_EXTEND") {
+            script "modules/local/adata/extend/main.nf"
+            process {
+                """
+                rows = (0..<128).collect { i ->
+                    String.format('GENE%03d', i) + ',' + [1, 10, 19, 20, 32].collect { n -> i < n ? 'True' : 'False' }.join(',')
+                }
+                var_fragment = channel.of('gene,panel_1,panel_10,panel_19,panel_20,panel_32\\n' + rows.join('\\n') + '\\n')
+                    .collectFile(name: 'panels.csv')
+                obs_rows = (0..<128).collect { String.format('cell_%03d,17.0', it) }
+                obs_fragment = channel.of('cell,pct_counts_in_top_20_genes\\n' + obs_rows.join('\\n') + '\\n')
+                    .collectFile(name: 'previous_qc.csv')
+                input[0] = var_fragment.combine(obs_fragment)
+                    .map { var, obs -> [
+                        [id: 'panels'],
+                        file(params.pipelines_testdata_base_path + '/anndata-variations/counts_in_X.h5ad', checkIfExists: true),
+                        [obs], [var], [], [], [], []
+                    ] }
+                """
+            }
+        }
+        run("ADATA_SUBSETVAR") {
+            script "modules/local/adata/subsetvar/main.nf"
+            process {
+                """
+                panels = ADATA_EXTEND.out.h5ad.flatMap { meta, h5ad ->
+                    [1, 10, 19, 20, 32].collect { n -> [[id: 'panel_' + n, n_genes: n], h5ad] }
+                }.multiMap { meta, h5ad ->
+                    h5ad: [meta, h5ad]
+                    column: meta.id
+                }
+                input[0] = panels.h5ad
+                input[1] = panels.column
+                """
+            }
+        }
+    }
+
+    test("Should calculate canonical top-20 metrics for 1, 10, 19, 20 and 32 genes without plots") {
+        tag "small_panel_qc"
+
+        when {
+            process {
+                """
+                input[0] = ADATA_SUBSETVAR.out.h5ad.map { meta, h5ad -> [meta + [id: 'qc_' + meta.n_genes], h5ad] }
+                input[1] = 'index'
+                input[2] = 0
+                input[3] = 0
+                input[4] = 0
+                input[5] = 0
+                input[6] = 100
+                input[7] = 'null'
+                input[8] = 'null'
+                input[9] = 0
+                input[10] = 0
+                input[11] = 0
+                input[12] = 0
+                input[13] = []
+                input[14] = false
+                """
+            }
+        }
+        then {
+            assert process.success
+            assert process.out.h5ad.size() == 5
+            assert process.out.plots.isEmpty()
+            process.out.h5ad.each { meta, h5ad ->
+                def adata = anndata(h5ad)
+                assert adata.n_vars == meta.n_genes
+                assert adata.n_obs == 128
+                assert 'pct_counts_in_top_20_genes' in adata.obs.colnames
+                assert adata.obs.colnames.toList().count('pct_counts_in_top_20_genes') == 1
+                if (meta.n_genes < 20) {
+                    assert !("pct_counts_in_top_${meta.n_genes}_genes" in adata.obs.colnames)
+                    def totals = adata.obs.get('total_counts').data
+                    def fractions = adata.obs.get('pct_counts_in_top_20_genes').data
+                    assert totals.indices.findAll { totals[it] > 0 }.every { Math.abs(fractions[it] - 100.0) < 1e-8 }
+                    assert totals.indices.findAll { totals[it] == 0 }.every { fractions[it] == null || fractions[it].toString() == 'NaN' }
+                }
+            }
+        }
+    }
+
+}
diff --git a/modules/local/scanpy/filter/tests/small_panels_plot.nf.test b/modules/local/scanpy/filter/tests/small_panels_plot.nf.test
new file mode 100644
index 00000000..1076072f
--- /dev/null
+++ b/modules/local/scanpy/filter/tests/small_panels_plot.nf.test
@@ -0,0 +1,91 @@
+nextflow_process {
+
+    name "Test SCANPY_FILTER small panel plots and MAD"
+    script "modules/local/scanpy/filter/main.nf"
+    process "SCANPY_FILTER"
+
+    tag "modules"
+    tag "modules_local"
+
+    setup {
+        run("ADATA_READCSV") {
+            script "modules/local/adata/readcsv/main.nf"
+            process {
+                """
+                genes = (0..<32).collect { String.format('GENE%03d', it) }
+                // Positive totals isolate panel size from the existing zero-total histogram behaviour.
+                rows = (0..<8).collect { i -> 'cell_' + i + ',' + (0..<32).collect { j -> 1 + (i + j) % 7 }.join(',') }
+                input[0] = channel.of('cell,' + genes.join(',') + '\\n' + rows.join('\\n') + '\\n')
+                    .collectFile(name: 'positive_counts.csv')
+                    .map { csv -> [[id: 'positive'], csv] }
+                """
+            }
+        }
+        run("ADATA_EXTEND") {
+            script "modules/local/adata/extend/main.nf"
+            process {
+                """
+                rows = (0..<32).collect { i ->
+                    String.format('GENE%03d', i) + ',' + [1, 10, 19, 20, 32].collect { n -> i < n ? 'True' : 'False' }.join(',')
+                }
+                fragment = channel.of('gene,panel_1,panel_10,panel_19,panel_20,panel_32\\n' + rows.join('\\n') + '\\n')
+                    .collectFile(name: 'panels.csv')
+                input[0] = ADATA_READCSV.out.h5ad.combine(fragment)
+                    .map { meta, h5ad, var -> [[id: 'panels'], h5ad, [], [var], [], [], [], []] }
+                """
+            }
+        }
+        run("ADATA_SUBSETVAR") {
+            script "modules/local/adata/subsetvar/main.nf"
+            process {
+                """
+                panels = ADATA_EXTEND.out.h5ad.flatMap { meta, h5ad ->
+                    [1, 10, 19, 20, 32].collect { n -> [[id: 'panel_' + n, n_genes: n], h5ad] }
+                }.multiMap { meta, h5ad ->
+                    h5ad: [meta, h5ad]
+                    column: meta.id
+                }
+                input[0] = panels.h5ad
+                input[1] = panels.column
+                """
+            }
+        }
+    }
+
+    test("Should plot small panels and apply top-20 MAD through the canonical metric") {
+        when {
+            process {
+                """
+                input[0] = ADATA_SUBSETVAR.out.h5ad.map { meta, h5ad -> [meta + [id: 'qc_' + meta.n_genes], h5ad] }
+                input[1] = 'index'
+                input[2] = 0
+                input[3] = 0
+                input[4] = 0
+                input[5] = 0
+                input[6] = 100
+                input[7] = 0
+                input[8] = 100
+                input[9] = 0
+                input[10] = 0
+                input[11] = 3
+                input[12] = 0
+                input[13] = []
+                input[14] = true
+                """
+            }
+        }
+        then {
+            assert process.success
+            assert process.out.h5ad.size() == 5
+            assert process.out.plots.size() == 5
+            assert process.out.multiqc_files.size() == 5
+            process.out.plots.each { assert java.nio.file.Files.size(path(it)) > 0 }
+            process.out.h5ad.each { meta, h5ad ->
+                def adata = anndata(h5ad)
+                assert adata.n_vars == meta.n_genes
+                assert adata.n_obs > 0
+                assert 'pct_counts_in_top_20_genes' in adata.obs.colnames
+            }
+        }
+    }
+}
