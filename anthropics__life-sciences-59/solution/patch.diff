+    n_control = math.ceil((1 + 1 / r) * ((z_alpha + z_beta) ** 2) / (cohens_d ** 2))
+    # round() so floating-point error (1.1 * 50 = 55.00000000000001) cannot add a participant
+    return math.ceil(round(r * n_control, 9)), n_control
+
