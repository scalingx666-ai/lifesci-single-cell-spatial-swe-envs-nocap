+colnames(ligand_target_matrix) = ligand_target_matrix \%>\% colnames() \%>\% convert_human_to_mouse_symbols()
+rownames(ligand_target_matrix) = ligand_target_matrix \%>\% rownames() \%>\% convert_human_to_mouse_symbols()
