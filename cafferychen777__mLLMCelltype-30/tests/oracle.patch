+### Scenario 2b: Using Free OpenRouter Models
+
+For users with limited API credits or budget constraints:
+
+```{r}
+# Set OpenRouter API key
+openrouter_api_key <- Sys.getenv("OPENROUTER_API_KEY")
+
+# Define free OpenRouter models to use
+free_models <- c(
+  "meta-llama/llama-4-maverick:free",                # Meta Llama 4 Maverick (free)
+  "nvidia/llama-3.1-nemotron-ultra-253b-v1:free",    # NVIDIA Nemotron Ultra 253B (free)
+  "deepseek/deepseek-chat-v3-0324:free",             # DeepSeek Chat v3 (free)
+  "microsoft/mai-ds-r1:free"                         # Microsoft MAI-DS-R1 (free)
+)
+
+# Run annotation with free OpenRouter models
+free_results <- list()
+for (model in free_models) {
+  free_results[[model]] <- annotate_cell_types(
+    input = pbmc_markers,
+    tissue_name = "human PBMC",
+    model = model,
+    api_key = openrouter_api_key,
+    provider = "openrouter",  # Specify OpenRouter as the provider
+    top_gene_count = 10
+  )
+}
+
+# Create consensus with free models
+free_consensus_results <- create_consensus(
+  results = free_results,
+  input = pbmc_markers,
+  tissue_name = "human PBMC",
+  model = "meta-llama/llama-4-maverick:free",  # Use a free model for discussion
+  api_key = openrouter_api_key,
+  provider = "openrouter"
+)
+
+# Print consensus summary
+print_consensus_summary(free_consensus_results)
+
+# Add free model consensus annotations to Seurat object
+pbmc_small$free_model_consensus <- plyr::mapvalues(
+  x = as.character(Idents(pbmc_small)),
+  from = as.character(0:(length(free_consensus_results$final_consensus)-1)),
+  to = free_consensus_results$final_consensus
+)
+
+# Compare paid vs. free model results
+comparison <- data.frame(
+  cluster = as.character(0:(length(consensus_results$final_consensus)-1)),
+  paid_models = consensus_results$final_consensus,
+  free_models = free_consensus_results$final_consensus,
+  agreement = consensus_results$final_consensus == free_consensus_results$final_consensus
+)
+print(comparison)
+```
