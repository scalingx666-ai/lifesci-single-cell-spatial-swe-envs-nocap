+	def ConnectedComponents(self):
+		visited = pd.Series([0] * len(self.V), index=self.V)
+		cc = []
+		for v in self.V:
+			if visited[v] == 1:
+				continue
+
+			queue = deque([v])
+			visited[v] = 1
+			tmp = [v]
+			while len(queue) > 0:
+				elem = queue.pop()
+				nbrs = self.adj[elem][self.adj[elem] == 1].index.tolist()
+
+				for nbr in nbrs:
+					if visited[nbr] == 0:
+						queue.append(nbr)
+						visited[nbr] = 1
+						tmp.append(nbr)
+
+			if len(tmp) > 0:
+				cc.append(tmp)
+
+		return cc
