@@ -0,0 +1,94 @@
+% Generated by roxygen2: do not edit by hand
+% Please edit documentation in R/RunIntegrationBenchmark.R
+\name{RunIntegrationBenchmark}
+\alias{RunIntegrationBenchmark}
+\title{Benchmark single-cell integration methods}
+\usage{
+RunIntegrationBenchmark(
+  srt,
+  batch,
+  celltype = NULL,
+  methods = c("Uncorrected", "Harmony"),
+  linear_reduction = "pca",
+  nHVF = 2000,
+  linear_reduction_dims = 50,
+  linear_reduction_dims_use = NULL,
+  nonlinear_reduction = "umap",
+  perplexity = 30,
+  k_graph = 15,
+  bio_weight = 0.6,
+  batch_weight = 0.4,
+  skip_failed = TRUE,
+  tool_name = "IntegrationBenchmark",
+  verbose = TRUE,
+  ...
+)
+}
+\arguments{
+\item{srt}{A \code{Seurat} object containing a batch column.}
+
+\item{batch}{Metadata column used as the technical batch.}
+
+\item{celltype}{Optional metadata column used as biological labels.}
+
+\item{methods}{Integration methods passed to \code{\link[=RunIntegration]{RunIntegration()}}.}
+
+\item{perplexity}{Neighborhood size for \code{\link[=RunLISI]{RunLISI()}}.}
+
+\item{k_graph}{Neighbor size for graph connectivity.}
+
+\item{bio_weight, batch_weight}{Weights used for the overall score.
+Defaults follow scIB (\code{0.6} bio conservation, \code{0.4} batch correction).}
+
+\item{skip_failed}{Whether a failed method is recorded and skipped.}
+
+\item{tool_name}{Name of the \code{srt@tools} entry used to store the tables.}
+
+\item{verbose}{Whether to print the message.
+Default is \code{TRUE}.}
+
+\item{...}{The message to print.}
+}
+\value{
+The input \code{Seurat} object with integration reductions, per-cell
+LISI columns, and \code{srt@tools[[tool_name]]} containing \code{summary}, \code{metrics},
+and \code{runs}. Print the tables with \code{\link[thisplot:print_colored_table]{thisplot::print_colored_table()}}.
+}
+\description{
+Run one or more \code{\link[=RunIntegration]{RunIntegration()}} methods on the same input, score each
+latent embedding with scIB-style batch-correction and bio-conservation
+metrics (scaled iLISI/cLISI, ASW, graph connectivity, ARI/NMI), and store
+the tables in \code{srt@tools$IntegrationBenchmark}. The object itself is
+returned so later plotting can reuse the embeddings and per-cell LISI
+scores.
+}
+\examples{
+\dontrun{
+data(panc8_sub)
+panc8_sub <- RunIntegrationBenchmark(
+  panc8_sub,
+  batch = "tech",
+  celltype = "celltype",
+  methods = c("Uncorrected", "Harmony"),
+  nHVF = 500,
+  linear_reduction_dims = 20,
+  linear_reduction_dims_use = 1:10,
+  perplexity = 10
+)
+thisplot::print_colored_table(
+  panc8_sub@tools$IntegrationBenchmark$summary,
+  by = "row",
+  palette = "Chinese"
+)
+thisplot::print_colored_table(
+  panc8_sub@tools$IntegrationBenchmark$metrics,
+  by = "col",
+  palette = "Paired"
+)
+IntegrationBenchmarkPlot(panc8_sub)
+IntegrationBenchmarkPlot(panc8_sub, plot_type = "box")
+}
+}
+\seealso{
+\link{IntegrationBenchmarkPlot}, \link{RunIntegration}, \link{RunLISI}
+}
