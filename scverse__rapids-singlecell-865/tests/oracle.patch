+    X[0, 0] = 1e307
+    X, cats, codes = X[order], cats[order], codes[order]
+    offsets = np.searchsorted(codes, np.arange(len(joint_cats) + 1)).astype(np.int32)
+    joint_cats = cp.asarray(joint_cats, dtype=cp.int32)
