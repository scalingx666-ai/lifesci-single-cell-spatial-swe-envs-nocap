+def recursive_wait_for_elem(app, elem, duration):
+    if duration >= 15:
+        return NoSuchElementException
+    else:
+        time.sleep(duration)
+        try:
+            app.find_element(elem).click()
+        except NoSuchElementException:
+            recursive_wait_for_elem(app, elem, int(1.1*duration))
+
