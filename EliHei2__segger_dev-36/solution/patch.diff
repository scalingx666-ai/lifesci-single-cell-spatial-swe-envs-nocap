@@ -0,0 +1,22 @@
+fail_fast: false
+default_language_version:
+    python: python3
+default_stages:
+    - commit
+    - push
+minimum_pre_commit_version: 2.16.0
+ci:
+    skip: []
+repos:
+    - repo: https://github.com/psf/black
+      rev: 24.8.0
+      hooks:
+          - id: black
+    - repo: https://github.com/pre-commit/mirrors-prettier
+      rev: v4.0.0-alpha.8
+      hooks:
+          - id: prettier
+    - repo: https://github.com/asottile/blacken-docs
+      rev: 1.18.0
+      hooks:
+          - id: blacken-docs
