diff --git a/benchmarks/vi/decipher/common.py b/benchmarks/vi/decipher/common.py
new file mode 100644
index 000000000..cda9f0609
--- /dev/null
+++ b/benchmarks/vi/decipher/common.py
@@ -0,0 +1,95 @@
+"""Shared, implementation-agnostic metrics for the ov.vi.Decipher vs
+scvi.external.Decipher validation.
+
+``elbo_and_nll`` re-derives the single-sample ELBO and an importance-weighted
+NLL estimate directly from the four Decipher sub-networks and ``theta`` --
+the same maths in both ``ov.vi._decipher.DecipherModule`` and scvi-tools'
+``DecipherPyroModule`` (identical attribute names: ``encoder_x_to_z``,
+``encoder_zx_to_v``, ``decoder_v_to_z``, ``decoder_z_to_x``, ``theta``), so
+calling it on either model's networks is a fair, single-codepath comparison
+that does not depend on either training stack's own (possibly differently
+scaled) validation bookkeeping.
+"""
+from __future__ import annotations
+
+import math
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+_LOG_2PI = math.log(2 * math.pi)
+
+
+def _log_normal(x, loc, scale):
+    return (-0.5 * ((x - loc) / scale) ** 2 - torch.log(scale) - 0.5 * _LOG_2PI).sum(-1)
+
+
+def _one_sample(enc_x_z, enc_zx_v, dec_v_z, dec_z_x, theta, x, eps):
+    xl = torch.log1p(x)
+    z_loc, z_s = enc_x_z(xl)
+    z_scale = F.softplus(z_s)
+    z = z_loc + z_scale * torch.randn_like(z_loc)
+    v_loc, v_s = enc_zx_v(torch.cat([z, xl], dim=-1))
+    v_scale = F.softplus(v_s)
+    v = v_loc + v_scale * torch.randn_like(v_loc)
+    log_qz = _log_normal(z, z_loc, z_scale)
+    log_qv = _log_normal(v, v_loc, v_scale)
+    log_pv = (-0.5 * v ** 2 - 0.5 * _LOG_2PI).sum(-1)
+    pz_loc, pz_s = dec_v_z(v)
+    pz_scale = F.softplus(pz_s)
+    log_pz = _log_normal(z, pz_loc, pz_scale)
+    mu = F.softmax(dec_z_x(z), dim=-1)
+    lib = x.sum(-1, keepdim=True)
+    r = theta + eps
+    logits = torch.log(lib * mu + eps) - torch.log(r)
+    log_px = (x * F.logsigmoid(logits) + torch.lgamma(r + x) - torch.lgamma(r)
+              - torch.lgamma(x + 1) + r * F.logsigmoid(-logits)).sum(-1)
+    return log_px, log_pz - log_qz, log_pv - log_qv
+
+
+@torch.no_grad()
+def elbo_and_nll(networks, x, beta, eps=1e-5, n_iw=100):
+    """Per-cell ELBO (nats, higher is better; the mean of ``n_iw`` single-sample
+    MC draws -- still an unbiased ELBO estimator, just lower-variance than any
+    one draw) and an importance-weighted NLL estimate (``logsumexp`` of the same
+    ``n_iw`` draws), for one minibatch ``x`` (raw counts), given ``networks =
+    (enc_x_z, enc_zx_v, dec_v_z, dec_z_x, theta)``."""
+    elbo_terms, lw = [], []
+    for _ in range(n_iw):
+        log_px, wz, wv = _one_sample(*networks, x, eps)
+        elbo_terms.append(log_px + wz + beta * wv)
+        lw.append(log_px + wz + wv)
+    elbo = torch.stack(elbo_terms, 0).mean(0)
+    lw = torch.stack(lw, 0)
+    nll = -(torch.logsumexp(lw, 0) - math.log(n_iw))
+    return elbo, nll
+
+
+@torch.no_grad()
+def eval_networks(networks, X, device, beta, eps=1e-5, n_iw=100, batch_size=256):
+    """Median per-cell ELBO / NLL of ``networks`` over the rows of ``X`` (numpy,
+    raw counts), moving ``batch_size`` rows to ``device`` at a time.  The median
+    (rather than the mean) is reported because the single/few-sample NB
+    log-likelihood occasionally hits a catastrophic-outlier (z, v) draw for one
+    cell in a few thousand -- a known heavy MC tail of this likelihood, seen for
+    both ov.vi.Decipher and scvi.external.Decipher networks here, that a mean
+    lets dominate the summary; the median (and the trimmed distribution) is the
+    standard robust fix and does not change which model is being evaluated."""
+    elbos, nlls = [], []
+    for i in range(0, X.shape[0], batch_size):
+        x = torch.as_tensor(np.asarray(X[i:i + batch_size]), dtype=torch.float32, device=device)
+        e, n = elbo_and_nll(networks, x, beta, eps=eps, n_iw=n_iw)
+        elbos.append(e.cpu().numpy())
+        nlls.append(n.cpu().numpy())
+    elbos, nlls = np.concatenate(elbos), np.concatenate(nlls)
+    return float(np.median(elbos)), float(np.median(nlls))
+
+
+def best_axis_spearman(v, pt):
+    """``max_k |spearman(v[:, k], pt)|`` -- the rotation of the 2-D Decipher
+    space is arbitrary, so the best-correlated axis is the one that matters."""
+    from scipy.stats import spearmanr
+    rhos = [spearmanr(v[:, k], pt).statistic for k in range(v.shape[1])]
+    k = int(np.argmax(np.abs(rhos)))
+    return float(rhos[k]), k
diff --git a/benchmarks/vi/decipher/prepare_data.py b/benchmarks/vi/decipher/prepare_data.py
new file mode 100644
index 000000000..4724a7578
--- /dev/null
+++ b/benchmarks/vi/decipher/prepare_data.py
@@ -0,0 +1,49 @@
+"""Build the Decipher validation dataset: the erythroid-differentiation lineage
+(HSC -> MK/E prog -> Proerythroblast -> Erythroblast -> Normoblast -> Reticulocyte)
+of the NeurIPS 2021 BMMC CITE-seq donors s1d3, s2d1, s3d7 (already local at
+/scratch/users/steorra/tmp/vi_tut/run/data/).  These donors carry
+``obs['GEX_pseudotime_order']``, a ground-truth pseudotime (Palantir, from the
+NeurIPS 2021 competition task 3) defined for exactly this lineage -- the same
+kind of normal haematopoietic differentiation trajectory the Decipher paper
+validates on.
+
+Output: /scratch/users/steorra/tmp/vi_p2/data/decipher/erythroid_neurips2021.h5ad
+(raw counts in ``layers['counts']`` and ``.X``, top 2000 HVGs, ``obs['donor']``,
+``obs['cell_type']`` and ``obs['GEX_pseudotime_order']`` (NaN off the lineage).
+"""
+import anndata as ad
+import numpy as np
+import scanpy as sc
+
+LINEAGE = ["HSC", "MK/E prog", "Proerythroblast", "Erythroblast", "Normoblast",
+           "Reticulocyte"]
+DONORS = ["s1d3", "s2d1", "s3d7"]
+SRC = "/scratch/users/steorra/tmp/vi_tut/run/data/neurips2021_{}.h5ad"
+OUT = "/scratch/users/steorra/tmp/vi_p2/data/decipher/erythroid_neurips2021.h5ad"
+
+parts = []
+for d in DONORS:
+    a = ad.read_h5ad(SRC.format(d))
+    a = a[a.obs["cell_type"].isin(LINEAGE)].copy()
+    a.obs["donor"] = d
+    a.X = a.layers["counts"].copy()
+    del a.layers["counts"]
+    a.obsm.clear()
+    print(d, a.n_obs, a.obs["cell_type"].value_counts().reindex(LINEAGE).to_dict())
+    parts.append(a)
+
+full = ad.concat(parts, join="outer", index_unique="-")
+full.obs["cell_type"] = full.obs["cell_type"].astype("category").cat.set_categories(LINEAGE)
+print("combined:", full.shape, "with ground-truth pseudotime:",
+      int(full.obs["GEX_pseudotime_order"].notna().sum()))
+
+# HVGs on a log-normalized copy (Decipher itself trains on the raw counts)
+norm = full.copy()
+sc.pp.normalize_total(norm, target_sum=1e4)
+sc.pp.log1p(norm)
+sc.pp.highly_variable_genes(norm, n_top_genes=2000, flavor="seurat")
+full = full[:, norm.var["highly_variable"].values].copy()
+full.layers["counts"] = full.X.copy()
+
+full.write_h5ad(OUT)
+print("wrote", OUT, full.shape)
diff --git a/benchmarks/vi/decipher/replay_test.py b/benchmarks/vi/decipher/replay_test.py
new file mode 100644
index 000000000..17808a3f0
--- /dev/null
+++ b/benchmarks/vi/decipher/replay_test.py
@@ -0,0 +1,125 @@
+"""Decisive test: record scvi.external.Decipher's exact per-epoch minibatch
+cell-index order (train RandomSampler) and train/val split for one seed, then
+drive ov.vi.Decipher's module manually (same init, bypassing fit()) on that
+exact same per-epoch order, and compare the resulting trajectory recovery.
+
+If replaying reference's data order fixes a "bad" ov.vi seed, the shuffle
+stream (not a numerical bug -- already ruled out by replay_step0.py-style
+single-step checks) explains the gap.
+"""
+import sys
+import numpy as np
+import torch
+import torch.utils.data as tud
+import anndata as ad
+from scipy.stats import spearmanr
+
+sys.path.insert(0, __file__.rsplit("/", 1)[0])
+
+DATA = "/scratch/users/steorra/tmp/vi_p2/data/decipher/erythroid_neurips2021.h5ad"
+SEED = int(sys.argv[1]) if len(sys.argv) > 1 else 0
+MAX_EPOCHS = int(sys.argv[2]) if len(sys.argv) > 2 else 150
+
+a = ad.read_h5ad(DATA)
+pt = a.obs["GEX_pseudotime_order"].values.astype(np.float64)
+ptm = ~np.isnan(pt)
+Xs = a.layers["counts"]
+X = Xs.toarray() if hasattr(Xs, "toarray") else np.asarray(Xs)
+
+# ---------------------------------------------------------------------------
+# 1. Train the reference model, recording every epoch's RandomSampler order
+#    (local indices into its train Subset) and the final train/val split.
+# ---------------------------------------------------------------------------
+import scvi  # noqa: E402
+
+captured = []
+orig_iter = tud.RandomSampler.__iter__
+
+
+def patched_iter(self):
+    order = list(orig_iter(self))
+    captured.append(order)
+    return iter(order)
+
+
+tud.RandomSampler.__iter__ = patched_iter
+try:
+    scvi.settings.seed = SEED
+    torch.manual_seed(SEED)
+    aa = a.copy()
+    scvi.external.Decipher.setup_anndata(aa, layer="counts")
+    ref = scvi.external.Decipher(aa, dim_v=2, dim_z=10, beta=0.1)
+    ref.train(max_epochs=MAX_EPOCHS, batch_size=128, accelerator="cpu",
+              enable_progress_bar=False, early_stopping=True, check_val_every_n_epoch=5,
+              early_stopping_patience=10)
+finally:
+    tud.RandomSampler.__iter__ = orig_iter
+
+ref.module.eval()
+v_ref = ref.get_latent_representation()
+rho_ref = [spearmanr(v_ref[ptm, k], pt[ptm]).statistic for k in range(2)]
+train_idx = np.asarray(ref.train_indices)
+val_idx = np.asarray(ref.validation_indices)
+n_epochs_done = len(captured)
+print(f"ref: epochs_done={n_epochs_done} best_rho={max(abs(rho_ref[0]), abs(rho_ref[1])):.3f} "
+     f"(ax0={rho_ref[0]:.3f} ax1={rho_ref[1]:.3f})")
+
+# drop_last=True, batch_size=128: chunk each captured epoch's local-index
+# permutation into full batches only, then map local -> global cell index.
+BATCH = 128
+epoch_batches = []
+for order in captured:
+    order = np.asarray(order)
+    n_full = (len(order) // BATCH) * BATCH
+    order = order[:n_full]
+    glob = train_idx[order]
+    epoch_batches.append([glob[i:i + BATCH] for i in range(0, len(glob), BATCH)])
+print(f"recorded {len(epoch_batches)} epochs, "
+     f"{sum(len(e) for e in epoch_batches)} total minibatches")
+
+# ---------------------------------------------------------------------------
+# 2. Drive ov.vi.Decipher's module manually through the exact same per-epoch
+#    order (same init: same torch.manual_seed as the reference run above).
+# ---------------------------------------------------------------------------
+import omicverse as ov  # noqa: E402
+from omicverse.vi._train import ClippedAdam  # noqa: E402
+from omicverse.vi._decipher import DecipherModule  # noqa: E402
+
+torch.manual_seed(SEED)
+mod = DecipherModule(n_input=X.shape[1], dim_v=2, dim_z=10, beta=0.1)
+opt = ClippedAdam(mod.parameters(), lr=5e-3, eps=1e-8, weight_decay=1e-4, clip_norm=10.0)
+mod.freeze_bn_from = 5  # matches Decipher.train()'s freeze_batchnorm='auto' for
+mod._bn_frozen = False  # check_val_every_n_epoch=5 (what the reference run used)
+
+torch.manual_seed(SEED + 1)  # matches BaseVIModel.train()'s own convention
+for epoch, batches in enumerate(epoch_batches):
+    mod.train()
+    mod.on_train_epoch_start(epoch)
+    for glob_idx in batches:
+        xb = torch.as_tensor(X[glob_idx], dtype=torch.float32)
+        out = mod({"x": xb})
+        opt.zero_grad(set_to_none=True)
+        out["loss"].backward()
+        opt.step()
+
+mod.eval()
+with torch.no_grad():
+    xl, z_loc, _ = mod.encode(torch.as_tensor(X, dtype=torch.float32))
+    v_replay = mod.encode_v(z_loc, xl)[0].numpy()
+rho_replay = [spearmanr(v_replay[ptm, k], pt[ptm]).statistic for k in range(2)]
+print(f"ours (replayed reference order+init, {len(epoch_batches)} epochs): "
+     f"best_rho={max(abs(rho_replay[0]), abs(rho_replay[1])):.3f} "
+     f"(ax0={rho_replay[0]:.3f} ax1={rho_replay[1]:.3f})")
+
+# ---------------------------------------------------------------------------
+# 3. For comparison: ours with its OWN default shuffle, same seed/epochs.
+# ---------------------------------------------------------------------------
+torch.manual_seed(SEED)
+own = ov.vi.Decipher(a, layer="counts", seed=SEED, dim_v=2, dim_z=10, beta=0.1)
+own.train(max_epochs=n_epochs_done, batch_size=128, device="cpu", progress=False, seed=SEED,
+         early_stopping=False, check_val_every_n_epoch=None, freeze_batchnorm=5)
+v_own = own.get_latent_representation()
+rho_own = [spearmanr(v_own[ptm, k], pt[ptm]).statistic for k in range(2)]
+print(f"ours (own default shuffle, same {n_epochs_done} epochs): "
+     f"best_rho={max(abs(rho_own[0]), abs(rho_own[1])):.3f} "
+     f"(ax0={rho_own[0]:.3f} ax1={rho_own[1]:.3f})")
diff --git a/benchmarks/vi/decipher/run_one.py b/benchmarks/vi/decipher/run_one.py
new file mode 100644
index 000000000..6dd486e60
--- /dev/null
+++ b/benchmarks/vi/decipher/run_one.py
@@ -0,0 +1,102 @@
+"""Train one (ov.vi.Decipher | scvi.external.Decipher) model on the erythroid
+NeurIPS 2021 BMMC trajectory and dump its metrics + full-data latent v.
+
+Usage: python run_one.py {ours,ref} <seed> [--epochs N] [--device cpu|cuda]
+"""
+import argparse
+import json
+import sys
+import time
+
+import anndata as ad
+import numpy as np
+import torch
+
+sys.path.insert(0, __file__.rsplit("/", 1)[0])
+from common import best_axis_spearman, eval_networks  # noqa: E402
+
+DATA = "/scratch/users/steorra/tmp/vi_p2/data/decipher/erythroid_neurips2021.h5ad"
+LINEAGE = ["HSC", "MK/E prog", "Proerythroblast", "Erythroblast", "Normoblast", "Reticulocyte"]
+COMMON = dict(dim_v=2, dim_z=10, beta=0.1)  # layers_v_to_z=(64,), layers_z_to_x=() (defaults)
+OUT = "/scratch/users/steorra/tmp/vi_p2/data/decipher/results_{}_seed{}.json"
+
+
+def run_ours(adata, seed, device, epochs):
+    import omicverse as ov
+    torch.manual_seed(seed)
+    m = ov.vi.Decipher(adata, layer="counts", seed=seed, **COMMON)
+    t0 = time.perf_counter()
+    # early_stopping on nll_validation (the Decipher default monitor, both here and in
+    # scvi-tools): the raw ClippedAdam/lr=5e-3 recipe eventually diverges on this small
+    # dataset in BOTH implementations past ~150-250 epochs, so this is how both are meant
+    # to be run in practice, not a port-specific workaround.
+    m.train(max_epochs=epochs, batch_size=128, device=device, progress=False, seed=seed,
+            early_stopping=True, check_val_every_n_epoch=5, early_stopping_patience=10)
+    dt = time.perf_counter() - t0
+    val = np.asarray(m.validation_indices)
+    v_full = m.get_latent_representation()
+    mod = m.module
+    networks = (mod.encoder_x_to_z, mod.encoder_zx_to_v, mod.decoder_v_to_z,
+               mod.decoder_z_to_x, mod.theta)
+    return v_full, val, networks, dt, mod.beta
+
+
+def run_ref(adata, seed, device, epochs):
+    import scvi
+    scvi.settings.seed = seed
+    torch.manual_seed(seed)
+    a = adata.copy()
+    scvi.external.Decipher.setup_anndata(a, layer="counts")
+    m = scvi.external.Decipher(a, **COMMON)
+    accel = "gpu" if device == "cuda" else "cpu"
+    t0 = time.perf_counter()
+    m.train(max_epochs=epochs, batch_size=128, accelerator=accel, enable_progress_bar=False,
+           early_stopping=True, check_val_every_n_epoch=5, early_stopping_patience=10)
+    dt = time.perf_counter() - t0
+    mod = m.module
+    mod.eval()  # Lightning leaves the module in train() mode after fit(); freeze
+                # BatchNorm to running stats, same as ov.vi.Decipher.train() does
+    val = np.asarray(m.validation_indices)
+    v_full = m.get_latent_representation()
+    dev = mod.device
+    networks = (mod.encoder_x_to_z, mod.encoder_zx_to_v, mod.decoder_v_to_z,
+               mod.decoder_z_to_x, mod.theta.to(dev))
+    return v_full, val, networks, dt, mod.beta, dev
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("mode", choices=["ours", "ref"])
+    p.add_argument("seed", type=int)
+    p.add_argument("--epochs", type=int, default=300)
+    p.add_argument("--device", default="cuda" if torch.cuda.is_available() else "cpu")
+    args = p.parse_args()
+
+    adata = ad.read_h5ad(DATA)
+    pt = adata.obs["GEX_pseudotime_order"].values.astype(np.float64)
+    pt_mask = ~np.isnan(pt)
+    X = np.asarray(adata.layers["counts"]) if not hasattr(adata.layers["counts"], "toarray") \
+        else adata.layers["counts"].toarray()
+
+    if args.mode == "ours":
+        v_full, val, networks, dt, beta = run_ours(adata, args.seed, args.device, args.epochs)
+        device = next(networks[0].parameters()).device
+    else:
+        v_full, val, networks, dt, beta, device = run_ref(adata, args.seed, args.device,
+                                                           args.epochs)
+
+    rho_gt, axis = best_axis_spearman(v_full[pt_mask], pt[pt_mask])
+    elbo, nll = eval_networks(networks, X[val], device, beta, n_iw=100)
+
+    out = dict(mode=args.mode, seed=args.seed, epochs=args.epochs, device=str(device),
+              train_time_s=dt, elbo_val=elbo, nll_val=nll, spearman_vs_gt=rho_gt,
+              best_axis=axis)
+    path = OUT.format(args.mode, args.seed)
+    with open(path, "w") as f:
+        json.dump(out, f, indent=1)
+    np.savez(path.replace(".json", "_v.npz"), v=v_full, val=val, pt=pt)
+    print(json.dumps(out, indent=1))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/benchmarks/vi/decipher/run_oom_dask.py b/benchmarks/vi/decipher/run_oom_dask.py
new file mode 100644
index 000000000..5b2a8afc2
--- /dev/null
+++ b/benchmarks/vi/decipher/run_oom_dask.py
@@ -0,0 +1,34 @@
+"""Confirm ov.vi.Decipher trains identically on in-memory AnnData, AnnDataOOM
+(disk) and Dask-backed AnnData, on the real erythroid-lineage validation set
+(not just the synthetic tests/vi/test_decipher.py fixture)."""
+import numpy as np
+import omicverse as ov
+
+DATA = "/scratch/users/steorra/tmp/vi_p2/data/decipher/erythroid_neurips2021.h5ad"
+KW = dict(max_epochs=15, batch_size=128, device="cpu", progress=False, seed=0,
+          shuffle="block", block_size=256, buffer_blocks=4)
+
+
+def _train(adata):
+    m = ov.vi.Decipher(adata, layer=None, dim_v=2, dim_z=10, beta=0.1, seed=0)
+    m.train(**KW)
+    return m
+
+
+mem = ov.read(DATA)
+z_mem = _train(mem).get_latent_representation()
+print("in-memory ok:", z_mem.shape, np.isfinite(z_mem).all())
+
+ov.settings.cpu_init()
+oom = ov.read(DATA, storage="disk")
+m_oom = _train(oom)
+z_oom = m_oom.get_latent_representation()
+print("oom kind:", m_oom._source().kind,
+     "matches in-memory:", np.allclose(z_mem, z_oom, atol=1e-5))
+
+from omicverse.pp._dask import read_h5ad
+da_ad = read_h5ad(DATA, chunk_size=256, device="cpu")
+m_da = _train(da_ad)
+z_da = m_da.get_latent_representation()
+print("dask kind:", m_da._source().kind,
+     "matches in-memory:", np.allclose(z_mem, z_da, atol=1e-5))
diff --git a/benchmarks/vi/decipher/seed_sweep.py b/benchmarks/vi/decipher/seed_sweep.py
new file mode 100644
index 000000000..d43fe4e64
--- /dev/null
+++ b/benchmarks/vi/decipher/seed_sweep.py
@@ -0,0 +1,22 @@
+import sys
+import anndata as ad
+import numpy as np
+import torch
+from scipy.stats import spearmanr
+import omicverse as ov
+
+DATA = "/scratch/users/steorra/tmp/vi_p2/data/decipher/erythroid_neurips2021.h5ad"
+seeds = [int(s) for s in sys.argv[1:]]
+a = ad.read_h5ad(DATA)
+pt = a.obs["GEX_pseudotime_order"].values.astype(np.float64)
+m = ~np.isnan(pt)
+for seed in seeds:
+    torch.manual_seed(seed)
+    mod = ov.vi.Decipher(a, layer="counts", seed=seed, dim_v=2, dim_z=10, beta=0.1)
+    mod.train(max_epochs=300, batch_size=128, device="cpu", progress=False, seed=seed,
+             early_stopping=True, check_val_every_n_epoch=5, early_stopping_patience=10)
+    v = mod.get_latent_representation()
+    r0 = spearmanr(v[m, 0], pt[m]).statistic
+    r1 = spearmanr(v[m, 1], pt[m]).statistic
+    best = max(abs(r0), abs(r1))
+    print(f"seed={seed} epochs={mod._epochs_done} best={best:.4f}", flush=True)
