+
+def test_adata_metadata(qtbot, make_napari_viewer: any):
+    viewer = make_napari_viewer()
+    widget = SdataWidget(viewer, EventedList([sdata]))
+    view_widget = QtAdataViewWidget(viewer)
+
+    # Click on `global` coordinate system
