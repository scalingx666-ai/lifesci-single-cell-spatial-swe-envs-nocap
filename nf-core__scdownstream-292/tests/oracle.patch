+def is_outlier(adata, metric: str, nmads: float):
+    """Identify outliers using MAD (Median Absolute Deviation) method."""
+    M = adata.obs[metric]
+    outlier = (M < np.median(M) - nmads * median_abs_deviation(M)) | (
+        np.median(M) + nmads * median_abs_deviation(M) < M
+    )
+    return outlier
+
