--- a/tests/test_llm_openai_tool_calls.py
+++ b/tests/test_llm_openai_tool_calls.py
@@ -739,3 +739,95 @@ def test_streamed_parallel_calls_without_index_stay_separate(monkeypatch):
             meta={"type": "function", "index": 1},
