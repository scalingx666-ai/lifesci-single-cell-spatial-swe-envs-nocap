+    cache_dir = cache_dir,
+    log_dir = log_dir
+  )
+
+# 결과 저장
+saveRDS(consensus_results, "your_results.rds")
+
+# 결과 요약 출력
+cat("\n결과 요약:\n")
+cat("사용 가능한 필드:", paste(names(consensus_results), collapse=", "), "\n\n")
+
+# 최종 주석 출력
