+        _mask_position_adjacent_chunk = np.where(block == mask_label_adjacent)
+        _mask_position_adjacent_chunk = _subset_mask_position(
+            _mask_position_adjacent_chunk,
+            y_min=y_min,
+            y_max=y_max,
