+def cv_data_gen(ad_sc, ad_sp, mode='loo'):
+    """ This function generates cross validation datasets
+
+    Args:
+        ad_sc: AnnData, single cell data
+        ad_sp: AnnData, gene spatial data
+        mode: string, support 'loo' and 'kfold'
+
