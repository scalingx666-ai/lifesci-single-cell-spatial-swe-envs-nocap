+        ares = np.abs(res)
+        wts = np.where(ares <= k, 1.0, k / np.maximum(ares, 1e-300))
+        y.weights = pd.DataFrame(wts, index=y.counts.index, columns=y.counts.columns)
+        if update_trend:
